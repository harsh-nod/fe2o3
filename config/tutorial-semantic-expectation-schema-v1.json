{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harsh-nod.github.io/fe2o3-kernels/schema/tutorial-semantic-expectation-v1.json",
  "title": "fe2o3 tutorial semantic expectation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assertions",
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "fe2o3-tutorial-semantic-expectation-v1"
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    }
  },
  "$defs": {
    "pathComponent": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equals",
        "path"
      ],
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/pathComponent"
          }
        },
        "equals": {}
      }
    }
  }
}
