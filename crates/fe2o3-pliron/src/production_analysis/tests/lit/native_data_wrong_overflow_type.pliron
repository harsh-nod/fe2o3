// RUN: fe2o3-pliron-lit --passes=general %s
// EXPECT: REJECT
// EXPECT-LOCAL: REJECT
// CHECK: LOCAL-REJECT
// CHECK: checked gpu.binary requires integer value and i1 overflow
builtin.func @native_data_wrong_overflow_type: builtin.function <(builtin.integer ui32) -> ()>
{
  ^entry(x: builtin.integer ui32):
    sum, overflow = gpu.binary (x, x) [] [gpu_binary_kind: gpu.binary_kind CheckedAdd]: <(builtin.integer ui32, builtin.integer ui32) -> (builtin.integer ui32, builtin.integer ui32)>;
    kernel.return () [] []: <() -> ()>
}
