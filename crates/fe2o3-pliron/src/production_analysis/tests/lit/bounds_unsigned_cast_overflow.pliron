// RUN: fe2o3-pliron-lit --passes=general %s
// EXPECT: REJECT
// CHECK: error[FE2O3-BOUNDS-005]
// CHECK: counterexample invocation [2]
// CHECK: outside the unsigned 64-bit range
builtin.func @bounds_unsigned_cast_overflow: builtin.function <() -> ()>
{
  ^entry_block1v1():
    view_v0 = kernel.ranked_view () [] [kernel_memory_space: kernel.memory_space Global]: <() -> (kernel.ranked_view <32,false,[256]>)>;
    lane_v1 = kernel.invocation_index () [] [kernel_invocation_dimension: kernel.invocation_dimension 0, kernel_launch_extent: kernel.launch_extent 3]: <() -> (kernel.index )>;
    maximum_v2 = kernel.index_constant () [] [kernel_index_value: kernel.index_value 18446744073709551615]: <() -> (kernel.index )>;
    product_v3 = kernel.index_binary (lane_v1, maximum_v2) [] [kernel_index_binary_kind: kernel.index_binary_kind Multiply]: <(kernel.index , kernel.index ) -> (kernel.index )>;
    narrowed_v4 = kernel.index_unsigned_cast (product_v3) [] [kernel_unsigned_bit_width: kernel.index_value 8]: <(kernel.index ) -> (kernel.index )>;
    kernel.access (view_v0, narrowed_v4) [] [kernel_access_kind: kernel.access_kind Read]: <(kernel.ranked_view <32,false,[256]>, kernel.index ) -> ()>;
    kernel.return () [] []: <() -> ()>
}
