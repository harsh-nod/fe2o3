// RUN: fe2o3-pliron-lit --passes=general %s
// EXPECT: REJECT
// CHECK: error[FE2O3-PIPELINE-001]
// CHECK: Release for epoch 0 is illegal while slot 0 is Ready(0)
// CHECK: help[FE2O3-FIX-PIPELINE]
builtin.func @pipeline_release_before_consume: builtin.function <() -> ()>
{
  ^entry_block1v1():
    v0 = kernel.ranked_view () [] [kernel_memory_space: kernel.memory_space Workgroup]: <() -> (kernel.ranked_view <16,true,[2,64]>)>;
    p1 = kernel.pipeline_create (v0) [] []: <(kernel.ranked_view <16,true,[2,64]>) -> (kernel.pipeline <2,1>)>;
    zero_v2 = kernel.index_constant () [] [kernel_index_value: kernel.index_value 0]: <() -> (kernel.index )>;
    kernel.pipeline_event (p1, zero_v2, zero_v2) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Stage]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.pipeline_event (p1, zero_v2, zero_v2) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Commit]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.pipeline_event (p1, zero_v2, zero_v2) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Wait]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.pipeline_event (p1, zero_v2, zero_v2) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Release]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.return () [] []: <() -> ()>
}
