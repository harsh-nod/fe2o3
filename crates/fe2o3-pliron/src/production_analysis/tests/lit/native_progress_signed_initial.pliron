// RUN: fe2o3-pliron-lit --passes=general %s
// EXPECT: PASS
// CHECK: PASS
builtin.func @native_progress_signed_initial: builtin.function <() -> (builtin.integer si8)>
{
  ^entry():
    initial = gpu.constant <builtin.integer <-10: si8>> : builtin.integer si8;
    step = gpu.constant <builtin.integer <1: si8>> : builtin.integer si8;
    n = gpu.constant <builtin.integer <10: si8>> : builtin.integer si8;
    gpu.branch (initial) [^header] []: <(builtin.integer si8) -> ()>
  ^header(i: builtin.integer si8):
    test = gpu.compare (i, n) [] [gpu_compare_predicate: gpu.compare_predicate LessThan]: <(builtin.integer si8, builtin.integer si8) -> (builtin.integer i1)>;
    gpu.cond_branch (test, i, i) [^body, ^exit] [operand_segment_sizes: builtin.operand_segment_sizes [1, 1, 1]]: <(builtin.integer i1, builtin.integer si8, builtin.integer si8) -> ()>
  ^body(j: builtin.integer si8):
    next = gpu.binary (j, step) [] [gpu_binary_kind: gpu.binary_kind Add]: <(builtin.integer si8, builtin.integer si8) -> (builtin.integer si8)>;
    gpu.branch (next) [^header] []: <(builtin.integer si8) -> ()>
  ^exit(done: builtin.integer si8):
    gpu.return (done) [] []: <(builtin.integer si8) -> ()>
}
