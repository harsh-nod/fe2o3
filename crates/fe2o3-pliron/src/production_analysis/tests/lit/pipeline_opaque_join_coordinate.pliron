    kernel.pipeline_event (p1, body_i_v7, current_slot_v10) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Wait]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.pipeline_event (p1, body_i_v7, current_slot_v10) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Consume]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
