// EXPECT: REJECT
// CHECK: error[FE2O3-PIPELINE-001]
// CHECK: consuming epoch coordinates do not match the staged/consumed symbolic tile
// CHECK: help[FE2O3-FIX-PIPELINE]
// A dependency-only value is not numerically equal to its sole input.
builtin.func @pipeline_opaque_join_coordinate: builtin.function <(kernel.index ) -> ()>
{
  ^entry_block1v1(bound_v5: kernel.index ):
    v0 = kernel.ranked_view () [] [kernel_memory_space: kernel.memory_space Workgroup]: <() -> (kernel.ranked_view <16,true,[2,256]>)>;
