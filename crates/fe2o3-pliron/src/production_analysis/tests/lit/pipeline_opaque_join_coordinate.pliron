    one_v3 = kernel.index_constant () [] [kernel_index_value: kernel.index_value 1]: <() -> (kernel.index )>;
    two_v4 = kernel.index_constant () [] [kernel_index_value: kernel.index_value 2]: <() -> (kernel.index )>;
    opaque_v12 = kernel.deterministic_join (zero_v2) [] []: <(kernel.index ) -> (kernel.index )>;
    extent_v13 = kernel.index_constant () [] [kernel_index_value: kernel.index_value 256]: <() -> (kernel.index )>;
    staged_v14 = kernel.index_binary (zero_v2, extent_v13) [] [kernel_index_binary_kind: kernel.index_binary_kind Remainder]: <(kernel.index , kernel.index ) -> (kernel.index )>;
    consumed_v15 = kernel.index_binary (opaque_v12, extent_v13) [] [kernel_index_binary_kind: kernel.index_binary_kind Remainder]: <(kernel.index , kernel.index ) -> (kernel.index )>;
    kernel.pipeline_event (p1, zero_v2, zero_v2) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Stage]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.access (v0, zero_v2, staged_v14) [] [kernel_access_kind: kernel.access_kind Write]: <(kernel.ranked_view <16,true,[2,256]>, kernel.index , kernel.index ) -> ()>;
    kernel.pipeline_event (p1, zero_v2, zero_v2) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Commit]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.br_args (zero_v2) [^header_block2v1] []: <(kernel.index ) -> ()>

  ^header_block2v1(i_v6: kernel.index ):
    kernel.index_lt_br_args (i_v6, bound_v5, i_v6) [^body_block3v1, ^exit_block4v1] []: <(kernel.index , kernel.index , kernel.index ) -> ()>

  ^body_block3v1(body_i_v7: kernel.index ):
