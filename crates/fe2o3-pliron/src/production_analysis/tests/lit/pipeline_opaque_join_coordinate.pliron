    future_slot_v9 = kernel.index_binary (future_v8, two_v4) [] [kernel_index_binary_kind: kernel.index_binary_kind Remainder]: <(kernel.index , kernel.index ) -> (kernel.index )>;
    current_slot_v10 = kernel.index_binary (body_i_v7, two_v4) [] [kernel_index_binary_kind: kernel.index_binary_kind Remainder]: <(kernel.index , kernel.index ) -> (kernel.index )>;
    kernel.pipeline_event (p1, future_v8, future_slot_v9) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Stage]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.access (v0, future_slot_v9, staged_v14) [] [kernel_access_kind: kernel.access_kind Write]: <(kernel.ranked_view <16,true,[2,256]>, kernel.index , kernel.index ) -> ()>;
