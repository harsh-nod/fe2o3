builtin.func @native_progress_nested_payload: builtin.function <(builtin.integer ui8) -> (builtin.integer ui8)>
{
  ^entry(n: builtin.integer ui8):
    initial = gpu.constant <builtin.integer <3: ui8>> : builtin.integer ui8;
    step = gpu.constant <builtin.integer <1: ui8>> : builtin.integer ui8;
    gpu.branch (initial, initial) [^outer] []: <(builtin.integer ui8, builtin.integer ui8) -> ()>
  ^outer(acc: builtin.integer ui8, i: builtin.integer ui8):
    inner_seed = gpu.binary (i, step) [] [gpu_binary_kind: gpu.binary_kind Add]: <(builtin.integer ui8, builtin.integer ui8) -> (builtin.integer ui8)>;
    outer_test = gpu.compare (i, n) [] [gpu_compare_predicate: gpu.compare_predicate LessThan]: <(builtin.integer ui8, builtin.integer ui8) -> (builtin.integer i1)>;
    gpu.cond_branch (outer_test, acc, i, inner_seed, acc) [^inner, ^exit] [operand_segment_sizes: builtin.operand_segment_sizes [1, 3, 1]]: <(builtin.integer i1, builtin.integer ui8, builtin.integer ui8, builtin.integer ui8, builtin.integer ui8) -> ()>
  ^inner(total: builtin.integer ui8, outer_i: builtin.integer ui8, j: builtin.integer ui8):
