    gpu.cond_branch (inner_test, total, outer_i, j, total, outer_i) [^inner_body, ^outer_latch] [operand_segment_sizes: builtin.operand_segment_sizes [1, 3, 2]]: <(builtin.integer i1, builtin.integer ui8, builtin.integer ui8, builtin.integer ui8, builtin.integer ui8, builtin.integer ui8) -> ()>
  ^inner_body(value: builtin.integer ui8, saved_i: builtin.integer ui8, k: builtin.integer ui8):
    new_value = gpu.binary (value, step) [] [gpu_binary_kind: gpu.binary_kind Add]: <(builtin.integer ui8, builtin.integer ui8) -> (builtin.integer ui8)>;
    new_j = gpu.binary (k, step) [] [gpu_binary_kind: gpu.binary_kind Add]: <(builtin.integer ui8, builtin.integer ui8) -> (builtin.integer ui8)>;
    gpu.branch (new_value, saved_i, new_j) [^inner] []: <(builtin.integer ui8, builtin.integer ui8, builtin.integer ui8) -> ()>
