// RUN: fe2o3-pliron-lit --passes=general %s
// EXPECT: REJECT
// CHECK: error[FE2O3-BOUNDS-001]
// CHECK: required: 64 < 64
builtin.func @boolean_no_bounds_assumption: builtin.function <(builtin.integer i1) -> ()>
{
  ^entry(b: builtin.integer i1):
    gpu.cond_branch (b) [^read, ^exit] [operand_segment_sizes: builtin.operand_segment_sizes [1, 0, 0]]: <(builtin.integer i1) -> ()>
  ^read():
    v = kernel.ranked_view () [] [kernel_memory_space: kernel.memory_space Global]: <() -> (kernel.ranked_view <32,false,[64]>)>;
    i = kernel.index_constant () [] [kernel_index_value: kernel.index_value 64]: <() -> (kernel.index)>;
    kernel.access (v, i) [] [kernel_access_kind: kernel.access_kind Read]: <(kernel.ranked_view <32,false,[64]>, kernel.index) -> ()>;
    kernel.return () [] []: <() -> ()>
  ^exit():
    kernel.return () [] []: <() -> ()>
}
