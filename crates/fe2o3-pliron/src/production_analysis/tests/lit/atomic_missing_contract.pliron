// RUN: fe2o3-pliron-lit --passes=general %s
// EXPECT: REJECT
// CHECK: error[FE2O3-ATOMIC-001]
// CHECK: lacks an explicit atomic contract
builtin.func @atomic_missing_contract: builtin.function <() -> ()>
{
  ^entry_block1v1():
    v0 = kernel.ranked_view () [] [kernel_memory_space: kernel.memory_space Global]: <() -> (kernel.ranked_view <32,true,[1]>)>;
    v1 = kernel.index_constant () [] [kernel_index_value: kernel.index_value 0]: <() -> (kernel.index )>;
    kernel.access (v0, v1) [] [kernel_access_kind: kernel.access_kind AtomicWrite]: <(kernel.ranked_view <32,true,[1]>, kernel.index ) -> ()>;
    kernel.return () [] []: <() -> ()>
}
