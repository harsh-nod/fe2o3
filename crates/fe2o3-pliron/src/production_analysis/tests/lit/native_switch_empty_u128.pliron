// RUN: fe2o3-pliron-lit --passes=general %s
// EXPECT: PASS
// CHECK-WITNESSES
// CHECK: PASS
// CHECK: WITNESS TensorLayout
// CHECK: WITNESS MemoryBounds
// CHECK: WITNESS AtomicLegality
// CHECK: WITNESS RaceFreedom
// CHECK: WITNESS HierarchicalOwnership
// CHECK: WITNESS BarrierConvergence
// CHECK: WITNESS PipelineProtocol
// CHECK: WITNESS WorkgroupMemory
// CHECK: WITNESS SemanticRefinement
builtin.func @native_switch_empty_u128: builtin.function <(builtin.integer ui128) -> ()>
{
  ^entry(selector: builtin.integer ui128):
    gpu.switch_v3 (selector) [^exit] [gpu_switch_kind: gpu.switch_key_kind_v3 EmptyTyped, gpu_switch_cases: gpu.switch_case_bits_v3 [], gpu_switch_offsets: gpu.switch_successor_offsets_v3 [0, 0], operand_segment_sizes: builtin.operand_segment_sizes [1, 0]]: <(builtin.integer ui128) -> ()>
  ^exit():
    gpu.return () [] []: <() -> ()>
}
