// RUN: fe2o3-pliron-lit --passes=general %s
// EXPECT: PASS
// CHECK-WITNESSES
// CHECK: PASS
// CHECK: WITNESS TensorLayout
// CHECK: WITNESS MemoryBounds
// CHECK: WITNESS AtomicLegality
// CHECK: WITNESS RaceFreedom
// CHECK: WITNESS HierarchicalOwnership
// CHECK: WITNESS BarrierConvergence
// CHECK: WITNESS PipelineProtocol
// CHECK: WITNESS WorkgroupMemory
// CHECK: WITNESS SemanticRefinement
builtin.func @native_control_branch_payload: builtin.function <(builtin.integer ui32) -> (builtin.integer ui32)>
{
  ^entry(x: builtin.integer ui32):
    gpu.branch (x) [^exit] []: <(builtin.integer ui32) -> ()>
  ^exit(y: builtin.integer ui32):
    gpu.return (y) [] []: <(builtin.integer ui32) -> ()>
}
