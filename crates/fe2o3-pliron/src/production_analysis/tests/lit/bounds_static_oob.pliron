// RUN: fe2o3-pliron-lit --passes=general %s
// EXPECT: REJECT
// CHECK: error[FE2O3-BOUNDS-001]
// CHECK: required: 64 < 64
builtin.func @bounds_static_oob: builtin.function <() -> ()>
{
  ^entry_block1v1():
    v0 = kernel.ranked_view () [] [kernel_memory_space: kernel.memory_space Global]: <() -> (kernel.ranked_view <32,false,[64]>)>;
    v1 = kernel.index_constant () [] [kernel_index_value: kernel.index_value 64]: <() -> (kernel.index )>;
    kernel.access (v0, v1) [] [kernel_access_kind: kernel.access_kind Read]: <(kernel.ranked_view <32,false,[64]>, kernel.index ) -> ()>;
    kernel.return () [] []: <() -> ()>
}
