// Owner-backed expectation, not a textual source admission or receipt parser.
// RUN: cargo test -p rustc-codegen-fe2o3 --lib private_array_equal_indices_textual_expectation_keeps_distinct_occurrences
KIR alloca=1 element=U32 space=Private access=ReadWrite align=4 count=8
KIR store=6 gep=5 index=0 space=Private align=4 volatile=false
KIR store=11 gep=10 index=0 space=Private align=4 volatile=false
KIR loads=0 stores=2
QUERY source=0/1/Destination index=0
QUERY source=0/3/Destination index=0
RANKED source=0/1/0 Write Private width=32 shape=8 index=0
RANKED source=0/3/0 Write Private width=32 shape=8 index=0
ATTACH swapped-physical-sites=ControlFlowMismatch
