// CHECK: error[FE2O3-PIPELINE-001]
// CHECK: may alias staged storage already owned by pipeline
// CHECK: help[FE2O3-FIX-PIPELINE]
builtin.func @pipeline_unknown_storage_alias: builtin.function <() -> ()>
{
  ^entry_block1v1():
    v0 = kernel.ranked_view () [] [kernel_memory_space: kernel.memory_space Workgroup]: <() -> (kernel.ranked_view <16,true,[2,64]>)>;
    v1 = kernel.ranked_view () [] [kernel_memory_space: kernel.memory_space Workgroup]: <() -> (kernel.ranked_view <16,true,[2,64]>)>;
    p2 = kernel.pipeline_create (v0) [] []: <(kernel.ranked_view <16,true,[2,64]>) -> (kernel.pipeline <2,1>)>;
    p3 = kernel.pipeline_create (v1) [] []: <(kernel.ranked_view <16,true,[2,64]>) -> (kernel.pipeline <2,1>)>;
    zero_v4 = kernel.index_constant () [] [kernel_index_value: kernel.index_value 0]: <() -> (kernel.index )>;
    kernel.pipeline_event (p2, zero_v4, zero_v4) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Stage]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.pipeline_event (p2, zero_v4, zero_v4) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Commit]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.pipeline_event (p2, zero_v4, zero_v4) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Wait]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.pipeline_event (p2, zero_v4, zero_v4) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Consume]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.pipeline_event (p2, zero_v4, zero_v4) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Release]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.pipeline_event (p3, zero_v4, zero_v4) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Stage]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.pipeline_event (p3, zero_v4, zero_v4) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Commit]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.pipeline_event (p3, zero_v4, zero_v4) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Wait]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.pipeline_event (p3, zero_v4, zero_v4) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Consume]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.pipeline_event (p3, zero_v4, zero_v4) [] [kernel_pipeline_event_kind: kernel.pipeline_event_kind Release]: <(kernel.pipeline <2,1>, kernel.index , kernel.index ) -> ()>;
    kernel.return () [] []: <() -> ()>
}
