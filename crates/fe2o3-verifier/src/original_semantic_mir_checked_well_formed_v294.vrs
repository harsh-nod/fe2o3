// Shape preservation does not preserve a loan's currentness when its origin
// is overwritten. All resident maps may be nonempty before this operation.
proof fn invocation_source_logical_write_well_formed_v294(
    logical: InvocationSourceLogicalV38, count: int, local: int,
)
    requires invocation_source_logical_well_formed_v38(logical, count),
        0 <= local < count,
    ensures invocation_source_logical_well_formed_v38(
        invocation_source_logical_write_v38(logical, local), count),
{
    let changed = invocation_source_logical_write_v38(logical, local);
    assert(changed.versions.len() == logical.versions.len());
    assert forall|i: int| 0 <= i < count implies
        changed.versions[i] >= logical.versions[i] && changed.versions[i] >= 0 by {}
    assert forall|reference: InvocationSourceExecutionReferenceV168|
        invocation_source_execution_reference_shape_v168(reference, logical.versions) implies
        invocation_source_execution_reference_shape_v168(reference, changed.versions) by {
        assert(changed.versions[reference.identity.local] >= logical.versions[reference.identity.local]);
        assert(changed.versions[reference.origin] >= logical.versions[reference.origin]);
        assert forall|i: int| 0 <= i < reference.ancestors.len() implies
            invocation_source_execution_id_shape_v168(reference.ancestors[i], changed.versions)
                && reference.ancestors[i] != reference.identity by {
            assert(invocation_source_execution_id_shape_v168(reference.ancestors[i], logical.versions));
            assert(changed.versions[reference.ancestors[i].local]
                >= logical.versions[reference.ancestors[i].local]);
        }
    }
    assert forall|i: int| changed.execution_references.contains_key(i) implies
        0 <= i < count
            && invocation_source_execution_reference_shape_v168(changed.execution_references[i], changed.versions)
            && !changed.witnesses.contains_key(i) && !changed.references.contains_key(i)
            && !changed.descriptor_references.contains_key(i)
            && !changed.aggregates.contains_key(i) && !changed.enums.contains_key(i) by {
        assert(logical.execution_references.contains_key(i));
        assert(invocation_source_execution_reference_shape_v168(logical.execution_references[i], logical.versions));
    }
    assert(invocation_source_execution_ancestry_v168(changed.execution_references));
    assert forall|i: int| changed.products.contains_key(i) implies
        0 <= i < count && invocation_source_product_well_formed_v282(changed.products[i])
            && !changed.witnesses.contains_key(i) && !changed.references.contains_key(i)
            && !changed.execution_references.contains_key(i) && !changed.descriptor_references.contains_key(i)
            && !changed.aggregates.contains_key(i) && !changed.enums.contains_key(i) by {
        assert(logical.products.contains_key(i));
    }
    assert forall|i: int, path: Seq<int>| changed.products.contains_key(i)
        && changed.products[i].components.contains_key(path) implies
        match changed.products[i].components[path] {
            InvocationSourceProductAtomV282::Execution(reference) =>
                invocation_source_execution_reference_shape_v168(reference, changed.versions),
            _ => true,
        } by {
        assert(logical.products.contains_key(i));
        if let InvocationSourceProductAtomV282::Execution(reference) = logical.products[i].components[path] {
            assert(invocation_source_execution_reference_shape_v168(reference, logical.versions));
        }
    }
    assert(invocation_source_product_execution_ancestry_v282(changed));
    assert(changed.execution_pending.dom().subset_of(logical.execution_pending.dom()));
    vstd::set_lib::lemma_len_subset(changed.execution_pending.dom(), logical.execution_pending.dom());
    assert forall|i: int| changed.execution_pending.contains_key(i) implies
        invocation_source_execution_reference_shape_v168(changed.execution_pending[i].reference, changed.versions)
            && 0 < changed.execution_pending[i].moved_version <= changed.versions[i] by {
        assert(logical.execution_pending.contains_key(i));
        assert(invocation_source_execution_reference_shape_v168(logical.execution_pending[i].reference, logical.versions));
        assert(i != local);
    }
    assert(invocation_source_execution_pending_shape_v286(changed));
    assert forall|i: int| changed.descriptor_references.contains_key(i) implies
        0 <= i < count
            && invocation_source_descriptor_reference_shape_v51(changed.descriptor_references[i], count)
            && !changed.witnesses.contains_key(i) && !changed.references.contains_key(i)
            && !changed.aggregates.contains_key(i) && !changed.enums.contains_key(i) by {
        assert(logical.descriptor_references.contains_key(i));
    }
    assert forall|i: int| changed.enums.contains_key(i) implies
        0 <= i < count && invocation_source_enum_well_formed_v47(changed.enums[i])
            && !changed.witnesses.contains_key(i) && !changed.references.contains_key(i)
            && !changed.aggregates.contains_key(i) by {
        assert(logical.enums.contains_key(i));
    }
    assert forall|i: int| changed.aggregates.contains_key(i) implies
        0 <= i < count && invocation_source_aggregate_well_formed_v42(changed.aggregates[i])
            && !changed.witnesses.contains_key(i) && !changed.references.contains_key(i) by {
        assert(logical.aggregates.contains_key(i));
    }
    assert forall|i: int| changed.witnesses.contains_key(i) implies
        0 <= i < count && changed.witnesses[i] >= 0 && !changed.references.contains_key(i) by {
        assert(logical.witnesses.contains_key(i));
    }
    assert forall|i: int| changed.references.contains_key(i) implies
        0 <= i < count && 0 <= changed.references[i].origin < count
            && changed.references[i].version >= 0
            && changed.references[i].source_type >= 0
            && changed.references[i].origin_generation >= 0
            && changed.references[i].borrow_instance >= 0
            && changed.references[i].borrow_block >= 0
            && changed.references[i].borrow_statement >= 0 by {
        assert(logical.references.contains_key(i));
    }
}

proof fn invocation_source_plain_aggregate_install_well_formed_v294(
    source: InvocationSourceByteStateV36, destination: int, aggregate: InvocationSourceAggregateV42,
)
    requires source.machine.valid && invocation_source_byte_state_well_formed_v36(source),
        0 <= destination < source.machine.values.len(), !source.objects.contains_key(destination),
        invocation_source_aggregate_well_formed_v42(aggregate), aggregate.execution_lease.is_none(),
    ensures invocation_source_byte_state_well_formed_v36(
        invocation_source_aggregate_install_v42(source, destination, aggregate)),
{
    invocation_source_plain_aggregate_install_frame_v260(source, destination, aggregate);
    invocation_source_logical_write_well_formed_v294(source.logical,
        source.machine.values.len() as int, destination);
    let cleared = invocation_source_logical_write_v38(source.logical, destination);
    let after = invocation_source_aggregate_install_v42(source, destination, aggregate);
    assert(after.logical == (InvocationSourceLogicalV38 {
        aggregates: cleared.aggregates.insert(destination, aggregate), ..cleared }));
    // Inserting a lease-free aggregate adds no execution-ancestry or pending
    // pair. The destination was removed from every competing resident map.
    assert(invocation_source_execution_pending_shape_v286(after.logical));
    assert(invocation_source_product_execution_ancestry_v282(after.logical));
    assert forall|i: int| after.logical.aggregates.contains_key(i) implies
        0 <= i < source.machine.values.len()
            && invocation_source_aggregate_well_formed_v42(after.logical.aggregates[i])
            && !after.logical.witnesses.contains_key(i) && !after.logical.references.contains_key(i) by {
        if i != destination {
            assert(cleared.aggregates.contains_key(i));
        }
    }
    assert(invocation_source_logical_well_formed_v38(after.logical, after.machine.values.len() as int));
    assert forall|i: int| after.logical.execution_pending.contains_key(i) implies
        after.machine.values[i] == MemoryValueV30::Undefined && !after.objects.contains_key(i) by {
        assert(i != destination && source.logical.execution_pending.contains_key(i));
    }
    assert forall|i: int| after.logical.execution_references.contains_key(i) implies
        after.machine.values[i] == MemoryValueV30::Unit && !after.objects.contains_key(i) by {
        assert(i != destination && source.logical.execution_references.contains_key(i));
    }
    assert forall|i: int| after.logical.descriptor_references.contains_key(i) implies
        !after.objects.contains_key(i)
            && match after.machine.values[i] { MemoryValueV30::Slice(_) => true, _ => false } by {
        assert(i != destination && source.logical.descriptor_references.contains_key(i));
    }
    assert forall|i: int| after.logical.aggregates.contains_key(i) implies
        after.machine.values[i] == MemoryValueV30::Undefined && !after.objects.contains_key(i) by {
        if i != destination { assert(source.logical.aggregates.contains_key(i)); }
    }
    assert forall|i: int| after.logical.products.contains_key(i) implies
        after.machine.values[i] == MemoryValueV30::Undefined && !after.objects.contains_key(i) by {
        assert(i != destination && source.logical.products.contains_key(i));
    }
    assert forall|i: int| after.logical.enums.contains_key(i) implies
        after.machine.values[i] == MemoryValueV30::Undefined && !after.objects.contains_key(i) by {
        assert(i != destination && source.logical.enums.contains_key(i));
    }
    assert(after.machine.memory == source.machine.memory
        && after.machine.frames == source.machine.frames
        && after.machine.generations == source.machine.generations
        && after.slots == source.slots && after.objects == source.objects
        && after.machine.values.len() == source.machine.values.len());
}

proof fn invocation_source_checked_add_local_well_formed_v294(
    source: InvocationSourceByteStateV36, destination: int, source_type: int,
    left_local: int, right_local: int, left: int, right: int,
    root: int, instance: int, little_endian: bool,
)
    requires source.machine.valid && invocation_source_byte_state_well_formed_v36(source),
        0 <= destination < source.machine.values.len(), !source.objects.contains_key(destination),
        0 <= left_local < source.machine.values.len(), 0 <= right_local < source.machine.values.len(),
        source.machine.values[left_local] == MemoryValueV30::Scalar(left),
        source.machine.values[right_local] == MemoryValueV30::Scalar(right),
        0 <= left < 4294967296, 0 <= right < 4294967296,
        invocation_source_aggregate_leaf_count_v42(source_type) == 2,
        invocation_source_aggregate_leaf_path_v42(source_type, 0) == seq![0int],
        invocation_source_aggregate_leaf_path_v42(source_type, 1) == seq![1int],
        invocation_source_aggregate_leaf_bits_v42(source_type, 0) == 32,
        invocation_source_aggregate_leaf_bits_v42(source_type, 1) == 1,
    ensures ({ let after = invocation_source_byte_step_v36(source,
        InvocationSourceByteEventV36::Checked {
            destination, source_type, operation: 0, bits: 32, signed: false,
            left: InvocationSourceByteValueV36::Local { local: left_local, moved: false },
            right: InvocationSourceByteValueV36::Local { local: right_local, moved: false } },
        root, instance, little_endian);
        invocation_source_byte_state_well_formed_v36(after)
            && after.machine.pc == source.machine.pc
            && after.machine.values.len() == source.machine.values.len()
            && after.slots == source.slots && after.objects == source.objects }),
{
    invocation_source_local_evaluates_v265(source, left_local, 32, root, instance, little_endian);
    invocation_source_local_evaluates_v265(source, right_local, 32, root, instance, little_endian);
    invocation_checked_add_aggregate_complete_v260(source_type, left, right);
    let aggregate = InvocationSourceAggregateV42 { source_type, execution_lease: None,
        leaves: Map::empty().insert(seq![0int], MemoryValueV30::Scalar((left + right) % 4294967296))
            .insert(seq![1int], MemoryValueV30::Scalar(
                if left + right >= 4294967296 { 1int } else { 0int })) };
    invocation_source_plain_aggregate_install_well_formed_v294(source, destination, aggregate);
    invocation_source_plain_aggregate_install_frame_v260(source, destination, aggregate);
    let lhs = InvocationSourceByteValueV36::Local { local: left_local, moved: false };
    let rhs = InvocationSourceByteValueV36::Local { local: right_local, moved: false };
    invocation_source_checked_add_replays_install_v260(source, destination, source_type,
        lhs, rhs, left, right, root, instance, little_endian);
    invocation_source_checked_event_replays_v264(source, destination, source_type,
        0, 32, false, lhs, rhs, root, instance, little_endian);
}
