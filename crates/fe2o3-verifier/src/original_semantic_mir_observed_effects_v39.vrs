// Each source observation owns the states at that effect, not the final block
// heap. Its private allocation generation therefore survives later StorageDead.
struct InvocationSourceEffectObservationV39 {
    before: InvocationSourceByteStateV36,
    after: InvocationSourceByteStateV36,
    effect: MemoryOperationEffectV30,
}

open spec fn invocation_project_effect_v39(effect: MemoryOperationEffectV30)
    -> Option<MemoryOperationEffectV30>
{
    match effect {
        MemoryOperationEffectV30::Refused => Some(MemoryOperationEffectV30::Refused),
        MemoryOperationEffectV30::Trap => Some(MemoryOperationEffectV30::Trap),
        MemoryOperationEffectV30::Pure => None,
        MemoryOperationEffectV30::Allocate { address, .. } => match address {
            MemoryValueV30::Pointer(pointer) => if invocation_private_allocation_v36(pointer.allocation) {
                None
            } else { Some(MemoryOperationEffectV30::Refused) },
            _ => Some(MemoryOperationEffectV30::Refused),
        },
        MemoryOperationEffectV30::Read { address, .. }
        | MemoryOperationEffectV30::Write { address, .. } => match address {
            MemoryValueV30::Pointer(pointer) => if invocation_private_allocation_v36(pointer.allocation) {
                None
            } else { Some(effect) },
            _ => Some(MemoryOperationEffectV30::Refused),
        },
        MemoryOperationEffectV30::Copy { source, destination, .. } => match (source, destination) {
            (MemoryValueV30::Pointer(source), MemoryValueV30::Pointer(destination)) =>
                if invocation_private_allocation_v36(source.allocation)
                    && invocation_private_allocation_v36(destination.allocation) { None }
                else { Some(effect) },
            _ => Some(MemoryOperationEffectV30::Refused),
        },
        // A downcast needs its own original validation observation. It cannot
        // be hidden merely because the tag is stored in private memory.
        MemoryOperationEffectV30::TagRead { address, observation, purpose, .. } =>
            match (address, observation, purpose) {
                (MemoryValueV30::Pointer(_), Some(_),
                    MemoryTagReadPurposeV39::DiscriminantRead) => Some(effect),
                _ => Some(MemoryOperationEffectV30::Refused),
            },
    }
}

open spec fn invocation_actual_observations_v39(observations: Seq<MemoryOperationObservationV30>)
    -> Seq<MemoryOperationObservationV30>
    decreases observations.len(),
{
    if observations.len() == 0 { seq![] } else {
        let head = observations[0];
        let projected = if !byte_observation_snapshots_valid_v39(head)
            || !head.valid_before || !head.valid_after {
            Some(MemoryOperationEffectV30::Refused)
        } else { invocation_project_effect_v39(head.effect) };
        let prefix = match projected {
            Some(effect) => seq![MemoryOperationObservationV30 { effect, ..head }],
            None => seq![],
        };
        prefix + invocation_actual_observations_v39(observations.drop_first())
    }
}

open spec fn invocation_source_observe_effects_v39(
    effects: Seq<MemoryOperationEffectV30>, before: InvocationSourceByteStateV36,
    after: InvocationSourceByteStateV36,
) -> Seq<InvocationSourceEffectObservationV39> {
    Seq::new(effects.len(), |i: int| InvocationSourceEffectObservationV39 {
        before, after, effect: effects[i] })
}

open spec fn invocation_source_statement_observations_v39(
    observation: InvocationSourceStatementObservationV36, little_endian: bool,
) -> Seq<InvocationSourceEffectObservationV39> {
    if !observation.before.machine.valid || !observation.after.machine.valid {
        invocation_source_observe_effects_v39(seq![MemoryOperationEffectV30::Refused],
            observation.before, observation.after)
    } else { match observation.event {
        Some(InvocationSourceByteEventV36::IntegerCast(cast)) => {
            let result = invocation_source_integer_cast_v43(observation.before, cast,
                observation.root, observation.instance, little_endian);
            if result.source == observation.after { result.observations }
            else { invocation_source_observe_effects_v39(seq![MemoryOperationEffectV30::Refused],
                observation.before, observation.after) }
        },
        Some(InvocationSourceByteEventV36::CheckedObject(event)) => {
            let result = invocation_source_checked_object_v44(observation.before, event,
                observation.root, observation.instance, little_endian);
            if result.source == observation.after { result.observations }
            else { invocation_source_observe_effects_v39(seq![MemoryOperationEffectV30::Refused],
                observation.before, observation.after) }
        },
        Some(InvocationSourceByteEventV36::EnumConstruct(constructed)) => {
            let result = invocation_source_enum_construct_v43(observation.before, constructed,
                observation.root, observation.instance, little_endian);
            if result.source == observation.after { result.observations }
            else { invocation_source_observe_effects_v39(seq![MemoryOperationEffectV30::Refused],
                observation.before, observation.after) }
        },
        Some(InvocationSourceByteEventV36::Discriminant(read)) => {
            let result = invocation_source_discriminant_read_v41(observation.before, read,
                observation.root, observation.instance, little_endian);
            invocation_source_observe_effects_v39(seq![
                if result.source == observation.after { result.effect }
                else { MemoryOperationEffectV30::Refused }], observation.before, observation.after)
        },
        Some(InvocationSourceByteEventV36::Transfer { destination, value, bits }) => {
            let evaluated = invocation_source_byte_evaluate_v36(observation.before, value, bits,
                observation.root, observation.instance, little_endian);
            let reads = invocation_source_observe_effects_v39(invocation_source_read_effect_v36(
                observation.before, value, bits, observation.root, observation.instance, little_endian),
                observation.before, evaluated.source);
            let writes = match destination {
                InvocationSourceByteDestinationV36::Memory(access) =>
                    match invocation_source_byte_address_v36(evaluated.source, access,
                        observation.root, observation.instance) {
                        Some(pointer) => if invocation_private_allocation_v36(pointer.allocation) { seq![] }
                            else { seq![MemoryOperationEffectV30::Write {
                                address: MemoryValueV30::Pointer(pointer), width: access.width,
                                alignment: access.alignment, value: evaluated.value }] },
                        None => seq![MemoryOperationEffectV30::Refused],
                    },
                InvocationSourceByteDestinationV36::Local(_)
                | InvocationSourceByteDestinationV36::Component(_) => seq![],
            };
            reads + invocation_source_observe_effects_v39(writes, evaluated.source, observation.after)
        },
        Some(event @ InvocationSourceByteEventV36::Checked { .. })
        | Some(event @ InvocationSourceByteEventV36::AggregateTransfer { .. })
        | Some(event @ InvocationSourceByteEventV36::AggregateDeinitialize(_))
        | Some(event @ InvocationSourceByteEventV36::AggregateReset { .. }) => {
            if invocation_source_byte_step_v36(observation.before, event,
                observation.root, observation.instance, little_endian) == observation.after {
                seq![]
            } else { invocation_source_observe_effects_v39(seq![MemoryOperationEffectV30::Refused],
                observation.before, observation.after) }
        },
        Some(InvocationSourceByteEventV36::Scalar)
        | Some(InvocationSourceByteEventV36::WitnessBorrow { .. })
        | Some(InvocationSourceByteEventV36::WitnessTransfer { .. })
        | Some(InvocationSourceByteEventV36::Pointer(_))
        | Some(InvocationSourceByteEventV36::Address { .. })
        | Some(InvocationSourceByteEventV36::Deinitialize(_))
        | Some(InvocationSourceByteEventV36::ObjectLive { .. })
        | Some(InvocationSourceByteEventV36::ObjectDead { .. })
        | Some(InvocationSourceByteEventV36::StorageLive { .. })
        | Some(InvocationSourceByteEventV36::StorageDead { .. }) => seq![],
        None => invocation_source_observe_effects_v39(seq![MemoryOperationEffectV30::Refused],
            observation.before, observation.after),
    } }
}

open spec fn invocation_source_statements_observations_v39(
    observations: Seq<InvocationSourceStatementObservationV36>, little_endian: bool,
) -> Seq<InvocationSourceEffectObservationV39>
    decreases observations.len(),
{
    if observations.len() == 0 { seq![] } else {
        invocation_source_statement_observations_v39(observations[0], little_endian)
            + invocation_source_statements_observations_v39(observations.drop_first(), little_endian)
    }
}

open spec fn invocation_source_operands_observations_v39(
    observations: Seq<InvocationSourceOperandObservationV36>, little_endian: bool,
) -> Seq<InvocationSourceEffectObservationV39>
    decreases observations.len(),
{
    if observations.len() == 0 { seq![] } else {
        let head = observations[0];
        let effects = if !head.before.machine.valid || !head.after.machine.valid {
            seq![MemoryOperationEffectV30::Refused]
        } else { match head.operand {
            InvocationSourceOperandV36::Scalar { value, bits } =>
                invocation_source_read_effect_v36(head.before, value, bits,
                    head.root, head.instance, little_endian),
            InvocationSourceOperandV36::Pointer { .. }
            | InvocationSourceOperandV36::Slice { .. } => seq![],
            InvocationSourceOperandV36::Aggregate { .. } => {
                let evaluated = invocation_source_value_evaluate_v42(head.before, head.operand,
                    head.root, head.instance, little_endian);
                if evaluated.source == head.after && evaluated.value == head.value { seq![] }
                else { seq![MemoryOperationEffectV30::Refused] }
            },
        } };
        invocation_source_observe_effects_v39(effects, head.before, head.after)
            + invocation_source_operands_observations_v39(observations.drop_first(), little_endian)
    }
}

open spec fn invocation_source_observations_v39(result: InvocationSourceBlockResultV36,
    little_endian: bool,
) -> Seq<InvocationSourceEffectObservationV39> {
    invocation_source_statements_observations_v39(result.observations, little_endian)
        + invocation_source_operands_observations_v39(result.operands, little_endian)
        + invocation_source_trap_observations_v40(result)
}

open spec fn invocation_source_trap_observations_v40(result: InvocationSourceBlockResultV36)
    -> Seq<InvocationSourceEffectObservationV39>
{
    if result.source.machine.pc != -2 { seq![] } else {
        let before = if result.operands.len() > 0 {
            result.operands.last().after
        } else { result.before_control };
        let authentic = result.before_control.machine.pc >= 0
            && result.operands.len() > 0
            && result.operands[0].role == InvocationSourceOperandRoleV36::AssertCondition
            && result.source == invocation_source_byte_trap_v40(before)
            && result.source.machine.valid && result.returned.is_none();
        invocation_source_observe_effects_v39(
            seq![if authentic { MemoryOperationEffectV30::Trap } else { MemoryOperationEffectV30::Refused }],
            before, result.source)
    }
}

// Compare exactly the selected window, including padding initialization and
// partial fragments. Only fully contained cells appear in the copied map.
open spec fn invocation_copy_windows_related_v39(
    source: ByteMemoryV30, target: ByteMemoryV30,
    original: MemoryPointerV30, actual: MemoryPointerV30, width: int,
    map: InvocationByteMapV36,
) -> bool {
    byte_range_live_v30(source, original, width) && byte_range_live_v30(target, actual, width)
    && (forall|i: int| 0 <= i < width ==>
        source.live[original.allocation].initialized[original.byte_offset + i]
            == target.live[actual.allocation].initialized[actual.byte_offset + i]
        && (source.live[original.allocation].initialized[original.byte_offset + i] ==>
            invocation_byte_token_related_v37(source.live[original.allocation].bytes[original.byte_offset + i],
                target.live[actual.allocation].bytes[actual.byte_offset + i], map, source, target)))
    && (forall|i: int| 0 <= i < width ==> {
        let source_cells = source.live[original.allocation].relocations;
        let target_cells = target.live[actual.allocation].relocations;
        let source_complete = source_cells.contains_key(original.byte_offset + i)
            && i + source_cells[original.byte_offset + i].width <= width;
        let target_complete = target_cells.contains_key(actual.byte_offset + i)
            && i + target_cells[actual.byte_offset + i].width <= width;
        source_complete == target_complete && (source_complete ==>
            invocation_relocation_related_v37(source_cells[original.byte_offset + i],
                target_cells[actual.byte_offset + i], map, source, target))
    })
}

open spec fn invocation_observed_effect_related_v39(
    source: InvocationSourceEffectObservationV39, target: MemoryOperationObservationV30,
    before_map: InvocationByteMapV36, after_map: InvocationByteMapV36,
) -> bool {
    source.before.machine.valid && source.after.machine.valid
    && invocation_source_byte_state_well_formed_v36(source.before)
    && invocation_source_byte_state_well_formed_v36(source.after)
    && byte_observation_snapshots_valid_v39(target) && target.valid_before && target.valid_after
    && byte_state_memory_well_formed_v30(target.before) && byte_state_memory_well_formed_v30(target.after)
    && match (source.effect, target.effect) {
        (MemoryOperationEffectV30::TagRead { address: sa, width: sw, alignment: ss,
            purpose: MemoryTagReadPurposeV39::DiscriminantRead, observation: Some(so) },
         MemoryOperationEffectV30::TagRead { address: ta, width: tw, alignment: ts,
            purpose: MemoryTagReadPurposeV39::DiscriminantRead, observation: Some(to) }) =>
            sw == tw && ss == ts
                && source.before.machine.memory == source.after.machine.memory
                && target.before.memory == target.after.memory
                && invocation_view_registries_related_v40(source.before.machine.memory, target.before.memory)
                && invocation_value_related_v36(sa, ta, before_map,
                    source.before.machine.memory, target.before.memory)
                && match (so, to) {
                    (MemoryTagObservationV39::Scalar { bits: source_bits },
                     MemoryTagObservationV39::Scalar { bits: target_bits }) => source_bits == target_bits,
                    (MemoryTagObservationV39::Null, MemoryTagObservationV39::Null) => true,
                    (MemoryTagObservationV39::Pointer { pointer: source_pointer },
                     MemoryTagObservationV39::Pointer { pointer: target_pointer }) =>
                        invocation_value_related_v36(MemoryValueV30::Pointer(source_pointer),
                            MemoryValueV30::Pointer(target_pointer), before_map,
                            source.before.machine.memory, target.before.memory),
                    _ => false,
                },
        (MemoryOperationEffectV30::Trap, MemoryOperationEffectV30::Trap) =>
            source.before.machine.pc >= 0 && source.after.machine.pc == -2
            && target.before.pc >= 0 && target.after.pc == -2
            && source.after == invocation_source_byte_trap_v40(source.before)
            && target.after == (MemoryStateV30 { pc: -2, ..target.before }),
        (MemoryOperationEffectV30::Read { address: sa, width: sw, alignment: ss, value: sv },
         MemoryOperationEffectV30::Read { address: ta, width: tw, alignment: ts, value: tv }) =>
            sw == tw && ss == ts && invocation_value_related_v36(sa, ta, before_map,
                source.before.machine.memory, target.before.memory)
                && invocation_value_related_v36(sv, tv, before_map,
                    source.before.machine.memory, target.before.memory),
        (MemoryOperationEffectV30::Write { address: sa, width: sw, alignment: ss, value: sv },
         MemoryOperationEffectV30::Write { address: ta, width: tw, alignment: ts, value: tv }) =>
            sw == tw && ss == ts && invocation_value_related_v36(sa, ta, before_map,
                source.before.machine.memory, target.before.memory)
                && invocation_value_related_v36(sv, tv, before_map,
                    source.before.machine.memory, target.before.memory),
        (MemoryOperationEffectV30::Copy { source: ss, destination: sd, width: sw,
            source_alignment: ssa, destination_alignment: sda, nonoverlapping: sn },
         MemoryOperationEffectV30::Copy { source: ts, destination: td, width: tw,
            source_alignment: tsa, destination_alignment: tda, nonoverlapping: tn }) =>
            sw == tw && ssa == tsa && sda == tda && sn == tn
            && invocation_value_related_v36(ss, ts, before_map,
                source.before.machine.memory, target.before.memory)
            && invocation_value_related_v36(sd, td, before_map,
                source.before.machine.memory, target.before.memory)
            && match (ss, sd, ts, td) {
                (MemoryValueV30::Pointer(ss), MemoryValueV30::Pointer(sd),
                 MemoryValueV30::Pointer(ts), MemoryValueV30::Pointer(td)) =>
                    byte_copy_object_valid_v37(source.before.machine.memory, ss, sd, sw, ssa, sda, sn)
                    && byte_copy_object_valid_v37(target.before.memory, ts, td, tw, tsa, tda, tn)
                    && invocation_copy_windows_related_v39(source.before.machine.memory,
                        target.before.memory, ss, ts, sw, before_map)
                    && invocation_copy_windows_related_v39(source.after.machine.memory,
                        target.after.memory, sd, td, sw, after_map),
                _ => false,
            },
        // Unsupported classes are explicit, not an unexamined equality path.
        (MemoryOperationEffectV30::Refused, _)
        | (MemoryOperationEffectV30::Pure, _)
        | (MemoryOperationEffectV30::Allocate { .. }, _)
        | (MemoryOperationEffectV30::TagRead { .. }, _) => false,
        (MemoryOperationEffectV30::Read { .. }, _)
        | (MemoryOperationEffectV30::Write { .. }, _)
        | (MemoryOperationEffectV30::Copy { .. }, _)
        | (MemoryOperationEffectV30::Trap, _) => false,
    }
}
