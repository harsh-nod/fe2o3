
// Pointer representation is nominal. No numeric address or integer-derived
// provenance is introduced. An incomplete fragment remains opaque after copy.
open spec fn byte_octet_v37(byte: MemoryByteV37) -> int
    recommends matches!(byte, MemoryByteV37::Octet(_)),
{
    match byte {
        MemoryByteV37::Octet(value) => value,
        MemoryByteV37::PointerFragment { .. } => 0,
    }
}

open spec fn byte_token_well_formed_v37(byte: MemoryByteV37) -> bool {
    match byte {
        MemoryByteV37::Octet(value) => 0 <= value < 256,
        MemoryByteV37::PointerFragment { pointer, width, ordinal } =>
            ordinary_memory_width_v30(width) && 0 <= ordinal < width
                && 0 <= pointer.byte_offset && byte_pointer_view_shape_v38(pointer),
    }
}

open spec fn byte_intervals_overlap_v37(a: int, a_width: int, b: int, b_width: int) -> bool {
    0 < a_width && 0 < b_width && a < b + b_width && b < a + a_width
}

open spec fn byte_relocation_fragment_v37(
    relocation: MemoryRelocationV37, relative: int,
) -> MemoryByteV37
    recommends 0 <= relative < relocation.width,
{
    MemoryByteV37::PointerFragment {
        pointer: relocation.pointer,
        width: relocation.width,
        ordinal: if relocation.little_endian { relative }
                 else { relocation.width - 1 - relative },
    }
}

open spec fn byte_object_relocations_well_formed_v37(object: MemoryBytesV30) -> bool {
    object.bytes.len() == object.initialized.len()
    && (forall|i: int| 0 <= i < object.bytes.len() ==>
        byte_token_well_formed_v37(object.bytes[i]))
    && (forall|start: int| object.relocations.contains_key(start) ==> {
        let relocation = object.relocations[start];
        ordinary_memory_width_v30(relocation.width)
        && 0 <= start && start + relocation.width <= object.bytes.len()
        && (forall|i: int| 0 <= i < relocation.width ==>
            object.initialized[start + i]
            && object.bytes[start + i] == byte_relocation_fragment_v37(relocation, i))
    })
    && (forall|a: int, b: int| object.relocations.contains_key(a)
        && object.relocations.contains_key(b) && a != b ==>
        !byte_intervals_overlap_v37(a, object.relocations[a].width, b, object.relocations[b].width))
}

open spec fn byte_plain_range_v37(
    memory: ByteMemoryV30, pointer: MemoryPointerV30, width: int,
) -> bool {
    byte_range_live_v30(memory, pointer, width)
    && forall|i: int| pointer.byte_offset <= i < pointer.byte_offset + width ==>
        matches!(memory.live[pointer.allocation].bytes[i], MemoryByteV37::Octet(_))
}

open spec fn byte_scalar_range_initialized_v37(
    memory: ByteMemoryV30, pointer: MemoryPointerV30, width: int,
) -> bool {
    byte_range_initialized_v30(memory, pointer, width)
        && byte_plain_range_v37(memory, pointer, width)
}

// Invalidates every intersecting complete pointer cell, even when a write's
// new ordinary octets happen to equal some prior machine representation.
open spec fn byte_relocations_without_overlap_v37(
    relocations: Map<int, MemoryRelocationV37>, start: int, width: int,
) -> Map<int, MemoryRelocationV37> {
    Map::new(
        |at: int| relocations.contains_key(at)
            && !byte_intervals_overlap_v37(at, relocations[at].width, start, width),
        |at: int| relocations[at],
    )
}

open spec fn byte_pointer_load_valid_v37(
    memory: ByteMemoryV30, address: MemoryPointerV30, width: int, little_endian: bool,
) -> bool {
    ordinary_memory_width_v30(width)
    && byte_range_initialized_v30(memory, address, width)
    && memory.live[address.allocation].relocations.contains_key(address.byte_offset)
    && {
        let relocation = memory.live[address.allocation].relocations[address.byte_offset];
        relocation.width == width && relocation.little_endian == little_endian
        && forall|i: int| 0 <= i < width ==>
            memory.live[address.allocation].bytes[address.byte_offset + i]
                == byte_relocation_fragment_v37(relocation, i)
    }
}

open spec fn byte_pointer_load_v37(
    memory: ByteMemoryV30, address: MemoryPointerV30, width: int, little_endian: bool,
) -> MemoryPointerV30
    recommends byte_pointer_load_valid_v37(memory, address, width, little_endian),
{
    memory.live[address.allocation].relocations[address.byte_offset].pointer
}

open spec fn byte_pointer_store_v37(
    memory: ByteMemoryV30, address: MemoryPointerV30, width: int,
    pointer: MemoryPointerV30, little_endian: bool,
) -> ByteMemoryV30
    recommends byte_memory_well_formed_v30(memory), ordinary_memory_width_v30(width),
        byte_range_live_v30(memory, address, width), 0 <= pointer.byte_offset,
{
    let previous = memory.live[address.allocation];
    let relocation = MemoryRelocationV37 { pointer, width, little_endian };
    let bytes = Seq::new(previous.bytes.len(), |i: int|
        if address.byte_offset <= i < address.byte_offset + width {
            byte_relocation_fragment_v37(relocation, i - address.byte_offset)
        } else { previous.bytes[i] });
    let initialized = Seq::new(previous.initialized.len(), |i: int|
        previous.initialized[i] || address.byte_offset <= i < address.byte_offset + width);
    let relocations = byte_relocations_without_overlap_v37(
        previous.relocations, address.byte_offset, width,
    ).insert(address.byte_offset, relocation);
    ByteMemoryV30 { live: memory.live.insert(address.allocation, MemoryBytesV30 {
        bytes, initialized, relocations, base_alignment: previous.base_alignment,
        write_clock: byte_write_clock_v38(previous, width),
        write_epochs: byte_overwrite_epochs_v38(previous, address.byte_offset, width),
    }), view_contracts: memory.view_contracts }
}

// Source StorageDead/Deinit uses this representation transform only after its
// own exact source place/lifetime admission. It is not a target-derived grant.
open spec fn byte_deinitialize_v37(
    memory: ByteMemoryV30, address: MemoryPointerV30, width: int,
) -> ByteMemoryV30
    recommends byte_memory_well_formed_v30(memory), byte_range_live_v30(memory, address, width),
{
    let previous = memory.live[address.allocation];
    ByteMemoryV30 { live: memory.live.insert(address.allocation, MemoryBytesV30 {
        bytes: previous.bytes,
        initialized: Seq::new(previous.initialized.len(), |i: int|
            previous.initialized[i]
                && !(address.byte_offset <= i < address.byte_offset + width)),
        relocations: byte_relocations_without_overlap_v37(previous.relocations, address.byte_offset, width),
        base_alignment: previous.base_alignment,
        write_clock: byte_write_clock_v38(previous, width),
        write_epochs: byte_overwrite_epochs_v38(previous, address.byte_offset, width),
    }), view_contracts: memory.view_contracts }
}

open spec fn byte_copy_object_valid_v37(
    memory: ByteMemoryV30, source: MemoryPointerV30, destination: MemoryPointerV30,
    width: int, source_alignment: int, destination_alignment: int, nonoverlapping: bool,
) -> bool {
    byte_range_aligned_v30(memory, source, width, source_alignment)
        && byte_range_aligned_v30(memory, destination, width, destination_alignment)
        && (!nonoverlapping || source.allocation != destination.allocation
            || !byte_intervals_overlap_v37(source.byte_offset, width, destination.byte_offset, width))
}

// The source snapshot precedes every destination change, including when both
// pointers select the same allocation and their ranges overlap. Padding and
// uninitialized bytes are copied without claiming they contain readable values.
// A copied partial cell retains its fragments, but gains no complete relocation.
open spec fn byte_copy_object_v37(
    memory: ByteMemoryV30, source: MemoryPointerV30, destination: MemoryPointerV30, width: int,
) -> ByteMemoryV30
    recommends byte_memory_well_formed_v30(memory),
        byte_range_live_v30(memory, source, width), byte_range_live_v30(memory, destination, width),
{
    let snapshot = memory.live[source.allocation];
    let previous = memory.live[destination.allocation];
    let copied = |at: int| source.byte_offset + at - destination.byte_offset;
    let complete = |at: int| destination.byte_offset <= at
        && at < destination.byte_offset + width
        && snapshot.relocations.contains_key(copied(at))
        && copied(at) + snapshot.relocations[copied(at)].width <= source.byte_offset + width;
    let retained = byte_relocations_without_overlap_v37(previous.relocations, destination.byte_offset, width);
    let relocations = Map::new(
        |at: int| retained.contains_key(at) || complete(at),
        |at: int| if complete(at) { snapshot.relocations[copied(at)] } else { retained[at] },
    );
    ByteMemoryV30 { live: memory.live.insert(destination.allocation, MemoryBytesV30 {
        bytes: Seq::new(previous.bytes.len(), |i: int|
            if destination.byte_offset <= i < destination.byte_offset + width {
                snapshot.bytes[copied(i)]
            } else { previous.bytes[i] }),
        initialized: Seq::new(previous.initialized.len(), |i: int|
            if destination.byte_offset <= i < destination.byte_offset + width {
                snapshot.initialized[copied(i)]
            } else { previous.initialized[i] }),
        relocations,
        base_alignment: previous.base_alignment,
        write_clock: byte_write_clock_v38(previous, width),
        write_epochs: byte_overwrite_epochs_v38(previous, destination.byte_offset, width),
    }), view_contracts: memory.view_contracts }
}
