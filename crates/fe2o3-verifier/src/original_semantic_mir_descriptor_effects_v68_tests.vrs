#[verifier::spinoff_prover]
proof fn aggregate_or_descriptor_singleton_effects_v77(
    head: InvocationSourceOperandObservationV36, little_endian: bool,
    effects: Seq<MemoryOperationEffectV30>,
)
    requires
        matches!(head.operand, InvocationSourceOperandV36::Aggregate { .. }
            | InvocationSourceOperandV36::Descriptor { .. }),
        effects == (if !head.before.machine.valid || !head.after.machine.valid {
            seq![MemoryOperationEffectV30::Refused]
        } else if invocation_source_value_evaluate_v42(head.before, head.operand,
                head.root, head.instance, little_endian).source == head.after
            && invocation_source_value_evaluate_v42(head.before, head.operand,
                head.root, head.instance, little_endian).value == head.value {
            seq![]
        } else { seq![MemoryOperationEffectV30::Refused] }),
    ensures
        invocation_source_operands_effects_v36(seq![head], little_endian) == effects,
        invocation_source_operands_observations_v39(seq![head], little_endian)
            == invocation_source_observe_effects_v39(effects, head.before, head.after),
{
    hide(invocation_source_value_evaluate_v42);
    hide(invocation_source_read_effect_v36);
    hide(invocation_source_operands_effects_v36);
    hide(invocation_source_operands_observations_v39);
    hide(invocation_source_observe_effects_v39);
    let observations = seq![head];
    assert(observations.len() == 1);
    assert(observations[0] == head);
    assert(observations.drop_first() =~= Seq::empty());
    assert(invocation_source_operands_effects_v36(observations, little_endian) == effects) by {
        reveal_with_fuel(invocation_source_operands_effects_v36, 2);
        assert(invocation_source_operands_effects_v36(Seq::empty(), little_endian) == seq![]);
        assert(invocation_source_operands_effects_v36(observations, little_endian) =~= effects);
    }
    assert(invocation_source_operands_observations_v39(observations, little_endian)
        == invocation_source_observe_effects_v39(effects, head.before, head.after)) by {
        reveal_with_fuel(invocation_source_operands_observations_v39, 2);
        assert(invocation_source_operands_observations_v39(Seq::empty(), little_endian) == seq![]);
        assert(invocation_source_operands_observations_v39(observations, little_endian)
            =~= invocation_source_observe_effects_v39(effects, head.before, head.after));
    }
}

proof fn aggregate_or_descriptor_exact_evaluation_has_no_external_effect_v68(
    head: InvocationSourceOperandObservationV36, little_endian: bool,
)
    requires
        matches!(head.operand, InvocationSourceOperandV36::Aggregate { .. }
            | InvocationSourceOperandV36::Descriptor { .. }),
        head.before.machine.valid, head.after.machine.valid,
        invocation_source_value_evaluate_v42(head.before, head.operand,
            head.root, head.instance, little_endian).source == head.after,
        invocation_source_value_evaluate_v42(head.before, head.operand,
            head.root, head.instance, little_endian).value == head.value,
    ensures
        invocation_source_operands_effects_v36(seq![head], little_endian) == seq![],
        invocation_source_operands_observations_v39(seq![head], little_endian) == seq![],
{
    hide(invocation_source_value_evaluate_v42);
    aggregate_or_descriptor_singleton_effects_v77(head, little_endian, seq![]);
    assert(invocation_source_observe_effects_v39(seq![], head.before, head.after) =~= seq![]);
}

proof fn aggregate_or_descriptor_changed_state_is_refused_v68(
    head: InvocationSourceOperandObservationV36, little_endian: bool,
)
    requires
        matches!(head.operand, InvocationSourceOperandV36::Aggregate { .. }
            | InvocationSourceOperandV36::Descriptor { .. }),
        invocation_source_value_evaluate_v42(head.before, head.operand,
            head.root, head.instance, little_endian).source != head.after,
    ensures
        invocation_source_operands_effects_v36(seq![head], little_endian)
            == seq![MemoryOperationEffectV30::Refused],
        invocation_source_operands_observations_v39(seq![head], little_endian)
            == invocation_source_observe_effects_v39(seq![MemoryOperationEffectV30::Refused],
                head.before, head.after),
{
    hide(invocation_source_value_evaluate_v42);
    aggregate_or_descriptor_singleton_effects_v77(head, little_endian,
        seq![MemoryOperationEffectV30::Refused]);
}

proof fn aggregate_or_descriptor_changed_value_is_refused_v68(
    head: InvocationSourceOperandObservationV36, little_endian: bool,
)
    requires
        matches!(head.operand, InvocationSourceOperandV36::Aggregate { .. }
            | InvocationSourceOperandV36::Descriptor { .. }),
        invocation_source_value_evaluate_v42(head.before, head.operand,
            head.root, head.instance, little_endian).value != head.value,
    ensures
        invocation_source_operands_effects_v36(seq![head], little_endian)
            == seq![MemoryOperationEffectV30::Refused],
        invocation_source_operands_observations_v39(seq![head], little_endian)
            == invocation_source_observe_effects_v39(seq![MemoryOperationEffectV30::Refused],
                head.before, head.after),
{
    hide(invocation_source_value_evaluate_v42);
    aggregate_or_descriptor_singleton_effects_v77(head, little_endian,
        seq![MemoryOperationEffectV30::Refused]);
}

proof fn aggregate_or_descriptor_invalid_observation_is_refused_v68(
    head: InvocationSourceOperandObservationV36, little_endian: bool,
)
    requires
        matches!(head.operand, InvocationSourceOperandV36::Aggregate { .. }
            | InvocationSourceOperandV36::Descriptor { .. }),
        !head.before.machine.valid || !head.after.machine.valid,
    ensures
        invocation_source_operands_effects_v36(seq![head], little_endian)
            == seq![MemoryOperationEffectV30::Refused],
        invocation_source_operands_observations_v39(seq![head], little_endian)
            == invocation_source_observe_effects_v39(seq![MemoryOperationEffectV30::Refused],
                head.before, head.after),
{
    hide(invocation_source_value_evaluate_v42);
    aggregate_or_descriptor_singleton_effects_v77(head, little_endian,
        seq![MemoryOperationEffectV30::Refused]);
}

proof fn descriptor_operand_mutable_copy_is_refused_v68(
    head: InvocationSourceOperandObservationV36, local: int,
    recipe: InvocationSourceDescriptorRecipeV51, little_endian: bool,
)
    requires
        recipe.mutable,
        head.operand == (InvocationSourceOperandV36::Descriptor { local, recipe, moved: false }),
    ensures
        invocation_source_operands_effects_v36(seq![head], little_endian)
            == seq![MemoryOperationEffectV30::Refused],
        invocation_source_operands_observations_v39(seq![head], little_endian)
            == invocation_source_observe_effects_v39(seq![MemoryOperationEffectV30::Refused],
                head.before, head.after),
{
    hide(invocation_source_descriptor_snapshot_v53);
    hide(invocation_source_descriptor_snapshot_current_v53);
    hide(invocation_source_aggregate_place_evaluate_v42);
    hide(invocation_source_enum_evaluate_v50);
    hide(invocation_source_operand_evaluate_v36);
    if !head.before.machine.valid || !head.after.machine.valid {
        aggregate_or_descriptor_invalid_observation_is_refused_v68(head, little_endian);
    } else {
        reveal(invocation_source_value_evaluate_v42);
        reveal(invocation_source_descriptor_evaluate_v53);
        reveal(invocation_source_byte_refused_v36);
        reveal(invocation_source_refused_v36);
        assert(!invocation_source_value_evaluate_v42(head.before, head.operand,
            head.root, head.instance, little_endian).source.machine.valid);
        aggregate_or_descriptor_changed_state_is_refused_v68(head, little_endian);
    }
}
