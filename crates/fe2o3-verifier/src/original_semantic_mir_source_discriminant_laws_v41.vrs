// Qualification obligations, never assumed by source admission. Unexecuted.
proof fn source_discriminant_invalid_source_refuses_v41(
    source: InvocationSourceByteStateV36, read: InvocationSourceDiscriminantReadV41,
    root: int, instance: int, little_endian: bool,
)
    requires !source.machine.valid,
    ensures !invocation_source_discriminant_read_v41(source, read, root, instance, little_endian).source.machine.valid,
{}

proof fn source_discriminant_foreign_registry_refuses_v41(
    source: InvocationSourceByteStateV36, read: InvocationSourceDiscriminantReadV41,
    root: int, instance: int, little_endian: bool,
)
    requires source.machine.memory.view_contracts != invocation_source_view_contracts_0_v39(little_endian),
    ensures invocation_source_discriminant_read_v41(source, read, root, instance, little_endian).effect
        == MemoryOperationEffectV30::Refused,
{}

proof fn source_discriminant_dead_object_refuses_v41(
    source: InvocationSourceByteStateV36, read: InvocationSourceDiscriminantReadV41,
    root: int, instance: int, little_endian: bool,
)
    requires invocation_source_byte_address_v36(source, read.access, root, instance).is_none(),
    ensures !invocation_source_discriminant_read_v41(source, read, root, instance, little_endian).source.machine.valid,
{}

proof fn source_discriminant_success_never_changes_heap_v41(
    source: InvocationSourceByteStateV36, read: InvocationSourceDiscriminantReadV41,
    root: int, instance: int, little_endian: bool,
)
    requires invocation_source_discriminant_read_v41(source, read, root, instance, little_endian).source.machine.valid,
    ensures invocation_source_discriminant_read_v41(source, read, root, instance, little_endian).source.machine.memory
        == source.machine.memory,
{}

proof fn discriminant_private_tag_read_is_retained_v41(
    pointer: MemoryPointerV30, width: int, alignment: int, observation: MemoryTagObservationV39,
)
    ensures invocation_project_effect_v39(MemoryOperationEffectV30::TagRead {
        address: MemoryValueV30::Pointer(pointer), width, alignment,
        purpose: MemoryTagReadPurposeV39::DiscriminantRead, observation: Some(observation) })
        == Some(MemoryOperationEffectV30::TagRead {
            address: MemoryValueV30::Pointer(pointer), width, alignment,
            purpose: MemoryTagReadPurposeV39::DiscriminantRead, observation: Some(observation) }),
{}

proof fn variant_validation_cannot_hide_without_original_counterpart_v41(
    address: MemoryValueV30, width: int, alignment: int, observation: Option<MemoryTagObservationV39>,
)
    ensures invocation_project_effect_v39(MemoryOperationEffectV30::TagRead {
        address, width, alignment, purpose: MemoryTagReadPurposeV39::VariantValidation, observation })
        == Some(MemoryOperationEffectV30::Refused),
{}
