// Logical source enum state has no storage layout or target allocation identity.
// The tag remains defined when one payload field is moved or deinitialized.
enum InvocationSourceEnumFieldTypeV47 {
    Scalar { bits: int },
    Reference { referent_bits: int, referent_width: int,
        referent_alignment: int, mutable: bool },
}

struct InvocationSourceEnumV47 {
    source_type: int,
    variant: int,
    fields: Map<int, MemoryValueV30>,
}

open spec fn invocation_source_enums_name_allocation_v49(
    logical: InvocationSourceLogicalV38, allocation: MemoryAllocationV30,
) -> bool {
    exists|local: int, field: int| logical.enums.contains_key(local)
        && logical.enums[local].fields.contains_key(field)
        && invocation_value_names_allocation_v36(logical.enums[local].fields[field], allocation)
}

proof fn invocation_source_enum_reference_blocks_lifetime_end_v49(
    source: InvocationSourceByteStateV36, descriptor: int, slot: InvocationSourceSlotV36,
    dying: int, root: int, instance: int, retained: int, field: int, pointer: MemoryPointerV30,
)
    requires
        invocation_source_byte_slot_v36(source, descriptor, slot, root, instance) == Some(pointer),
        dying != retained,
        invocation_source_byte_put_local_v36(source, dying, MemoryValueV30::Undefined).machine.valid,
        source.logical.enums.contains_key(retained),
        source.logical.enums[retained].fields.contains_key(field),
        source.logical.enums[retained].fields[field] == MemoryValueV30::Pointer(pointer),
    ensures
        !invocation_source_byte_end_v36(source, descriptor, slot, dying, root, instance).machine.valid,
{
    let cleared = invocation_source_byte_put_local_v36(source, dying, MemoryValueV30::Undefined);
    assert(cleared.logical.enums.contains_key(retained));
    assert(cleared.logical.enums[retained].fields[field] == MemoryValueV30::Pointer(pointer));
    assert(invocation_source_enums_name_allocation_v49(cleared.logical, pointer.allocation));
}

proof fn invocation_source_enum_clear_drops_only_its_own_provenance_v49(
    logical: InvocationSourceLogicalV38, dying: int, allocation: MemoryAllocationV30,
)
    requires
        0 <= dying < logical.versions.len(),
        forall|local: int, field: int| local != dying && logical.enums.contains_key(local)
            && logical.enums[local].fields.contains_key(field) ==>
            !invocation_value_names_allocation_v36(logical.enums[local].fields[field], allocation),
    ensures
        !invocation_source_enums_name_allocation_v49(
            invocation_source_logical_write_v38(logical, dying), allocation),
{
    let cleared = invocation_source_logical_write_v38(logical, dying);
    assert forall|local: int, field: int| cleared.enums.contains_key(local)
        && cleared.enums[local].fields.contains_key(field) implies
        !invocation_value_names_allocation_v36(cleared.enums[local].fields[field], allocation) by {
        assert(local != dying);
    }
}

enum InvocationSourceLogicalEnumEventV47 {
    Construct { destination: int, source_type: int, variant: int,
        fields: Seq<InvocationSourceEnumPayloadV43> },
    Transfer { destination: int, input: int, source_type: int, moved: bool },
    Extract { destination: int, input: int, source_type: int,
        variant: int, field: int, moved: bool },
    Discriminant { destination: int, input: int, source_type: int, bits: int },
    FieldDeinitialize { input: int, source_type: int, variant: int, field: int },
    Reset { local: int },
}

open spec fn invocation_source_enum_value_typed_v47(
    ty: InvocationSourceEnumFieldTypeV47, value: MemoryValueV30,
) -> bool {
    match ty {
        InvocationSourceEnumFieldTypeV47::Scalar { bits } =>
            invocation_source_byte_value_typed_v36(value, bits),
        InvocationSourceEnumFieldTypeV47::Reference { .. } =>
            matches!(value, MemoryValueV30::Pointer(_)),
    }
}

open spec fn invocation_source_enum_well_formed_v47(value: InvocationSourceEnumV47) -> bool {
    value.fields.dom().finite()
        && match invocation_source_enum_field_count_v47(value.source_type, value.variant) {
            Some(count) => count >= 0
                && (forall|field: int| value.fields.contains_key(field) ==>
                    0 <= field < count
                        && match invocation_source_enum_field_type_v47(
                            value.source_type, value.variant, field) {
                            Some(ty) => invocation_source_enum_value_typed_v47(ty, value.fields[field]),
                            None => false,
                        }),
            None => false,
        }
}

open spec fn invocation_source_enum_complete_v47(value: InvocationSourceEnumV47) -> bool {
    invocation_source_enum_well_formed_v47(value)
        && match invocation_source_enum_field_count_v47(value.source_type, value.variant) {
            Some(count) => forall|field: int| 0 <= field < count ==> value.fields.contains_key(field),
            None => false,
        }
}

open spec fn invocation_source_enum_field_current_v47(
    source: InvocationSourceByteStateV36, ty: InvocationSourceEnumFieldTypeV47,
    value: MemoryValueV30, little_endian: bool,
) -> bool {
    invocation_source_enum_value_typed_v47(ty, value)
        && match ty {
            InvocationSourceEnumFieldTypeV47::Scalar { .. } => true,
            InvocationSourceEnumFieldTypeV47::Reference {
                referent_bits, referent_width, referent_alignment, ..
            } => invocation_source_enum_reference_valid_v44(source, value,
                referent_width, referent_alignment, referent_bits, little_endian),
        }
}

open spec fn invocation_source_enum_field_copyable_v47(ty: InvocationSourceEnumFieldTypeV47) -> bool {
    match ty {
        InvocationSourceEnumFieldTypeV47::Scalar { .. } => true,
        InvocationSourceEnumFieldTypeV47::Reference { mutable, .. } => !mutable,
    }
}

open spec fn invocation_source_enum_type_copyable_v47(source_type: int) -> bool {
    forall|variant: int, field: int|
        match invocation_source_enum_field_count_v47(source_type, variant) {
            Some(count) => 0 <= field < count ==>
                match invocation_source_enum_field_type_v47(source_type, variant, field) {
                    Some(ty) => invocation_source_enum_field_copyable_v47(ty),
                    None => false,
                },
            None => true,
        }
}

open spec fn invocation_source_enum_local_v47(
    source: InvocationSourceByteStateV36, local: int, source_type: int,
) -> Option<InvocationSourceEnumV47> {
    if source.machine.valid && invocation_source_byte_state_well_formed_v36(source)
        && 0 <= local < source.machine.values.len()
        && !source.objects.contains_key(local)
        && source.logical.enums.contains_key(local)
        && source.logical.enums[local].source_type == source_type
        && invocation_source_enum_well_formed_v47(source.logical.enums[local]) {
        Some(source.logical.enums[local])
    } else { None }
}

open spec fn invocation_source_enum_snapshot_current_v50(
    source: InvocationSourceByteStateV36, value: InvocationSourceEnumV47, little_endian: bool,
) -> bool {
    source.machine.valid && invocation_source_byte_state_well_formed_v36(source)
        && invocation_source_enum_complete_v47(value)
        && (forall|field: int| value.fields.contains_key(field) ==>
            match invocation_source_enum_field_type_v47(value.source_type, value.variant, field) {
                Some(ty) => invocation_source_enum_field_current_v47(
                    source, ty, value.fields[field], little_endian),
                None => false,
            })
}

open spec fn invocation_source_enum_snapshot_v50(
    source: InvocationSourceByteStateV36, local: int, source_type: int, little_endian: bool,
) -> Option<InvocationSourceEnumV47> {
    match invocation_source_enum_local_v47(source, local, source_type) {
        Some(value) => if invocation_source_enum_snapshot_current_v50(source, value, little_endian) {
            Some(value)
        } else { None },
        None => None,
    }
}

open spec fn invocation_source_enum_evaluate_v50(
    source: InvocationSourceByteStateV36, local: int, source_type: int,
    moved: bool, little_endian: bool,
) -> InvocationSourceValueEvaluationV42 {
    match invocation_source_enum_snapshot_v50(source, local, source_type, little_endian) {
        Some(value) => {
            if !moved && !invocation_source_enum_type_copyable_v47(source_type) {
                InvocationSourceValueEvaluationV42 { source: invocation_source_byte_refused_v36(source),
                    value: InvocationSourceValueV42::Carrier(MemoryValueV30::Undefined) }
            } else {
                // The original snapshot survives consuming the caller local.
                InvocationSourceValueEvaluationV42 {
                    source: if moved {
                        invocation_source_byte_put_local_v36(source, local, MemoryValueV30::Undefined)
                    } else { source },
                    value: InvocationSourceValueV42::Enum(value),
                }
            }
        },
        None => InvocationSourceValueEvaluationV42 { source: invocation_source_byte_refused_v36(source),
            value: InvocationSourceValueV42::Carrier(MemoryValueV30::Undefined) },
    }
}

proof fn invocation_source_enum_argument_move_preserves_original_snapshot_v50(
    source: InvocationSourceByteStateV36, local: int, source_type: int,
    value: InvocationSourceEnumV47, little_endian: bool,
)
    requires
        invocation_source_enum_snapshot_v50(source, local, source_type, little_endian) == Some(value),
    ensures
        invocation_source_enum_evaluate_v50(source, local, source_type, true, little_endian).value
            == InvocationSourceValueV42::Enum(value),
        invocation_source_enum_evaluate_v50(source, local, source_type, true, little_endian).source
            == invocation_source_byte_put_local_v36(source, local, MemoryValueV30::Undefined),
{}

proof fn invocation_source_enum_argument_copy_requires_whole_nominal_copyability_v50(
    source: InvocationSourceByteStateV36, local: int, source_type: int,
    value: InvocationSourceEnumV47, little_endian: bool,
)
    requires
        invocation_source_enum_snapshot_v50(source, local, source_type, little_endian) == Some(value),
        !invocation_source_enum_type_copyable_v47(source_type),
    ensures
        !invocation_source_enum_evaluate_v50(source, local, source_type, false, little_endian).source.machine.valid,
{}

proof fn invocation_source_enum_incomplete_payload_cannot_be_an_argument_v50(
    source: InvocationSourceByteStateV36, local: int, source_type: int,
    value: InvocationSourceEnumV47, little_endian: bool,
)
    requires
        invocation_source_enum_local_v47(source, local, source_type) == Some(value),
        !invocation_source_enum_complete_v47(value),
    ensures
        invocation_source_enum_snapshot_v50(source, local, source_type, little_endian).is_none(),
{}

open spec fn invocation_source_enum_install_v47(
    source: InvocationSourceByteStateV36, local: int, value: InvocationSourceEnumV47,
) -> InvocationSourceByteStateV36 {
    if !source.machine.valid || !invocation_source_byte_state_well_formed_v36(source)
        || local < 0 || source.machine.values.len() <= local
        || source.objects.contains_key(local)
        || !invocation_source_enum_well_formed_v47(value) {
        invocation_source_byte_refused_v36(source)
    } else {
        let cleared = invocation_source_byte_put_local_v36(source, local, MemoryValueV30::Undefined);
        if !cleared.machine.valid { cleared }
        else { InvocationSourceByteStateV36 { logical: InvocationSourceLogicalV38 {
            enums: cleared.logical.enums.insert(local, value), ..cleared.logical }, ..cleared } }
    }
}

open spec fn invocation_source_enum_field_remove_v47(
    source: InvocationSourceByteStateV36, local: int, source_type: int, variant: int, field: int,
) -> InvocationSourceByteStateV36 {
    match invocation_source_enum_local_v47(source, local, source_type) {
        Some(value) => {
            if value.variant != variant
                || invocation_source_enum_field_type_v47(source_type, variant, field).is_none() {
                invocation_source_byte_refused_v36(source)
            } else {
                invocation_source_enum_install_v47(source, local,
                    InvocationSourceEnumV47 { fields: value.fields.remove(field), ..value })
            }
        },
        None => invocation_source_byte_refused_v36(source),
    }
}

open spec fn invocation_source_enum_transfer_v47(
    source: InvocationSourceByteStateV36, destination: int, input: int,
    source_type: int, moved: bool, little_endian: bool,
) -> InvocationSourceByteStateV36 {
    match invocation_source_enum_local_v47(source, input, source_type) {
        Some(value) => {
            if !invocation_source_enum_complete_v47(value)
                || (!moved && !invocation_source_enum_type_copyable_v47(source_type))
                || !(forall|field: int| value.fields.contains_key(field) ==>
                    match invocation_source_enum_field_type_v47(source_type, value.variant, field) {
                        Some(ty) => invocation_source_enum_field_current_v47(
                            source, ty, value.fields[field], little_endian)
                            && (moved || invocation_source_enum_field_copyable_v47(ty)),
                        None => false,
                    }) {
                invocation_source_byte_refused_v36(source)
            } else {
                // Snapshot the complete original value before consuming input,
                // including a self-move. No target tag or payload supplies data.
                let consumed = if moved {
                    invocation_source_byte_put_local_v36(source, input, MemoryValueV30::Undefined)
                } else { source };
                invocation_source_enum_install_v47(consumed, destination, value)
            }
        },
        None => invocation_source_byte_refused_v36(source),
    }
}

open spec fn invocation_source_logical_enum_step_v47(
    source: InvocationSourceByteStateV36, event: InvocationSourceLogicalEnumEventV47,
    root: int, instance: int, little_endian: bool,
) -> InvocationSourceEnumResultV43 {
    match event {
        InvocationSourceLogicalEnumEventV47::Construct { destination, source_type, variant, fields } =>
            invocation_source_enum_construct_v47(source, destination, source_type, variant,
                fields, root, instance, little_endian),
        _ => {
            let after = match event {
                InvocationSourceLogicalEnumEventV47::Transfer { destination, input, source_type, moved } =>
                    invocation_source_enum_transfer_v47(source, destination, input, source_type, moved, little_endian),
                InvocationSourceLogicalEnumEventV47::Extract { destination, input, source_type, variant, field, moved } =>
                    invocation_source_enum_extract_v47(source, destination, input, source_type, variant, field, moved, little_endian),
                InvocationSourceLogicalEnumEventV47::Discriminant { destination, input, source_type, bits } =>
                    invocation_source_enum_discriminant_read_v47(source, destination, input, source_type, bits),
                InvocationSourceLogicalEnumEventV47::FieldDeinitialize { input, source_type, variant, field } =>
                    invocation_source_enum_field_remove_v47(source, input, source_type, variant, field),
                InvocationSourceLogicalEnumEventV47::Reset { local } =>
                    invocation_source_byte_put_local_v36(source, local, MemoryValueV30::Undefined),
                InvocationSourceLogicalEnumEventV47::Construct { .. } =>
                    invocation_source_byte_refused_v36(source),
            };
            InvocationSourceEnumResultV43 { source: after,
                observations: if after.machine.valid { seq![] }
                    else { invocation_source_observe_effects_v39(seq![MemoryOperationEffectV30::Refused], source, after) } }
        },
    }
}

open spec fn invocation_source_enum_extract_v47(
    source: InvocationSourceByteStateV36, destination: int, input: int,
    source_type: int, variant: int, field: int, moved: bool, little_endian: bool,
) -> InvocationSourceByteStateV36 {
    match (invocation_source_enum_local_v47(source, input, source_type),
        invocation_source_enum_field_type_v47(source_type, variant, field)) {
        (Some(value), Some(ty)) => {
            if destination == input || value.variant != variant || !value.fields.contains_key(field)
                || !invocation_source_enum_field_current_v47(source, ty, value.fields[field], little_endian)
                || !(moved || invocation_source_enum_field_copyable_v47(ty)) {
                invocation_source_byte_refused_v36(source)
            } else {
                let snapshot = value.fields[field];
                let consumed = if moved {
                    invocation_source_enum_field_remove_v47(source, input, source_type, variant, field)
                } else { source };
                invocation_source_byte_put_local_v36(consumed, destination, snapshot)
            }
        },
        _ => invocation_source_byte_refused_v36(source),
    }
}

open spec fn invocation_source_enum_discriminant_read_v47(
    source: InvocationSourceByteStateV36, destination: int, input: int, source_type: int, bits: int,
) -> InvocationSourceByteStateV36 {
    match invocation_source_enum_local_v47(source, input, source_type) {
        Some(value) => match invocation_source_enum_discriminant_v47(source_type, value.variant) {
            Some(discriminant) => {
                let scalar = MemoryValueV30::Scalar(discriminant);
                if !invocation_source_byte_value_typed_v36(scalar, bits) {
                    invocation_source_byte_refused_v36(source)
                } else { invocation_source_byte_put_local_v36(source, destination, scalar) }
            },
            None => invocation_source_byte_refused_v36(source),
        },
        None => invocation_source_byte_refused_v36(source),
    }
}

open spec fn invocation_source_enum_payload_recipe_v47(
    ty: InvocationSourceEnumFieldTypeV47, field: InvocationSourceEnumPayloadV43,
) -> bool {
    match (ty, field.value) {
        (InvocationSourceEnumFieldTypeV47::Scalar { bits },
            InvocationSourceEnumValueV44::Scalar { bits: observed, .. }) => bits == observed,
        (InvocationSourceEnumFieldTypeV47::Reference { referent_bits, referent_width,
            referent_alignment, mutable }, InvocationSourceEnumValueV44::Reference {
            referent_bits: observed_bits, referent_width: observed_width,
            referent_alignment: observed_alignment, mutable: observed_mutable, .. }) =>
                referent_bits == observed_bits && referent_width == observed_width
                    && referent_alignment == observed_alignment && mutable == observed_mutable,
        _ => false,
    }
}

open spec fn invocation_source_enum_construct_v47(
    source: InvocationSourceByteStateV36, destination: int, source_type: int, variant: int,
    fields: Seq<InvocationSourceEnumPayloadV43>, root: int, instance: int, little_endian: bool,
) -> InvocationSourceEnumResultV43 {
    if !source.machine.valid || !invocation_source_byte_state_well_formed_v36(source)
        || invocation_source_enum_field_count_v47(source_type, variant) != Some(fields.len() as int)
        || !(forall|field: int| 0 <= field < fields.len() ==>
            match invocation_source_enum_field_type_v47(source_type, variant, field) {
                Some(ty) => invocation_source_enum_payload_recipe_v47(ty, fields[field]),
                None => false,
            }) {
        invocation_source_enum_refused_v43(source, seq![])
    } else {
        let evaluated = invocation_source_enum_operands_v43(source, fields, root, instance, little_endian);
        if !evaluated.source.machine.valid || evaluated.values.len() != fields.len()
            || !(forall|field: int| 0 <= field < fields.len() ==>
                match invocation_source_enum_field_type_v47(source_type, variant, field) {
                    Some(ty) => invocation_source_enum_field_current_v47(
                        evaluated.source, ty, evaluated.values[field], little_endian),
                    None => false,
                }) {
            invocation_source_enum_refused_v43(evaluated.source, evaluated.observations)
        } else {
            let value = InvocationSourceEnumV47 { source_type, variant,
                fields: Map::new(|field: int| 0 <= field < evaluated.values.len(),
                    |field: int| evaluated.values[field]) };
            let installed = invocation_source_enum_install_v47(evaluated.source, destination, value);
            if !installed.machine.valid {
                invocation_source_enum_refused_v43(installed, evaluated.observations)
            } else { InvocationSourceEnumResultV43 {
                source: installed, observations: evaluated.observations } }
        }
    }
}
