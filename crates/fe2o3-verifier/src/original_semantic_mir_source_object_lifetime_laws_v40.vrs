// Qualification obligations, not admitted axioms or executed proofs.
// The request generator supplies the exact owner-backed binding predicate.

proof fn original_object_forged_binding_refuses_v40(
    source: InvocationSourceByteStateV36, descriptor: int, slot: InvocationSourceSlotV36,
    local: int, activation: int, root: int, instance: int,
)
    requires !invocation_source_object_binding_v40(local,
        InvocationSourceObjectV40 { descriptor, slot, activation }),
    ensures !invocation_source_object_activate_v40(
        source, descriptor, slot, local, activation, root, instance).machine.valid,
{ }

proof fn original_object_end_removes_logical_and_dynamic_identity_v40(
    source: InvocationSourceByteStateV36, local: int, root: int, instance: int,
)
    requires source.machine.valid, invocation_source_byte_state_well_formed_v36(source),
        source.objects.contains_key(local),
        invocation_source_object_end_v40(source, local, root, instance).machine.valid,
    ensures ({
        let object = source.objects[local];
        let ended = invocation_source_object_end_v40(source, local, root, instance);
        !ended.objects.contains_key(local) && !ended.slots.contains_key(object.descriptor)
            && !ended.machine.memory.live.contains_key(source.slots[object.descriptor].allocation)
    }),
{ }

proof fn original_object_restart_never_resurrects_old_allocation_v40(
    source: InvocationSourceByteStateV36, descriptor: int, slot: InvocationSourceSlotV36,
    local: int, activation: int, root: int, instance: int,
)
    requires source.machine.valid, invocation_source_byte_state_well_formed_v36(source),
        source.objects.contains_key(local),
        invocation_source_object_activate_v40(
            source, descriptor, slot, local, activation, root, instance).machine.valid,
    ensures ({
        let old = source.slots[source.objects[local].descriptor];
        let active = invocation_source_object_activate_v40(
            source, descriptor, slot, local, activation, root, instance);
        active.objects.contains_key(local) && active.objects[local].activation == activation
            && active.slots[descriptor].allocation != old.allocation
            && !active.machine.memory.live.contains_key(old.allocation)
    }),
{ }

proof fn original_object_missing_binding_cannot_form_even_zero_width_address_v40(
    source: InvocationSourceByteStateV36, local: int, offset: int,
    root: int, instance: int,
)
    requires !source.objects.contains_key(local),
    ensures invocation_source_byte_address_v36(source, InvocationSourceByteAccessV36 {
        base: InvocationSourceByteBaseV36::ObjectLocal(local),
        offset, width: 0, alignment: 1,
    }, root, instance).is_none(),
{ }

proof fn original_object_restart_retains_escape_refusal_v40(
    source: InvocationSourceByteStateV36, descriptor: int, slot: InvocationSourceSlotV36,
    local: int, activation: int, root: int, instance: int,
)
    requires source.machine.valid, invocation_source_byte_state_well_formed_v36(source),
        source.objects.contains_key(local),
        invocation_memory_names_allocation_v37(source.machine.memory,
            source.slots[source.objects[local].descriptor].allocation),
    ensures !invocation_source_object_activate_v40(
        source, descriptor, slot, local, activation, root, instance).machine.valid,
{ }
