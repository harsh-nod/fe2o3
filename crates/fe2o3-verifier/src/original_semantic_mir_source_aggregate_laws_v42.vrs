// Required generated-source obligations, not a claim of executed verification.
proof fn invocation_source_aggregate_missing_leaf_refuses_v42(
    source: InvocationSourceByteStateV36, local: int, ty: int, path: Seq<int>, moved: bool,
)
    requires !source.logical.aggregates.contains_key(local)
        || !source.logical.aggregates[local].leaves.contains_key(path),
    ensures !invocation_source_aggregate_leaf_evaluate_v42(source, local, ty, path, moved).source.machine.valid,
        invocation_source_aggregate_leaf_evaluate_v42(source, local, ty, path, moved).value.is_none(),
{}

proof fn invocation_source_aggregate_snapshot_requires_complete_v42(
    source: InvocationSourceByteStateV36, local: int, ty: int, path: Seq<int>, result_type: int,
)
    ensures match invocation_source_aggregate_snapshot_v42(source, local, ty, path, result_type) {
        Some(value) => value.source_type == result_type && invocation_source_aggregate_complete_v42(value),
        None => true,
    },
{}

proof fn invocation_source_aggregate_partial_move_keeps_sibling_v42(
    source: InvocationSourceByteStateV36, local: int, ty: int, prefix: Seq<int>, sibling: Seq<int>,
)
    requires source.logical.aggregates.contains_key(local),
        source.logical.aggregates[local].leaves.contains_key(sibling),
        !invocation_source_path_prefix_v42(prefix, sibling),
        invocation_source_aggregate_remove_v42(source, local, ty, prefix).machine.valid,
    ensures invocation_source_aggregate_remove_v42(source, local, ty, prefix).logical.aggregates.contains_key(local),
        invocation_source_aggregate_remove_v42(source, local, ty, prefix).logical.aggregates[local].leaves.contains_key(sibling),
        invocation_source_aggregate_remove_v42(source, local, ty, prefix).logical.aggregates[local].leaves[sibling]
            == source.logical.aggregates[local].leaves[sibling],
{}

proof fn invocation_source_aggregate_second_move_refuses_v42(
    source: InvocationSourceByteStateV36, local: int, ty: int, path: Seq<int>,
)
    ensures !invocation_source_aggregate_leaf_evaluate_v42(
        invocation_source_aggregate_remove_v42(source, local, ty, path), local, ty, path, true).source.machine.valid,
{}

proof fn invocation_source_aggregate_whole_move_consumes_v42(
    source: InvocationSourceByteStateV36, local: int, ty: int,
)
    requires invocation_source_aggregate_remove_v42(source, local, ty, seq![]).machine.valid,
    ensures invocation_source_aggregate_remove_v42(source, local, ty, seq![]).logical.aggregates[local].leaves.dom().is_empty(),
{
    assert forall|path: Seq<int>| !invocation_source_aggregate_remove_v42(source, local, ty, seq![]).logical.aggregates[local].leaves.contains_key(path) by {};
}

proof fn invocation_source_aggregate_partial_replace_keeps_sibling_v42(
    source: InvocationSourceByteStateV36, local: int, ty: int, prefix: Seq<int>,
    sibling: Seq<int>, value: InvocationSourceAggregateV42,
)
    requires source.logical.aggregates.contains_key(local),
        source.logical.aggregates[local].leaves.contains_key(sibling),
        !invocation_source_path_prefix_v42(prefix, sibling),
        invocation_source_aggregate_replace_v42(source, local, ty, prefix, value).machine.valid,
    ensures invocation_source_aggregate_replace_v42(source, local, ty, prefix, value).logical.aggregates[local].leaves.contains_key(sibling),
        invocation_source_aggregate_replace_v42(source, local, ty, prefix, value).logical.aggregates[local].leaves[sibling]
            == source.logical.aggregates[local].leaves[sibling],
{}

proof fn invocation_source_aggregate_zero_sized_leaf_is_not_vacuous_v42(ty: int)
    requires invocation_source_aggregate_leaf_count_v42(ty) == 1,
        invocation_source_aggregate_leaf_path_v42(ty, 0) == seq![],
        invocation_source_aggregate_leaf_bits_v42(ty, 0) == 0,
    ensures !invocation_source_aggregate_complete_v42(InvocationSourceAggregateV42 {
        source_type: ty, leaves: Map::empty() }),
{}

proof fn invocation_source_aggregate_frame_clear_removes_aggregate_v42(
    logical: InvocationSourceLogicalV38, first: int, end: int, local: int,
)
    requires first <= local < end,
    ensures !invocation_source_logical_clear_v38(logical, first, end).aggregates.contains_key(local),
{}
