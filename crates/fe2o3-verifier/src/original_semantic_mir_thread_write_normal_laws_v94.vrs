// Scalar-local write normalization; all caller shape and validity facts remain obligations.

proof fn invocation_thread_write_put_local_pc_v94(
    source: InvocationSourceByteStateV36, local: int, value: MemoryValueV30,
)
    ensures invocation_source_byte_put_local_v36(source, local, value).machine.pc
        == source.machine.pc,
{
    hide(invocation_source_byte_state_well_formed_v36);
    hide(invocation_source_logical_write_v38);
}

// Closed scalar-local operand normalization; callers prove the structural premises.
#[verifier::spinoff_prover]
proof fn invocation_thread_write_local_normal_frame_v93(
    source: InvocationSourceByteStateV36, write: InvocationSourceThreadWriteV88,
    local: int, bits: int, root: int, instance: int, little_endian: bool,
)
    requires
        write.value == (InvocationSourceOperandV36::Scalar {
            value: InvocationSourceByteValueV36::Local { local, moved: false }, bits }),
        0 <= local < source.machine.values.len(),
        local != write.input, local != write.index,
        ordinary_memory_width_v30(write.recipe.width),
        bits == 1 && write.recipe.width == 1 || bits == 8 * write.recipe.width,
    ensures ({
        let after = invocation_source_thread_write_v88(source, write, root, instance,
            little_endian).source;
        after.machine.pc == source.machine.pc
            && after.machine.values.len() == source.machine.values.len()
            && after.machine.frames == source.machine.frames
            && after.machine.generations == source.machine.generations
            && after.machine.memory.live.dom() == source.machine.memory.live.dom()
            && after.machine.memory.view_contracts == source.machine.memory.view_contracts
    }),
{
    hide(invocation_source_thread_write_v88);
    hide(invocation_source_byte_state_well_formed_v36);
    hide(invocation_source_logical_write_v38);
    hide(invocation_source_descriptor_reference_current_v51);
    hide(invocation_source_witness_current_v38);
    hide(invocation_source_store_v36);
    hide(byte_store_v30);
    hide(byte_memory_well_formed_v30);
    hide(invocation_source_byte_put_local_v36);
    hide(invocation_source_byte_evaluate_v36);
    hide(invocation_source_byte_value_typed_v36);
    hide(invocation_source_store_enabled_v36);
    let result = invocation_source_thread_write_v88(source, write, root, instance,
        little_endian).source;
    if !write.recipe.mutable || !write.moved_receiver
        || !invocation_source_descriptor_reference_current_v51(source, write.input, write.recipe) {
        assert(result == invocation_source_byte_refused_v36(source)) by {
            reveal(invocation_source_thread_write_v88);
        }
        return;
    }
    invocation_source_put_local_preserves_heap_v78(source, write.input, MemoryValueV30::Undefined);
    invocation_thread_write_put_local_pc_v94(source, write.input, MemoryValueV30::Undefined);
    let receiver = invocation_source_byte_put_local_v36(source, write.input, MemoryValueV30::Undefined);
    if !invocation_source_witness_current_v38(receiver, write.index, write.witness_type) {
        assert(result == invocation_source_byte_refused_v36(receiver)) by {
            reveal(invocation_source_thread_write_v88);
        }
        return;
    }
    invocation_source_put_local_preserves_heap_v78(receiver, write.index, MemoryValueV30::Undefined);
    invocation_thread_write_put_local_pc_v94(receiver, write.index, MemoryValueV30::Undefined);
    let consumed = if write.moved_index {
        invocation_source_byte_put_local_v36(receiver, write.index, MemoryValueV30::Undefined)
    } else { receiver };
    let evaluated = invocation_source_byte_evaluate_v36(consumed,
        InvocationSourceByteValueV36::Local { local, moved: false }, bits,
        root, instance, little_endian);
    invocation_source_local_evaluate_preserves_heap_v78(consumed, local, false, bits,
        root, instance, little_endian);
    assert(evaluated.source.machine.pc == consumed.machine.pc) by {
        reveal(invocation_source_byte_evaluate_v36);
    }
    if !evaluated.source.machine.valid
        || !invocation_source_byte_value_typed_v36(evaluated.value, bits) {
        assert(result == invocation_source_byte_refused_v36(evaluated.source)) by {
            reveal(invocation_source_thread_write_v88);
        }
        return;
    }
    match (source.machine.values[write.input], receiver.machine.values[write.index]) {
        (MemoryValueV30::Slice(slice), MemoryValueV30::Scalar(index)) => {
            if index < 0 || index >= memory_value_modulus_v30(write.recipe.metadata_bits / 8) {
                assert(result == invocation_source_byte_refused_v36(evaluated.source)) by {
                    reveal(invocation_source_thread_write_v88);
                }
                return;
            }
            if index >= slice.length {
                invocation_source_put_local_preserves_heap_v78(evaluated.source, write.destination,
                    MemoryValueV30::Scalar(0));
                invocation_thread_write_put_local_pc_v94(evaluated.source, write.destination,
                    MemoryValueV30::Scalar(0));
                assert(result == invocation_source_byte_put_local_v36(evaluated.source,
                    write.destination, MemoryValueV30::Scalar(0))) by {
                    reveal(invocation_source_thread_write_v88);
                }
                return;
            }
            let pointer = MemoryPointerV30 {
                byte_offset: slice.pointer.byte_offset + index * write.recipe.width,
                ..slice.pointer };
            invocation_scalar_store_frame_v92(evaluated.source.machine, pointer,
                write.recipe.width, write.recipe.width, evaluated.value, little_endian);
            let stored = InvocationSourceByteStateV36 {
                machine: invocation_source_store_v36(evaluated.source.machine, pointer,
                    write.recipe.width, write.recipe.width, evaluated.value, little_endian),
                ..evaluated.source };
            if !stored.machine.valid {
                assert(result == invocation_source_byte_refused_v36(stored)) by {
                    reveal(invocation_source_thread_write_v88);
                }
                return;
            }
            invocation_source_put_local_preserves_heap_v78(stored, write.destination,
                MemoryValueV30::Scalar(1));
            invocation_thread_write_put_local_pc_v94(stored, write.destination,
                MemoryValueV30::Scalar(1));
            assert(result == invocation_source_byte_put_local_v36(stored,
                write.destination, MemoryValueV30::Scalar(1))) by {
                reveal(invocation_source_thread_write_v88);
            }
        },
        _ => {
            assert(result == invocation_source_byte_refused_v36(evaluated.source)) by {
                reveal(invocation_source_thread_write_v88);
            }
        },
    }
}

// Closed scalar-local operand normalization; callers prove the structural premises.
proof fn invocation_thread_write_local_normal_valid_v93(
    source: InvocationSourceByteStateV36, write: InvocationSourceThreadWriteV88,
    local: int, bits: int, root: int, instance: int, little_endian: bool,
)
    requires
        write.value == (InvocationSourceOperandV36::Scalar {
            value: InvocationSourceByteValueV36::Local { local, moved: false }, bits }),
        0 <= local < source.machine.values.len(),
        local != write.input, local != write.index,
        ordinary_memory_width_v30(write.recipe.width),
        bits == 1 && write.recipe.width == 1 || bits == 8 * write.recipe.width,
    ensures ({
        let after = invocation_source_thread_write_v88(source, write, root, instance,
            little_endian).source;
        (after.machine.valid ==> source.machine.valid
                && match (source.machine.values[write.input], source.machine.values[write.index],
                    source.machine.values[local]) {
                    (MemoryValueV30::Slice(slice), MemoryValueV30::Scalar(index),
                     MemoryValueV30::Scalar(value)) => {
                        0 <= index < memory_value_modulus_v30(write.recipe.metadata_bits / 8)
                        && 0 <= value < memory_value_modulus_v30(write.recipe.width)
                        && if index < slice.length {
                            let pointer = MemoryPointerV30 {
                                byte_offset: slice.pointer.byte_offset + index * write.recipe.width,
                                ..slice.pointer };
                            byte_range_aligned_v30(source.machine.memory, pointer,
                                write.recipe.width, write.recipe.width)
                                && after.machine.memory == byte_store_v30(source.machine.memory,
                                    pointer, write.recipe.width, value, little_endian)
                        } else { after.machine.memory == source.machine.memory }
                    },
                    _ => false,
                })
    }),
{
    hide(invocation_source_byte_state_well_formed_v36);
    hide(invocation_source_logical_write_v38);
    hide(invocation_source_descriptor_reference_current_v51);
    hide(invocation_source_witness_current_v38);
    hide(invocation_source_store_v36);
    hide(byte_store_v30);
    hide(byte_memory_well_formed_v30);
    if !write.recipe.mutable || !write.moved_receiver
        || !invocation_source_descriptor_reference_current_v51(source, write.input, write.recipe) {
        return;
    }
    invocation_source_put_local_preserves_heap_v78(source, write.input, MemoryValueV30::Undefined);
    invocation_thread_write_put_local_pc_v94(source, write.input, MemoryValueV30::Undefined);
    let receiver = invocation_source_byte_put_local_v36(source, write.input, MemoryValueV30::Undefined);
    if !invocation_source_witness_current_v38(receiver, write.index, write.witness_type) {
        return;
    }
    invocation_source_put_local_preserves_heap_v78(receiver, write.index, MemoryValueV30::Undefined);
    invocation_thread_write_put_local_pc_v94(receiver, write.index, MemoryValueV30::Undefined);
    let consumed = if write.moved_index {
        invocation_source_byte_put_local_v36(receiver, write.index, MemoryValueV30::Undefined)
    } else { receiver };
    assert(consumed.machine.values[local] == source.machine.values[local]);
    let evaluated = invocation_source_byte_evaluate_v36(consumed,
        InvocationSourceByteValueV36::Local { local, moved: false }, bits,
        root, instance, little_endian);
    if !evaluated.source.machine.valid
        || !invocation_source_byte_value_typed_v36(evaluated.value, bits) {
        return;
    }
    match (source.machine.values[write.input], receiver.machine.values[write.index]) {
        (MemoryValueV30::Slice(slice), MemoryValueV30::Scalar(index)) => {
            if index < 0 || index >= memory_value_modulus_v30(write.recipe.metadata_bits / 8) {
                return;
            }
            if index >= slice.length {
                invocation_source_put_local_preserves_heap_v78(evaluated.source, write.destination,
                    MemoryValueV30::Scalar(0));
                invocation_thread_write_put_local_pc_v94(evaluated.source, write.destination,
                    MemoryValueV30::Scalar(0));
                return;
            }
            let pointer = MemoryPointerV30 {
                byte_offset: slice.pointer.byte_offset + index * write.recipe.width,
                ..slice.pointer };
            invocation_scalar_store_frame_v92(evaluated.source.machine, pointer,
                write.recipe.width, write.recipe.width, evaluated.value, little_endian);
            let stored = InvocationSourceByteStateV36 {
                machine: invocation_source_store_v36(evaluated.source.machine, pointer,
                    write.recipe.width, write.recipe.width, evaluated.value, little_endian),
                ..evaluated.source };
            if !stored.machine.valid {
                return;
            }
            invocation_source_put_local_preserves_heap_v78(stored, write.destination,
                MemoryValueV30::Scalar(1));
            invocation_thread_write_put_local_pc_v94(stored, write.destination,
                MemoryValueV30::Scalar(1));
            reveal(invocation_source_store_v36);
        },
        _ => {},
    }
}

// Closed scalar-local operand normalization; callers prove the structural premises.
proof fn invocation_thread_write_local_normal_form_v93(
    source: InvocationSourceByteStateV36, write: InvocationSourceThreadWriteV88,
    local: int, bits: int, root: int, instance: int, little_endian: bool,
)
    requires
        write.value == (InvocationSourceOperandV36::Scalar {
            value: InvocationSourceByteValueV36::Local { local, moved: false }, bits }),
        0 <= local < source.machine.values.len(),
        local != write.input, local != write.index,
        ordinary_memory_width_v30(write.recipe.width),
        bits == 1 && write.recipe.width == 1 || bits == 8 * write.recipe.width,
    ensures ({
        let after = invocation_source_thread_write_v88(source, write, root, instance,
            little_endian).source;
        after.machine.pc == source.machine.pc
            && after.machine.values.len() == source.machine.values.len()
            && after.machine.frames == source.machine.frames
            && after.machine.generations == source.machine.generations
            && after.machine.memory.live.dom() == source.machine.memory.live.dom()
            && after.machine.memory.view_contracts == source.machine.memory.view_contracts
            && (after.machine.valid ==> source.machine.valid
                && match (source.machine.values[write.input], source.machine.values[write.index],
                    source.machine.values[local]) {
                    (MemoryValueV30::Slice(slice), MemoryValueV30::Scalar(index),
                     MemoryValueV30::Scalar(value)) => {
                        0 <= index < memory_value_modulus_v30(write.recipe.metadata_bits / 8)
                        && 0 <= value < memory_value_modulus_v30(write.recipe.width)
                        && if index < slice.length {
                            let pointer = MemoryPointerV30 {
                                byte_offset: slice.pointer.byte_offset + index * write.recipe.width,
                                ..slice.pointer };
                            byte_range_aligned_v30(source.machine.memory, pointer,
                                write.recipe.width, write.recipe.width)
                                && after.machine.memory == byte_store_v30(source.machine.memory,
                                    pointer, write.recipe.width, value, little_endian)
                        } else { after.machine.memory == source.machine.memory }
                    },
                    _ => false,
                })
    }),
{
    hide(invocation_source_thread_write_v88);
    invocation_thread_write_local_normal_frame_v93(source, write, local, bits, root, instance, little_endian);
    invocation_thread_write_local_normal_valid_v93(source, write, local, bits, root, instance, little_endian);
}
