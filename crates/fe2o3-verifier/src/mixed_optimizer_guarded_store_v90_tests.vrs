proof fn guarded_store_true_equals_selected_store_v90(s: MemoryStateV30, endian: bool)
    requires s.pc == 0, byte_inputs_90_v55(s, endian), s.values[1] == MemoryValueV30::Scalar(1),
    ensures byte_operation_90_0_v30(s, endian).state == byte_operation_90_1_v30(s, endian).state,
        byte_operation_90_0_v30(s, endian).state.valid ==>
            byte_operation_90_0_v30(s, endian).observation.effect == byte_operation_90_1_v30(s, endian).observation.effect,
{
    reveal(byte_operation_90_0_v30);
    reveal(byte_operation_90_1_v30);
}

proof fn guarded_store_false_equals_skipped_store_v90(s: MemoryStateV30, endian: bool)
    requires s.pc == 0, byte_inputs_90_v55(s, endian), s.valid,
        s.values[1] == MemoryValueV30::Scalar(0),
    ensures byte_operation_90_0_v30(s, endian).state == s,
        byte_operation_90_0_v30(s, endian).observation.effect == MemoryOperationEffectV30::Pure,
{
    reveal(byte_operation_90_0_v30);
}

proof fn guarded_store_nonbool_predicate_refuses_v90(s: MemoryStateV30, endian: bool)
    requires s.values.len() == 3,
        s.values[1] != MemoryValueV30::Scalar(0), s.values[1] != MemoryValueV30::Scalar(1),
    ensures !byte_operation_90_0_v30(s, endian).state.valid,
        byte_operation_90_0_v30(s, endian).state.memory == s.memory,
        byte_operation_90_0_v30(s, endian).observation.effect == MemoryOperationEffectV30::Refused,
{
    reveal(byte_operation_90_0_v30);
}

proof fn guarded_store_true_invalid_access_refuses_v90(s: MemoryStateV30, p: MemoryPointerV30, endian: bool)
    requires s.pc == 0, byte_inputs_90_v55(s, endian),
        s.values[0] == MemoryValueV30::Pointer(p), s.values[1] == MemoryValueV30::Scalar(1),
        !byte_range_aligned_v30(s.memory, p, 4, 1),
    ensures !byte_operation_90_0_v30(s, endian).state.valid,
        byte_operation_90_0_v30(s, endian).state.memory == s.memory,
        byte_operation_90_0_v30(s, endian).observation.effect == MemoryOperationEffectV30::Refused,
{
    reveal(byte_operation_90_0_v30);
}

proof fn guarded_store_false_cannot_restore_invalid_predecessor_v90(s: MemoryStateV30, endian: bool)
    requires !s.valid,
    ensures !byte_operation_90_0_v30(s, endian).state.valid,
        byte_operation_90_0_v30(s, endian).state.memory == s.memory,
        byte_operation_90_0_v30(s, endian).observation.effect == MemoryOperationEffectV30::Refused,
{
    reveal(byte_operation_90_0_v30);
}
