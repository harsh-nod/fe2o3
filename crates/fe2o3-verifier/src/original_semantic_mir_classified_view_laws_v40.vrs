// These obligations are included in generated original-MIR refinement scripts.
// Host source assertions do not constitute execution of these proofs.

proof fn invocation_guard_pair_requires_original_nominal_recipe_v40(
    source: MemoryTagGuardV38, target: MemoryTagGuardV38, map: InvocationByteMapV36,
    source_memory: ByteMemoryV30, target_memory: ByteMemoryV30,
)
    requires !invocation_source_target_tag_pair_0_1_v40(source.contract, target.contract),
    ensures !invocation_tag_guards_related_v40(source, target, map, source_memory, target_memory),
{ }

proof fn invocation_guard_pair_rejects_foreign_owner_v40(
    source: MemoryTagGuardV38, target: MemoryTagGuardV38, map: InvocationByteMapV36,
    source_memory: ByteMemoryV30, target_memory: ByteMemoryV30,
)
    requires source.owner != source_memory.view_contracts.owner
        || target.owner != target_memory.view_contracts.owner,
    ensures !invocation_tag_guards_related_v40(source, target, map, source_memory, target_memory),
{ }

proof fn invocation_guard_pair_never_refreshes_stale_source_v40(
    source: MemoryTagGuardV38, target: MemoryTagGuardV38, map: InvocationByteMapV36,
    source_memory: ByteMemoryV30, target_memory: ByteMemoryV30,
)
    requires !byte_tag_guard_current_v38(source_memory, source),
        byte_tag_guard_current_v38(target_memory, target),
    ensures !invocation_tag_guards_related_v40(source, target, map, source_memory, target_memory),
{ }

proof fn invocation_guard_pair_preserves_live_source_v40(
    source: MemoryTagGuardV38, target: MemoryTagGuardV38, map: InvocationByteMapV36,
    source_memory: ByteMemoryV30, target_memory: ByteMemoryV30,
)
    requires invocation_tag_guards_related_v40(source, target, map, source_memory, target_memory),
        byte_tag_guard_current_v38(source_memory, source),
    ensures byte_tag_guard_current_v38(target_memory, target),
{ }

proof fn invocation_guard_pair_uses_side_local_epoch_status_v40(
    source: MemoryTagGuardV38, target: MemoryTagGuardV38, map: InvocationByteMapV36,
    source_memory: ByteMemoryV30, target_memory: ByteMemoryV30, epochs: Seq<int>,
)
    requires invocation_tag_guards_related_v40(source, target, map, source_memory, target_memory),
        epochs.len() == target.epochs.len(),
        byte_tag_guard_current_v38(target_memory, MemoryTagGuardV38 { epochs, ..target })
            == byte_tag_guard_current_v38(target_memory, target),
    ensures invocation_tag_guards_related_v40(source, MemoryTagGuardV38 { epochs, ..target },
        map, source_memory, target_memory),
{ }

proof fn invocation_nested_source_guard_cannot_disappear_v40(
    source: MemoryPointerV30, target: MemoryPointerV30, map: InvocationByteMapV36,
    source_memory: ByteMemoryV30, target_memory: ByteMemoryV30,
    source_view: MemoryStorageViewV38, target_view: MemoryStorageViewV38,
)
    requires source.view == Some(source_view), target.view == Some(target_view),
        0 < source_view.guards.len(), target_view.guards.len() == 0,
    ensures !invocation_pointer_views_related_v40(source, target, map, source_memory, target_memory),
{ }

proof fn invocation_nested_target_guard_cannot_appear_without_match_v40(
    source: MemoryPointerV30, target: MemoryPointerV30, map: InvocationByteMapV36,
    source_memory: ByteMemoryV30, target_memory: ByteMemoryV30,
    source_view: MemoryStorageViewV38, target_view: MemoryStorageViewV38,
)
    requires source.view == Some(source_view), target.view == Some(target_view),
        source_view.guards.len() == 0, 0 < target_view.guards.len(),
    ensures !invocation_pointer_views_related_v40(source, target, map, source_memory, target_memory),
{ }

proof fn invocation_zero_width_keeps_stale_guard_refusal_v40(
    memory: ByteMemoryV30, pointer: MemoryPointerV30, view: MemoryStorageViewV38, index: int,
)
    requires pointer.view == Some(view), 0 <= index < view.guards.len(),
        !byte_tag_guard_current_v38(memory, view.guards[index]),
    ensures !byte_pointer_view_current_v38(memory, pointer, 0),
{ }
