// Unexecuted qualification obligations, not assumptions or admission evidence.
// Append after BYTE_MEMORY_V30 inside one verus! block.

proof fn storage_tag_read_requires_the_exact_installed_row_v39(
    memory: ByteMemoryV30, pointer: MemoryPointerV30, row: int, alignment: int,
)
    requires !memory.view_contracts.rows.contains_key(row),
    ensures byte_read_tag_v39(memory, pointer, row, alignment) == None,
{}

proof fn storage_tag_read_cannot_bypass_an_enclosing_stale_guard_v39(
    memory: ByteMemoryV30, pointer: MemoryPointerV30, row: int, alignment: int,
)
    requires memory.view_contracts.rows.contains_key(row),
        !byte_pointer_view_current_v38(memory, pointer, memory.view_contracts.rows[row].object_bytes),
    ensures byte_read_tag_v39(memory, pointer, row, alignment) == None,
{}

proof fn storage_zero_sized_variant_still_requires_a_valid_tag_read_v39(
    memory: ByteMemoryV30, pointer: MemoryPointerV30, row: int, variant: int, alignment: int,
)
    requires byte_read_tag_v39(memory, pointer, row, alignment) == None,
    ensures byte_variant_projection_v39(memory, pointer, row, variant, 0, alignment) == None,
{}

proof fn storage_variant_selection_cannot_substitute_another_inhabited_row_v39(
    memory: ByteMemoryV30, pointer: MemoryPointerV30, row: int,
    variant: int, extent: int, alignment: int, observation: MemoryTagObservationV39,
)
    requires memory.view_contracts.rows.contains_key(row),
        byte_read_tag_v39(memory, pointer, row, alignment) == Some(observation),
        !byte_tag_observation_selects_v39(memory.view_contracts.rows[row], observation, variant),
    ensures byte_variant_projection_v39(memory, pointer, row, variant, extent, alignment) == None,
{}

proof fn storage_variant_projection_cannot_exceed_its_owner_object_v39(
    memory: ByteMemoryV30, pointer: MemoryPointerV30, row: int,
    variant: int, extent: int, alignment: int,
)
    requires memory.view_contracts.rows.contains_key(row),
        extent < 0 || memory.view_contracts.rows[row].object_bytes < extent,
    ensures byte_variant_projection_v39(memory, pointer, row, variant, extent, alignment) == None,
{}

proof fn storage_tag_address_preserves_enclosing_nominal_view_v39(
    pointer: MemoryPointerV30, contract: MemoryTagContractV38,
)
    ensures byte_tag_address_v39(pointer, contract).allocation == pointer.allocation,
        byte_tag_address_v39(pointer, contract).view == pointer.view,
        byte_tag_address_v39(pointer, contract).byte_offset == pointer.byte_offset + contract.tag_offset,
{}
