// Actual transition footprints for the expanded paired caller. A footprint is
// not permission to preserve a live reference whose origin is overwritten.
proof fn invocation_source_plain_aggregate_install_frame_v260(
    source: InvocationSourceByteStateV36, destination: int, aggregate: InvocationSourceAggregateV42,
)
    requires source.machine.valid && invocation_source_byte_state_well_formed_v36(source),
        0 <= destination < source.machine.values.len(), !source.objects.contains_key(destination),
        invocation_source_aggregate_well_formed_v42(aggregate), aggregate.execution_lease.is_none(),
    ensures invocation_source_aggregate_install_v42(source, destination, aggregate)
        == (InvocationSourceByteStateV36 {
            machine: MemoryStateV30 { values: source.machine.values.update(
                destination, MemoryValueV30::Undefined), ..source.machine },
            logical: InvocationSourceLogicalV38 {
                aggregates: source.logical.aggregates.insert(destination, aggregate),
                ..invocation_source_logical_write_v38(source.logical, destination) }, ..source }),
{
    hide(invocation_source_byte_state_well_formed_v36);
    hide(invocation_source_aggregate_well_formed_v42);
    hide(invocation_source_aggregate_install_v42);
    hide(invocation_source_byte_put_local_v36);
    assert(invocation_source_byte_put_local_v36(source, destination, MemoryValueV30::Undefined)
        == (InvocationSourceByteStateV36 {
            machine: MemoryStateV30 { values: source.machine.values.update(
                destination, MemoryValueV30::Undefined), ..source.machine },
            logical: invocation_source_logical_write_v38(source.logical, destination), ..source })) by {
        reveal(invocation_source_byte_put_local_v36);
    }
    assert(source.logical.aggregates.remove(destination).insert(destination, aggregate)
        =~= source.logical.aggregates.insert(destination, aggregate));
    reveal(invocation_source_aggregate_install_v42);
}

proof fn invocation_context_marker_aggregate_well_formed_v260(source_type: int)
    requires invocation_source_context_shape_v161(source_type),
    ensures invocation_source_aggregate_well_formed_v42(InvocationSourceAggregateV42 {
        source_type, execution_lease: None, leaves: Map::empty()
            .insert(seq![0int], MemoryValueV30::Unit)
            .insert(seq![1int], MemoryValueV30::Unit)
            .insert(seq![2int], MemoryValueV30::Unit)
            .insert(seq![3int], MemoryValueV30::Unit)
            .insert(seq![4int], MemoryValueV30::Unit) }),
{
    hide(invocation_source_aggregate_leaf_count_v42);
    hide(invocation_source_aggregate_leaf_path_v42);
    hide(invocation_source_aggregate_leaf_bits_v42);
    let leaves = Map::empty()
        .insert(seq![0int], MemoryValueV30::Unit)
        .insert(seq![1int], MemoryValueV30::Unit)
        .insert(seq![2int], MemoryValueV30::Unit)
        .insert(seq![3int], MemoryValueV30::Unit)
        .insert(seq![4int], MemoryValueV30::Unit);
    assert forall|path: Seq<int>| leaves.contains_key(path) implies
        exists|ordinal: int| 0 <= ordinal < 5
            && path == invocation_source_aggregate_leaf_path_v42(source_type, ordinal)
            && invocation_source_byte_value_typed_v36(leaves[path],
                invocation_source_aggregate_leaf_bits_v42(source_type, ordinal)) by {
        if path == seq![0int] { assert(invocation_source_aggregate_leaf_path_v42(source_type, 0) == path); }
        else if path == seq![1int] { assert(invocation_source_aggregate_leaf_path_v42(source_type, 1) == path); }
        else if path == seq![2int] { assert(invocation_source_aggregate_leaf_path_v42(source_type, 2) == path); }
        else if path == seq![3int] { assert(invocation_source_aggregate_leaf_path_v42(source_type, 3) == path); }
        else { assert(path == seq![4int]); assert(invocation_source_aggregate_leaf_path_v42(source_type, 4) == path); }
    }
}

proof fn invocation_checked_add_aggregate_complete_v260(source_type: int, left: int, right: int)
    requires invocation_source_aggregate_leaf_count_v42(source_type) == 2,
        invocation_source_aggregate_leaf_path_v42(source_type, 0) == seq![0int],
        invocation_source_aggregate_leaf_path_v42(source_type, 1) == seq![1int],
        invocation_source_aggregate_leaf_bits_v42(source_type, 0) == 32,
        invocation_source_aggregate_leaf_bits_v42(source_type, 1) == 1,
        0 <= left < 4294967296, 0 <= right < 4294967296,
    ensures ({ let aggregate = InvocationSourceAggregateV42 {
        source_type, execution_lease: None, leaves: Map::empty()
            .insert(seq![0int], MemoryValueV30::Scalar((left + right) % 4294967296))
            .insert(seq![1int], MemoryValueV30::Scalar(
                if left + right >= 4294967296 { 1int } else { 0int })) };
        invocation_source_aggregate_well_formed_v42(aggregate)
            && invocation_source_aggregate_complete_v42(aggregate) }),
{
    hide(invocation_source_aggregate_leaf_count_v42);
    hide(invocation_source_aggregate_leaf_path_v42);
    hide(invocation_source_aggregate_leaf_bits_v42);
    let leaves = Map::empty()
        .insert(seq![0int], MemoryValueV30::Scalar((left + right) % 4294967296))
        .insert(seq![1int], MemoryValueV30::Scalar(
            if left + right >= 4294967296 { 1int } else { 0int }));
    assert forall|path: Seq<int>| leaves.contains_key(path) implies
        exists|ordinal: int| 0 <= ordinal < 2
            && path == invocation_source_aggregate_leaf_path_v42(source_type, ordinal)
            && invocation_source_byte_value_typed_v36(leaves[path],
                invocation_source_aggregate_leaf_bits_v42(source_type, ordinal)) by {
        if path == seq![0int] {
            assert(invocation_source_aggregate_leaf_path_v42(source_type, 0) == path);
        } else {
            assert(path == seq![1int]);
            assert(invocation_source_aggregate_leaf_path_v42(source_type, 1) == path);
        }
    }
    assert forall|ordinal: int| 0 <= ordinal < 2 implies
        leaves.contains_key(invocation_source_aggregate_leaf_path_v42(source_type, ordinal)) by {
        if ordinal != 0 { assert(ordinal == 1); }
    }
}

proof fn invocation_context_issue_fresh_preserves_frame_v259(
    source: InvocationSourceByteStateV36, target: MemoryStateV30,
    execution_map: Map<MemoryExecutionReferenceV178, InvocationExecutionOriginV205>,
    issue: InvocationSourceContextIssueV161, site: MemorySourceOperationV30,
    destination: int,
)
    requires invocation_context_issue_fresh_enabled_v211(source, target, issue, site, destination),
        invocation_execution_map_current_v205(source, target, execution_map),
    ensures ({ let next = invocation_context_issue_coupled_v211(
        source, target, execution_map, issue, site, destination);
        let after = next.source.source;
        next.updated && invocation_execution_map_current_v205(after, next.target, next.execution_map)
            && next.source.observations == Seq::empty()
            && after.machine == (MemoryStateV30 {
                values: source.machine.values.update(issue.destination, MemoryValueV30::Undefined),
                ..source.machine })
            && after.slots == source.slots && after.objects == source.objects
            && after.logical == (InvocationSourceLogicalV38 {
                aggregates: source.logical.aggregates.insert(
                    issue.destination, after.logical.aggregates[issue.destination]),
                ..invocation_source_logical_write_v38(source.logical, issue.destination) })
            && next.target == (MemoryStateV30 {
                values: target.values.update(destination, next.target.values[destination]),
                ..target }) }),
{
    hide(invocation_execution_map_current_v205);
    hide(invocation_source_byte_state_well_formed_v36);
    hide(byte_state_memory_well_formed_v30);
    hide(invocation_source_aggregate_well_formed_v42);
    hide(invocation_source_aggregate_leaf_count_v42);
    hide(invocation_source_aggregate_leaf_path_v42);
    hide(invocation_source_aggregate_leaf_bits_v42);
    hide(invocation_source_aggregate_install_v42);
    hide(invocation_source_context_issue_v161);
    hide(invocation_context_issue_coupled_v211);
    invocation_context_issue_fresh_preserves_current_map_v238(
        source, target, execution_map, issue, site, destination);
    invocation_context_issue_fresh_has_exact_updates_v211(
        source, target, execution_map, issue, site, destination);
    invocation_context_issue_coupling_replays_both_actual_steps_v211(
        source, target, execution_map, issue, site, destination);
    invocation_context_marker_aggregate_well_formed_v260(issue.source_type);
    let leaves = Map::empty()
        .insert(seq![0int], MemoryValueV30::Unit)
        .insert(seq![1int], MemoryValueV30::Unit)
        .insert(seq![2int], MemoryValueV30::Unit)
        .insert(seq![3int], MemoryValueV30::Unit)
        .insert(seq![4int], MemoryValueV30::Unit);
    let aggregate = InvocationSourceAggregateV42 {
        source_type: issue.source_type, execution_lease: None, leaves };
    invocation_source_plain_aggregate_install_frame_v260(source, issue.destination, aggregate);
    assert(invocation_source_context_issue_v161(source, issue).source
        == invocation_source_aggregate_install_v42(source, issue.destination, aggregate)) by {
        reveal(invocation_source_context_issue_v161);
    }
    let next = invocation_context_issue_coupled_v211(
        source, target, execution_map, issue, site, destination);
    assert(next.source == invocation_source_context_issue_v161(source, issue));
    let after = next.source.source;
    assert(after.machine == (MemoryStateV30 {
        values: source.machine.values.update(issue.destination, MemoryValueV30::Undefined),
        ..source.machine }));
    assert(after.slots == source.slots && after.objects == source.objects);
    assert(after.logical.aggregates =~= source.logical.aggregates.insert(
        issue.destination, after.logical.aggregates[issue.destination]));
    assert(after.logical == (InvocationSourceLogicalV38 {
        aggregates: source.logical.aggregates.insert(
            issue.destination, after.logical.aggregates[issue.destination]),
        ..invocation_source_logical_write_v38(source.logical, issue.destination) }));
    assert(next.target == (MemoryStateV30 {
        values: target.values.update(destination, next.target.values[destination]),
        ..target }));
}

// This is an actual operation preservation rule, not an assumed equality of
// successor snapshots. Callers must derive that a retained dependency is not
// the authentic ContextIssue destination.
proof fn invocation_context_issue_preserves_snapshot_v259(
    source: InvocationSourceByteStateV36, target: MemoryStateV30,
    execution_map: Map<MemoryExecutionReferenceV178, InvocationExecutionOriginV205>,
    issue: InvocationSourceContextIssueV161, site: MemorySourceOperationV30,
    destination: int, dependency: int,
)
    requires invocation_context_issue_fresh_enabled_v211(source, target, issue, site, destination),
        invocation_execution_map_current_v205(source, target, execution_map),
        0 <= dependency < target.values.len(), dependency != destination,
    ensures invocation_context_issue_coupled_v211(
        source, target, execution_map, issue, site, destination).target.values[dependency]
        == target.values[dependency],
{
    invocation_context_issue_fresh_preserves_frame_v259(
        source, target, execution_map, issue, site, destination);
}

// The two expressions are exactly the U32 value and Bool overflow recipes
// emitted by scalar_reconstruction_v254. Signed arithmetic is not admitted.
proof fn invocation_reconstructed_checked_add_u32_v259(left: int, right: int)
    requires 0 <= left < 4294967296, 0 <= right < 4294967296,
    ensures invocation_source_checked_pair_v44(
        MemoryValueV30::Scalar(left), MemoryValueV30::Scalar(right), 0, 32, false)
        == Some((MemoryValueV30::Scalar((left + right) % 4294967296),
            MemoryValueV30::Scalar(if left + right >= 4294967296 { 1int } else { 0int }))),
{
    assert(0 <= (left + right) % 4294967296 < 4294967296);
}

// Pure operand evaluation is an input obligation. Read operands, Move effects,
// and object-backed destinations require their separate operational laws.
proof fn invocation_source_checked_add_reconstruction_step_v259(
    source: InvocationSourceByteStateV36, destination: int, source_type: int,
    left_operand: InvocationSourceByteValueV36, right_operand: InvocationSourceByteValueV36,
    left: int, right: int, root: int, instance: int, little_endian: bool,
)
    requires source.machine.valid && invocation_source_byte_state_well_formed_v36(source),
        0 <= destination < source.machine.values.len(), !source.objects.contains_key(destination),
        invocation_source_aggregate_leaf_count_v42(source_type) == 2,
        invocation_source_aggregate_leaf_path_v42(source_type, 0) == seq![0int],
        invocation_source_aggregate_leaf_path_v42(source_type, 1) == seq![1int],
        invocation_source_aggregate_leaf_bits_v42(source_type, 0) == 32,
        invocation_source_aggregate_leaf_bits_v42(source_type, 1) == 1,
        !matches!(left_operand, InvocationSourceByteValueV36::Read { .. }),
        !matches!(right_operand, InvocationSourceByteValueV36::Read { .. }),
        invocation_source_byte_evaluate_v36(source, left_operand, 32, root, instance, little_endian)
            == (InvocationSourceByteEvaluationV36 { source, value: MemoryValueV30::Scalar(left) }),
        invocation_source_byte_evaluate_v36(source, right_operand, 32, root, instance, little_endian)
            == (InvocationSourceByteEvaluationV36 { source, value: MemoryValueV30::Scalar(right) }),
        0 <= left < 4294967296, 0 <= right < 4294967296,
    ensures ({ let after = invocation_source_checked_v42(source, destination, source_type,
        0, 32, false, left_operand, right_operand, root, instance, little_endian);
        let aggregate = InvocationSourceAggregateV42 { source_type, execution_lease: None,
            leaves: Map::empty()
                .insert(seq![0int], MemoryValueV30::Scalar((left + right) % 4294967296))
                .insert(seq![1int], MemoryValueV30::Scalar(
                    if left + right >= 4294967296 { 1int } else { 0int })) };
        after.machine == (MemoryStateV30 {
            values: source.machine.values.update(destination, MemoryValueV30::Undefined),
            ..source.machine })
            && after.slots == source.slots && after.objects == source.objects
            && after.logical == (InvocationSourceLogicalV38 {
                aggregates: source.logical.aggregates.insert(destination, aggregate),
                ..invocation_source_logical_write_v38(source.logical, destination) })
            && invocation_source_aggregate_complete_v42(aggregate) }),
{
    hide(invocation_source_byte_evaluate_v36);
    hide(invocation_source_byte_state_well_formed_v36);
    hide(invocation_source_aggregate_well_formed_v42);
    hide(invocation_source_aggregate_complete_v42);
    hide(invocation_source_aggregate_install_v42);
    hide(invocation_source_byte_put_local_v36);
    hide(invocation_source_aggregate_leaf_count_v42);
    hide(invocation_source_aggregate_leaf_path_v42);
    hide(invocation_source_aggregate_leaf_bits_v42);
    hide(invocation_source_checked_pair_v44);
    hide(invocation_source_checked_v42);
    invocation_reconstructed_checked_add_u32_v259(left, right);
    invocation_checked_add_aggregate_complete_v260(source_type, left, right);
    let leaves = Map::empty()
        .insert(seq![0int], MemoryValueV30::Scalar((left + right) % 4294967296))
        .insert(seq![1int], MemoryValueV30::Scalar(
            if left + right >= 4294967296 { 1int } else { 0int }));
    let aggregate = InvocationSourceAggregateV42 {
        source_type, execution_lease: None, leaves };
    assert(invocation_source_aggregate_complete_v42(aggregate));
    assert(invocation_source_checked_v42(source, destination, source_type,
        0, 32, false, left_operand, right_operand, root, instance, little_endian)
        == invocation_source_aggregate_install_v42(source, destination, aggregate)) by {
        reveal(invocation_source_checked_v42);
    }
    invocation_source_plain_aggregate_install_frame_v260(source, destination, aggregate);
}
