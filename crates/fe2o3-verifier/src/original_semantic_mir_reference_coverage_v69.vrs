// Registered output coverage is independent of per-effect value equality.
// The emitter derives expected rows from the independently replayed CPU body
// and original descriptor arguments, never from the source's observed writes.
struct InvocationReferenceOutputV69 {
    argument: int,
    address: MemoryPointerV30,
    width: int,
    alignment: int,
    value: MemoryValueV30,
}

spec fn invocation_reference_point_active_v69(value: MemoryValueV30, point: int) -> bool {
    match value { MemoryValueV30::Slice(slice) => 0 <= point < slice.length, _ => false }
}

spec fn invocation_reference_write_matches_v69(
    effect: MemoryOperationEffectV30, expected: InvocationReferenceOutputV69,
) -> bool {
    effect == (MemoryOperationEffectV30::Write {
        address: MemoryValueV30::Pointer(expected.address),
        width: expected.width, alignment: expected.alignment, value: expected.value })
}

spec fn invocation_reference_write_count_v69(
    observed: Seq<InvocationSourceEffectObservationV39>, expected: InvocationReferenceOutputV69,
) -> nat
    decreases observed.len(),
{
    if observed.len() == 0 { 0nat } else {
        (if invocation_reference_write_matches_v69(observed[0].effect, expected) { 1nat } else { 0nat })
            + invocation_reference_write_count_v69(observed.drop_first(), expected)
    }
}

spec fn invocation_reference_outputs_separate_v69(
    left: InvocationReferenceOutputV69, right: InvocationReferenceOutputV69,
) -> bool {
    left.argument != right.argument
        && (left.address.allocation != right.address.allocation
            || left.address.byte_offset + left.width <= right.address.byte_offset
            || right.address.byte_offset + right.width <= left.address.byte_offset)
}

spec fn invocation_reference_complete_outputs_v69(
    observed: Seq<InvocationSourceEffectObservationV39>, expected: Seq<InvocationReferenceOutputV69>,
) -> bool {
    (forall|i: int| #![trigger expected[i]] 0 <= i < expected.len() ==> {
            expected[i].argument >= 0 && expected[i].width > 0 && expected[i].alignment > 0
                && invocation_reference_write_count_v69(observed, expected[i]) == 1
        })
        && (forall|i: int, j: int| #![trigger expected[i], expected[j]]
            0 <= i < j < expected.len() ==>
            invocation_reference_outputs_separate_v69(expected[i], expected[j]))
        && (forall|i: int| #![trigger observed[i]] 0 <= i < observed.len() ==> {
            observed[i].before.machine.valid && observed[i].after.machine.valid
                && match observed[i].effect {
                    MemoryOperationEffectV30::Read { .. } => true,
                    MemoryOperationEffectV30::Write { .. } =>
                        exists|j: int| #![trigger expected[j]] 0 <= j < expected.len()
                            && invocation_reference_write_matches_v69(observed[i].effect, expected[j]),
                    _ => false,
                }
        })
}
