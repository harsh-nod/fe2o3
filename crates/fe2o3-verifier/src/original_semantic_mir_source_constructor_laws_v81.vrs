    ensures
        invocation_source_value_evaluate_v42(source, InvocationSourceOperandV36::Scalar { value: InvocationSourceByteValueV36::Local { local, moved: false }, bits }, root, instance, little_endian).source.machine.valid ==>
            invocation_source_value_evaluate_v42(source, InvocationSourceOperandV36::Scalar { value: InvocationSourceByteValueV36::Local { local, moved: false }, bits }, root, instance, little_endian).source == source,
        invocation_source_value_evaluate_v42(source, InvocationSourceOperandV36::Scalar { value: InvocationSourceByteValueV36::Local { local, moved: false }, bits }, root, instance, little_endian).source.machine.valid ==>
            invocation_source_value_evaluate_v42(source, InvocationSourceOperandV36::Scalar { value: InvocationSourceByteValueV36::Local { local, moved: false }, bits }, root, instance, little_endian).value == InvocationSourceValueV42::Carrier(source.machine.values[local]),
{
    hide(invocation_source_byte_state_well_formed_v36);
    hide(invocation_source_byte_value_typed_v36);
}

