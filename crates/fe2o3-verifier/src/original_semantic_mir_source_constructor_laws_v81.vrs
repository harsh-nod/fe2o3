        invocation_source_return_install_v42(source, InvocationSourceReturnDestinationV42 { local, component: None, memory: None, descriptor: None }, InvocationSourceValueV42::Carrier(value), little_endian).machine.generations == source.machine.generations,
        invocation_source_return_install_v42(source, InvocationSourceReturnDestinationV42 { local, component: None, memory: None, descriptor: None }, InvocationSourceValueV42::Carrier(value), little_endian).machine.frames == source.machine.frames,
        invocation_source_return_install_v42(source, InvocationSourceReturnDestinationV42 { local, component: None, memory: None, descriptor: None }, InvocationSourceValueV42::Carrier(value), little_endian).machine.values.len() == source.machine.values.len(),
