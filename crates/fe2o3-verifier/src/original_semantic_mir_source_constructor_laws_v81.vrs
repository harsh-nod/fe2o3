// fe2o3_optional_support_v97: invocation_source_scalar_copy_valid_identity_v164
#[verifier::spinoff_prover]
proof fn invocation_source_scalar_copy_valid_identity_v164(
    source: InvocationSourceByteStateV36, local: int,
