        invocation_source_value_evaluate_v42(source, InvocationSourceOperandV36::Scalar { value: InvocationSourceByteValueV36::Local { local, moved }, bits }, root, instance, little_endian).source.machine.memory == source.machine.memory,
        invocation_source_value_evaluate_v42(source, InvocationSourceOperandV36::Scalar { value: InvocationSourceByteValueV36::Local { local, moved }, bits }, root, instance, little_endian).source.machine.generations == source.machine.generations,
        invocation_source_value_evaluate_v42(source, InvocationSourceOperandV36::Scalar { value: InvocationSourceByteValueV36::Local { local, moved }, bits }, root, instance, little_endian).source.machine.frames == source.machine.frames,
        invocation_source_value_evaluate_v42(source, InvocationSourceOperandV36::Scalar { value: InvocationSourceByteValueV36::Local { local, moved }, bits }, root, instance, little_endian).source.machine.values.len() == source.machine.values.len(),
