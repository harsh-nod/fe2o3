// Shared constructor laws. These do not assert that an arbitrary program preserves its heap.

// fe2o3_optional_support_v97: invocation_private_free_frame_end_identity_v77
proof fn invocation_private_free_frame_end_identity_v77(memory: ByteMemoryV30, frame: MemoryDynamicFrameV30)
 requires forall|allocation: MemoryAllocationV30| #[trigger] memory.live.contains_key(allocation) ==> !invocation_private_allocation_v36(allocation),
 ensures byte_end_frame_v30(memory, frame) == memory,
{
 let ended = byte_end_frame_v30(memory, frame);
 assert forall|allocation: MemoryAllocationV30| ended.live.contains_key(allocation) <==> memory.live.contains_key(allocation) by {
  if memory.live.contains_key(allocation) { assert(!byte_allocation_in_frame_v30(allocation, frame)); }
 }
 assert forall|allocation: MemoryAllocationV30| memory.live.contains_key(allocation) implies ended.live[allocation] == memory.live[allocation] by { }
 assert(ended.live =~= memory.live);
}

// fe2o3_optional_support_v97: invocation_source_put_local_preserves_heap_v78
#[verifier::spinoff_prover]
proof fn invocation_source_put_local_preserves_heap_v78(
    source: InvocationSourceByteStateV36, local: int, value: MemoryValueV30,
)
    ensures
        invocation_source_byte_put_local_v36(source, local, value).machine.memory == source.machine.memory,
        invocation_source_byte_put_local_v36(source, local, value).machine.generations == source.machine.generations,
        invocation_source_byte_put_local_v36(source, local, value).machine.frames == source.machine.frames,
        invocation_source_byte_put_local_v36(source, local, value).machine.values.len() == source.machine.values.len(),
{
    hide(invocation_source_byte_state_well_formed_v36);
    hide(invocation_source_logical_write_v38);
}

// fe2o3_optional_support_v97: invocation_source_local_evaluate_preserves_heap_v78
#[verifier::spinoff_prover]
proof fn invocation_source_local_evaluate_preserves_heap_v78(
    source: InvocationSourceByteStateV36, local: int, moved: bool,
    bits: int, root: int, instance: int, little_endian: bool,
)
    ensures
        invocation_source_byte_evaluate_v36(source, InvocationSourceByteValueV36::Local { local, moved }, bits, root, instance, little_endian).source.machine.memory == source.machine.memory,
        invocation_source_byte_evaluate_v36(source, InvocationSourceByteValueV36::Local { local, moved }, bits, root, instance, little_endian).source.machine.generations == source.machine.generations,
        invocation_source_byte_evaluate_v36(source, InvocationSourceByteValueV36::Local { local, moved }, bits, root, instance, little_endian).source.machine.frames == source.machine.frames,
        invocation_source_byte_evaluate_v36(source, InvocationSourceByteValueV36::Local { local, moved }, bits, root, instance, little_endian).source.machine.values.len() == source.machine.values.len(),
{
    hide(invocation_source_byte_state_well_formed_v36);
    hide(invocation_source_byte_value_typed_v36);
    hide(invocation_source_byte_put_local_v36);
    invocation_source_put_local_preserves_heap_v78(source, local, MemoryValueV30::Undefined);
}

