// Unexecuted law fixtures until included in an admitted Verus run.
proof fn witness_transfer_cannot_copy_authority_v40(
    source: InvocationSourceByteStateV36, input: int, destination: int, ty: int,
)
    ensures !invocation_source_transfer_witness_v40(source, destination, input, ty, false, false).machine.valid,
{ }

proof fn witness_transfer_rejects_stale_input_v40(
    source: InvocationSourceByteStateV36, input: int, destination: int, ty: int,
)
    requires !invocation_source_witness_current_v38(source, input, ty),
    ensures !invocation_source_transfer_witness_v40(source, destination, input, ty, false, true).machine.valid,
{ }

proof fn witness_reference_transfer_rejects_stale_loan_v40(
    source: InvocationSourceByteStateV36, input: int, destination: int, ty: int, moved: bool,
)
    requires !invocation_source_reference_current_v38(source, input, ty),
    ensures !invocation_source_transfer_witness_v40(source, destination, input, ty, true, moved).machine.valid,
{ }

proof fn witness_reference_transfer_keeps_exact_loan_v40(
    source: InvocationSourceByteStateV36, input: int, destination: int, ty: int, moved: bool,
)
    requires invocation_source_reference_current_v38(source, input, ty),
        0 <= destination < source.machine.values.len(),
        destination != source.logical.references[input].origin,
    ensures ({ let changed = invocation_source_transfer_witness_v40(source, destination, input, ty, true, moved);
        changed.logical.references[destination] == source.logical.references[input]
            && changed.machine.values[destination] == source.machine.values[input] }),
{ }

proof fn witness_reference_move_consumes_input_v40(
    source: InvocationSourceByteStateV36, input: int, destination: int, ty: int,
)
    requires invocation_source_reference_current_v38(source, input, ty),
        0 <= destination < source.machine.values.len(), input != destination,
        destination != source.logical.references[input].origin,
    ensures ({ let changed = invocation_source_transfer_witness_v40(source, destination, input, ty, true, true);
        changed.machine.values[input] == MemoryValueV30::Undefined
            && !changed.logical.references.contains_key(input) }),
{ }

proof fn witness_move_invalidates_old_borrow_v40(
    source: InvocationSourceByteStateV36, input: int, destination: int, reference: int, ty: int,
)
    requires invocation_source_reference_current_v38(source, reference, ty),
        source.logical.references[reference].origin == input,
        0 <= destination < source.machine.values.len(),
    ensures !invocation_source_reference_current_v38(
        invocation_source_transfer_witness_v40(source, destination, input, ty, false, true), reference, ty),
{ }

proof fn witness_self_move_advances_version_twice_v40(
    source: InvocationSourceByteStateV36, input: int, ty: int,
)
    requires invocation_source_witness_current_v38(source, input, ty),
    ensures ({ let changed = invocation_source_transfer_witness_v40(source, input, input, ty, false, true);
        changed.logical.versions[input] == source.logical.versions[input] + 2
            && changed.machine.values[input] == source.machine.values[input] }),
{ }
