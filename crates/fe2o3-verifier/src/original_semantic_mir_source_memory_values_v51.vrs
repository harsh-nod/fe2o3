struct InvocationSourceMemoryFieldV51 {
    source_type: int,
    offset: int,
}

struct InvocationSourceMemoryValidityV51 {
    offset: int,
    width: int,
    start: int,
    end: int,
    pointer: bool,
}

enum InvocationSourceMemoryKindV51 {
    Unit,
    Scalar(int),
    Pointer { pointee: int, reference: bool, mutable: bool },
    Fields(Seq<InvocationSourceMemoryFieldV51>),
    Array { element: int, count: int, stride: int },
}

struct InvocationSourceMemoryLayoutV51 {
    width: int,
    alignment: int,
    depth: nat,
    copy: bool,
    kind: InvocationSourceMemoryKindV51,
    validity: Seq<InvocationSourceMemoryValidityV51>,
}

spec fn invocation_source_memory_validity_v51(
    source: InvocationSourceByteStateV36, pointer: MemoryPointerV30,
    validity: InvocationSourceMemoryValidityV51, little_endian: bool,
) -> bool {
    let address = MemoryPointerV30 { byte_offset: pointer.byte_offset + validity.offset, ..pointer };
    0 <= validity.offset && ordinary_memory_width_v30(validity.width)
        && if validity.pointer {
            validity.width == 8
                && byte_pointer_load_valid_v37(source.machine.memory, address, 8, little_endian)
                && byte_pointer_type_v30(byte_pointer_load_v37(source.machine.memory, address, 8, little_endian), 2, 8)
        } else {
            invocation_source_read_enabled_v36(source.machine, address, validity.width, 1)
                && { let value = byte_load_v30(source.machine.memory, address, validity.width, little_endian);
                    if validity.start <= validity.end {
                        validity.start <= value <= validity.end
                    } else { value <= validity.end || validity.start <= value } }
        }
}

// Decomposition checks only original fields. Padding is neither loaded as a
// scalar nor required initialized. Pointer cells need a complete relocation;
// references additionally need a live, aligned, independently typed referent.
spec fn invocation_source_memory_value_valid_v51(
    source: InvocationSourceByteStateV36, pointer: MemoryPointerV30,
    source_type: int, fuel: nat, little_endian: bool,
) -> bool
    decreases fuel,
{
    if fuel == 0 || !source.machine.valid || !invocation_source_byte_state_well_formed_v36(source)
        || !byte_pointer_type_v30(pointer, 2, 8) {
        false
    } else { match invocation_source_memory_layout_v51(source_type) {
        None => false,
        Some(layout) => {
            0 < layout.depth <= fuel
                && byte_range_aligned_v30(source.machine.memory, pointer, layout.width, layout.alignment)
                && (forall|i: int| 0 <= i < layout.validity.len() ==>
                    invocation_source_memory_validity_v51(source, pointer, layout.validity[i], little_endian))
                && match layout.kind {
                    InvocationSourceMemoryKindV51::Unit => layout.width == 0,
                    InvocationSourceMemoryKindV51::Scalar(bits) =>
                        invocation_source_read_enabled_v36(source.machine, pointer, layout.width, layout.alignment)
                            && invocation_source_byte_value_typed_v36(MemoryValueV30::Scalar(
                                byte_load_v30(source.machine.memory, pointer, layout.width, little_endian)), bits),
                    InvocationSourceMemoryKindV51::Pointer { pointee, reference, .. } => {
                        layout.width == 8
                            && byte_pointer_load_valid_v37(source.machine.memory, pointer, 8, little_endian)
                            && { let value = byte_pointer_load_v37(source.machine.memory, pointer, 8, little_endian);
                                byte_pointer_type_v30(value, 2, 8)
                                    && (!reference || invocation_source_memory_value_valid_v51(
                                        source, value, pointee, (fuel - 1) as nat, little_endian)) }
                    }
                    InvocationSourceMemoryKindV51::Fields(fields) =>
                        forall|i: int| 0 <= i < fields.len() ==>
                            invocation_source_memory_value_valid_v51(source,
                                MemoryPointerV30 { byte_offset: pointer.byte_offset + fields[i].offset, ..pointer },
                                fields[i].source_type, (fuel - 1) as nat, little_endian),
                    InvocationSourceMemoryKindV51::Array { element, count, stride } =>
                        0 <= count && 0 <= stride && layout.width == count * stride
                            && forall|i: int| 0 <= i < count ==>
                                #[trigger] invocation_source_memory_value_valid_v51(source,
                                    MemoryPointerV30 { byte_offset: pointer.byte_offset + i * stride, ..pointer },
                                    element, (fuel - 1) as nat, little_endian),
                }
        }
    } }
}

spec fn invocation_source_typed_borrow_v51(
    source: InvocationSourceByteStateV36, destination: int,
    access: InvocationSourceByteAccessV36, source_type: int, root_type: int,
    root: int, instance: int, little_endian: bool,
) -> InvocationSourceByteStateV36 {
    match (invocation_source_memory_layout_v51(source_type),
        invocation_source_byte_address_v36(source, access, root, instance)) {
        (Some(layout), Some(pointer)) => {
            let original_root = match access.base {
                InvocationSourceByteBaseV36::ObjectLocal(local) =>
                    source.objects.contains_key(local) && source.objects[local].slot.semantic_type == root_type,
                InvocationSourceByteBaseV36::Slot { slot, .. } => slot.semantic_type == root_type,
                InvocationSourceByteBaseV36::PointerLocal(_) => true,
                _ => false,
            };
            if original_root && access.width == layout.width && access.alignment == layout.alignment
                && invocation_source_memory_value_valid_v51(source, pointer, source_type, layout.depth, little_endian) {
                invocation_source_byte_put_local_v36(source, destination, MemoryValueV30::Pointer(pointer))
            } else { invocation_source_byte_refused_v36(source) }
        }
        _ => invocation_source_byte_refused_v36(source),
    }
}
