// Unexecuted qualification obligations. Prepend the shared BYTE_MEMORY_V30
// model inside one verus! block. These are not production axioms or admission.

proof fn view_equal_tag_overwrite_still_invalidates_guard_v38(
    memory: ByteMemoryV30, guard: MemoryTagGuardV38,
    address: MemoryPointerV30, width: int, bits: int, little_endian: bool,
)
    requires byte_memory_well_formed_v30(memory), byte_tag_guard_current_v38(memory, guard),
        address.allocation == guard.allocation,
        ordinary_memory_width_v30(width), byte_range_live_v30(memory, address, width),
        0 <= bits < memory_value_modulus_v30(width),
        guard.object_start + memory.view_contracts.rows[guard.contract].tag_offset
            <= address.byte_offset
            < guard.object_start + memory.view_contracts.rows[guard.contract].tag_offset
                + memory.view_contracts.rows[guard.contract].tag_width,
    ensures !byte_tag_guard_current_v38(byte_store_v30(memory, address, width, bits, little_endian), guard),
{
    let contract = memory.view_contracts.rows[guard.contract];
    let tag = guard.object_start + contract.tag_offset;
    let index = address.byte_offset - tag;
    assert(0 <= index < contract.tag_width);
    assert(guard.epochs[index] <= memory.live[guard.allocation].write_clock);
    assert(byte_store_v30(memory, address, width, bits, little_endian)
        .live[guard.allocation].write_epochs[address.byte_offset]
            == memory.live[guard.allocation].write_clock + 1);
}

proof fn view_disjoint_write_preserves_captured_tag_epochs_v38(
    previous: MemoryBytesV30, offset: int, width: int, tag: int, tag_width: int, index: int,
)
    requires 0 <= offset, 0 <= width, 0 <= tag, 0 <= tag_width,
        !byte_intervals_overlap_v37(offset, width, tag, tag_width),
        0 <= index < tag_width, tag + index < previous.write_epochs.len(),
    ensures byte_overwrite_epochs_v38(previous, offset, width)[tag + index]
        == previous.write_epochs[tag + index],
{}

proof fn view_zero_width_access_cannot_bypass_an_enclosing_stale_guard_v38(
    memory: ByteMemoryV30, pointer: MemoryPointerV30, view: MemoryStorageViewV38, index: int,
)
    requires pointer.view == Some(view), 0 <= index < view.guards.len(),
        !byte_tag_guard_current_v38(memory, view.guards[index]),
    ensures !byte_range_live_v30(memory, pointer, 0),
{}

proof fn view_copy_assigns_destination_epochs_not_source_epochs_v38(
    memory: ByteMemoryV30, source: MemoryPointerV30, destination: MemoryPointerV30,
    width: int, relative: int,
)
    requires byte_memory_well_formed_v30(memory),
        byte_range_live_v30(memory, source, width), byte_range_live_v30(memory, destination, width),
        0 <= relative < width,
    ensures byte_copy_object_v37(memory, source, destination, width)
        .live[destination.allocation].write_epochs[destination.byte_offset + relative]
            == memory.live[destination.allocation].write_clock + 1,
        byte_copy_object_v37(memory, source, destination, width)
            .live[destination.allocation].bytes[destination.byte_offset + relative]
            == memory.live[source.allocation].bytes[source.byte_offset + relative],
{}

proof fn view_zero_width_copy_still_requires_guard_currentness_v38(
    memory: ByteMemoryV30, source: MemoryPointerV30, destination: MemoryPointerV30,
    view: MemoryStorageViewV38, index: int,
)
    requires source.view == Some(view), 0 <= index < view.guards.len(),
        !byte_tag_guard_current_v38(memory, view.guards[index]),
    ensures !byte_copy_object_valid_v37(memory, source, destination, 0, 1, 1, false),
{}

proof fn view_untouched_bytes_do_not_follow_the_global_write_clock_v38(
    previous: MemoryBytesV30, offset: int, width: int, index: int,
)
    requires 0 < width, 0 <= index < previous.write_epochs.len(),
        !(offset <= index < offset + width),
    ensures byte_write_clock_v38(previous, width) == previous.write_clock + 1,
        byte_overwrite_epochs_v38(previous, offset, width)[index] == previous.write_epochs[index],
{}

proof fn view_narrowing_retains_all_outer_guards_v38(
    pointer: MemoryPointerV30, view: MemoryStorageViewV38, lower: int, upper: int,
)
    requires pointer.view == Some(view), 0 <= lower <= pointer.byte_offset <= upper,
        view.lower <= lower, upper <= view.upper,
    ensures byte_narrow_view_v38(pointer, lower, upper).view
        == Some(MemoryStorageViewV38 { lower, upper, guards: view.guards }),
{}

proof fn native_entry_rejects_unused_guarded_ssa_value_v38(
    memory: ByteMemoryV30, values: Seq<MemoryValueV30>, index: int,
    pointer: MemoryPointerV30, view: MemoryStorageViewV38,
)
    requires 0 <= index < values.len(), values[index] == MemoryValueV30::Pointer(pointer),
        pointer.view == Some(view), 0 < view.guards.len(),
    ensures !byte_native_view_inputs_v38(memory, values),
{}

proof fn native_entry_rejects_unused_initialized_guarded_fragment_v38(
    memory: ByteMemoryV30, values: Seq<MemoryValueV30>, allocation: MemoryAllocationV30,
    index: int, pointer: MemoryPointerV30, view: MemoryStorageViewV38, width: int, ordinal: int,
)
    requires memory.live.contains_key(allocation),
        0 <= index < memory.live[allocation].bytes.len(),
        index < memory.live[allocation].initialized.len(),
        memory.live[allocation].initialized[index],
        memory.live[allocation].bytes[index] == MemoryByteV37::PointerFragment { pointer, width, ordinal },
        pointer.view == Some(view), 0 < view.guards.len(),
    ensures !byte_native_view_inputs_v38(memory, values),
{}
