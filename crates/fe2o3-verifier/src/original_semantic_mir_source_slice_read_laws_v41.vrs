// Qualification obligations. Not executed or assumed by production admission.
proof fn invocation_slice_read_invalid_source_refuses_v41(
    source: InvocationSourceByteStateV36, recipe: InvocationSourceSliceReadV41,
    offset: int, width: int, alignment: int,
)
    requires !source.machine.valid,
    ensures invocation_source_slice_read_base_v41(source, recipe, offset, width, alignment).is_none(),
{}

proof fn invocation_slice_read_cross_element_refuses_v41(
    source: InvocationSourceByteStateV36, recipe: InvocationSourceSliceReadV41,
    offset: int, width: int, alignment: int,
)
    requires offset + width > recipe.stride,
    ensures invocation_source_slice_read_base_v41(source, recipe, offset, width, alignment).is_none(),
{}

proof fn invocation_slice_read_bounds_refuse_v41(
    source: InvocationSourceByteStateV36, recipe: InvocationSourceSliceReadV41,
    offset: int, width: int, alignment: int, slice: MemorySliceV30, index: int,
)
    requires
        0 <= recipe.local < source.machine.values.len(),
        0 <= recipe.index < source.machine.values.len(),
        source.machine.values[recipe.local] == MemoryValueV30::Slice(slice),
        source.machine.values[recipe.index] == MemoryValueV30::Scalar(index),
        index < 0 || index >= slice.length,
    ensures invocation_source_slice_read_base_v41(source, recipe, offset, width, alignment).is_none(),
{}

proof fn invocation_slice_read_dead_allocation_refuses_at_zero_width_v41(
    source: InvocationSourceByteStateV36, recipe: InvocationSourceSliceReadV41,
    offset: int, alignment: int, slice: MemorySliceV30,
)
    requires
        0 <= recipe.local < source.machine.values.len(),
        source.machine.values[recipe.local] == MemoryValueV30::Slice(slice),
        !source.machine.memory.live.contains_key(slice.pointer.allocation),
    ensures invocation_source_slice_read_base_v41(source, recipe, offset, 0, alignment).is_none(),
{}

proof fn invocation_slice_read_preserves_nominal_allocation_and_view_v41(
    source: InvocationSourceByteStateV36, recipe: InvocationSourceSliceReadV41,
    offset: int, width: int, alignment: int, slice: MemorySliceV30,
    base: MemoryPointerV30,
)
    requires
        0 <= recipe.local < source.machine.values.len(),
        source.machine.values[recipe.local] == MemoryValueV30::Slice(slice),
        invocation_source_slice_read_base_v41(source, recipe, offset, width, alignment) == Some(base),
    ensures
        base.allocation == slice.pointer.allocation,
        base.view == slice.pointer.view,
{}
