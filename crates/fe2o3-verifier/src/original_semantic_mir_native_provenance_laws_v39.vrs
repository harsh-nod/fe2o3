proof fn native_live_private_key_is_rejected_v39(
    memory: ByteMemoryV30, arguments: Seq<MemoryValueV30>, allocation: MemoryAllocationV30,
)
    requires memory.live.contains_key(allocation), invocation_private_allocation_v36(allocation),
    ensures !invocation_native_provenance_v39(memory, arguments),
{}

proof fn native_initialized_private_fragment_is_rejected_without_a_complete_cell_v39(
    memory: ByteMemoryV30, arguments: Seq<MemoryValueV30>, allocation: MemoryAllocationV30,
    at: int, pointer: MemoryPointerV30, width: int, ordinal: int,
)
    requires memory.live.contains_key(allocation),
        0 <= at < memory.live[allocation].bytes.len(), memory.live[allocation].initialized[at],
        memory.live[allocation].bytes[at]
            == (MemoryByteV37::PointerFragment { pointer, width, ordinal }),
        invocation_private_allocation_v36(pointer.allocation),
    ensures !invocation_native_provenance_v39(memory, arguments),
{}

proof fn native_complete_private_relocation_is_rejected_v39(
    memory: ByteMemoryV30, arguments: Seq<MemoryValueV30>, allocation: MemoryAllocationV30,
    at: int,
)
    requires memory.live.contains_key(allocation),
        memory.live[allocation].relocations.contains_key(at),
        invocation_private_allocation_v36(memory.live[allocation].relocations[at].pointer.allocation),
    ensures !invocation_native_provenance_v39(memory, arguments),
