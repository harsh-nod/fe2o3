proof fn native_epoch_mutation_cannot_authorize_a_private_argument_v39(
    memory: ByteMemoryV30, arguments: Seq<MemoryValueV30>, index: int,
)
    requires 0 <= index < arguments.len(), !invocation_native_value_provenance_v39(arguments[index]),
