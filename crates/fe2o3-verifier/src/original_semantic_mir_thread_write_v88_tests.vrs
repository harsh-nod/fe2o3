spec fn thread_write_consumed_v88_test(source: InvocationSourceByteStateV36,
    write: InvocationSourceThreadWriteV88) -> InvocationSourceByteStateV36 {
    let receiver = invocation_source_byte_put_local_v36(
        source, write.input, MemoryValueV30::Undefined);
    if write.moved_index { invocation_source_byte_put_local_v36(
        receiver, write.index, MemoryValueV30::Undefined) } else { receiver }
}

#[verifier::spinoff_prover]
proof fn thread_write_requires_a_moved_mutable_receiver_v88(
    source: InvocationSourceByteStateV36, write: InvocationSourceThreadWriteV88,
    root: int, instance: int, little_endian: bool,
)
    requires !write.recipe.mutable || !write.moved_receiver,
    ensures invocation_source_thread_write_v88(source, write, root, instance, little_endian)
        == invocation_source_thread_write_refused_v88(source),
{
    hide(invocation_source_thread_write_refused_v88);
    hide(invocation_source_descriptor_reference_current_v51);
}

#[verifier::spinoff_prover]
proof fn thread_write_outside_extent_has_no_store_and_returns_false_v88(
    source: InvocationSourceByteStateV36, write: InvocationSourceThreadWriteV88,
    slice: MemorySliceV30, offset: int, value: InvocationSourceByteValueV36, bits: int,
    root: int, instance: int, little_endian: bool,
)
    requires
        write.recipe.mutable, write.moved_receiver,
        invocation_source_descriptor_reference_current_v51(source, write.input, write.recipe),
        source.machine.values[write.input] == MemoryValueV30::Slice(slice),
        invocation_source_witness_current_v38(invocation_source_byte_put_local_v36(
            source, write.input, MemoryValueV30::Undefined), write.index, write.witness_type),
        invocation_source_byte_put_local_v36(source, write.input, MemoryValueV30::Undefined)
            .machine.values[write.index] == MemoryValueV30::Scalar(offset),
        write.value == (InvocationSourceOperandV36::Scalar { value, bits }),
        0 <= offset < memory_value_modulus_v30(write.recipe.metadata_bits / 8),
        offset >= slice.length,
        bits == 1 && write.recipe.width == 1 || bits == 8 * write.recipe.width,
        invocation_source_byte_evaluate_v36(thread_write_consumed_v88_test(source, write),
            value, bits, root, instance, little_endian).source.machine.valid,
        invocation_source_byte_value_typed_v36(invocation_source_byte_evaluate_v36(
            thread_write_consumed_v88_test(source, write), value, bits, root, instance,
            little_endian).value, bits),
    ensures ({
        let consumed = thread_write_consumed_v88_test(source, write);
        let evaluated = invocation_source_byte_evaluate_v36(
            consumed, value, bits, root, instance, little_endian);
        invocation_source_thread_write_v88(source, write, root, instance, little_endian)
            == InvocationSourceThreadWriteResultV88 {
                source: invocation_source_byte_put_local_v36(
                    evaluated.source, write.destination, MemoryValueV30::Scalar(0)),
                observations: invocation_source_observe_effects_v39(
                    invocation_source_read_effect_v36(consumed, value, bits, root,
                        instance, little_endian), consumed, evaluated.source),
            }
    }),
{
    hide(invocation_source_descriptor_reference_current_v51);
    hide(invocation_source_witness_current_v38);
    hide(invocation_source_byte_put_local_v36);
    hide(invocation_source_byte_evaluate_v36);
    hide(invocation_source_byte_value_typed_v36);
    hide(invocation_source_observe_effects_v39);
    hide(invocation_source_read_effect_v36);
}

#[verifier::spinoff_prover]
proof fn thread_write_effect_projection_rejects_substituted_after_state_v88(
    observation: InvocationSourceStatementObservationV36, write: InvocationSourceThreadWriteV88,
    little_endian: bool,
)
    requires
        observation.event == Some(InvocationSourceByteEventV36::ThreadWrite(write)),
        invocation_source_thread_write_v88(observation.before, write, observation.root,
            observation.instance, little_endian).source != observation.after,
    ensures
        invocation_source_statement_effects_v36(observation, little_endian)
            == seq![MemoryOperationEffectV30::Refused],
        invocation_source_statement_observations_v39(observation, little_endian)
            == invocation_source_observe_effects_v39(seq![MemoryOperationEffectV30::Refused],
                observation.before, observation.after),
{
    hide(invocation_source_thread_write_v88);
    hide(invocation_source_observe_effects_v39);
}
