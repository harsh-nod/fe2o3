proof fn execution_rank_is_local_x_fastest_not_launch_rank_v168(execution: MemoryExecutionContextV37)
    requires execution.workgroup == seq![4int, 3int, 2int],
        execution.local == seq![2int, 1int, 1int],
    ensures invocation_source_workgroup_size_v168(execution) == 24,
        invocation_source_workgroup_rank_v168(execution) == 18,
{}

proof fn execution_replacement_invalidates_old_origin_v168(
    source: InvocationSourceByteStateV36, reference: InvocationSourceExecutionReferenceV168,
)
    requires source.logical.versions[reference.origin] != reference.origin_version,
    ensures !invocation_source_execution_record_current_v168(source, reference),
{}

proof fn execution_reference_cannot_escape_its_origin_frame_v168(
    source: InvocationSourceByteStateV36, reference: InvocationSourceExecutionReferenceV168,
)
    requires forall|i: int| 0 <= i < source.machine.frames.active.len() ==>
        source.machine.frames.active[i] != reference.frame,
    ensures !invocation_source_execution_record_current_v168(source, reference),
{}

proof fn execution_unique_copy_is_refused_v168(
    source: InvocationSourceByteStateV36, destination: int, input: int,
    recipe: InvocationSourceExecutionRecipeV168,
)
    requires recipe.mutable,
    ensures invocation_source_execution_step_v168(source,
        InvocationSourceExecutionEventV168::Transfer {
            destination, input, recipe, moved: false }) == invocation_source_byte_refused_v36(source),
{}

proof fn execution_mutual_resident_ancestry_is_refused_v168(
    references: Map<int, InvocationSourceExecutionReferenceV168>, left: int, right: int,
)
    requires references.contains_key(left), references.contains_key(right),
        references[left].ancestors.contains(references[right].identity),
        references[right].ancestors.contains(references[left].identity),
    ensures !invocation_source_execution_ancestry_v168(references),
{
    if invocation_source_execution_ancestry_v168(references) {
        assert(references[right].ancestors.len() < references[left].ancestors.len());
        assert(references[left].ancestors.len() < references[right].ancestors.len());
    }
}

// This is the deliberate conservative boundary until source-authenticated NLL
// end-loan events are implemented. Merely ceasing to read a child does not end it.
proof fn execution_retained_descendant_suspends_unique_parent_v168(
    source: InvocationSourceByteStateV36, parent: int, child: int,
    recipe: InvocationSourceExecutionRecipeV168,
)
    requires source.logical.execution_references.contains_key(parent),
        source.logical.execution_references.contains_key(child),
        source.logical.execution_references[parent].recipe.mutable,
        source.logical.execution_references[parent].identity
            != source.logical.execution_references[child].identity,
        !source.logical.execution_references[parent].ancestors
            .contains(source.logical.execution_references[child].identity),
        invocation_source_execution_same_origin_v168(
            source.logical.execution_references[parent], source.logical.execution_references[child]),
        invocation_source_execution_record_current_v168(source, source.logical.execution_references[child]),
    ensures !invocation_source_execution_reference_current_v168(source, parent, recipe),
{
    if invocation_source_execution_reference_current_v168(source, parent, recipe) {
        assert(!source.logical.execution_references[parent].recipe.mutable);
    }
}

proof fn execution_invalid_workgroup_loan_refuses_before_tile_evaluation_v168(
    source: InvocationSourceByteStateV36, event: InvocationSourceExecutionTileLoadV168,
    root: int, instance: int, little_endian: bool,
)
    requires !invocation_source_execution_operand_valid_v168(source, event.workgroup,
        InvocationSourceExecutionRoleV168::Workgroup, false),
    ensures invocation_source_execution_tile_load_v168(source, event, root, instance, little_endian)
        == invocation_source_tile_refused_v161(source),
{}
