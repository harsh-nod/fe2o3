// Qualification fixtures, not assumptions or production admission. Prepend
// BYTE_MEMORY_V30 inside the same verus! block. These require execution in the
// admitted Verus lane; a host Rust/source-emission test does not prove them.

proof fn relocation_overlap_invalidation_v37(
    cells: Map<int, MemoryRelocationV37>, at: int, start: int, width: int,
)
    requires cells.contains_key(at),
        byte_intervals_overlap_v37(at, cells[at].width, start, width),
    ensures !byte_relocations_without_overlap_v37(cells, start, width).contains_key(at),
{}

proof fn relocation_disjoint_write_preservation_v37(
    cells: Map<int, MemoryRelocationV37>, at: int, start: int, width: int,
)
    requires cells.contains_key(at),
        !byte_intervals_overlap_v37(at, cells[at].width, start, width),
    ensures byte_relocations_without_overlap_v37(cells, start, width).contains_key(at),
        byte_relocations_without_overlap_v37(cells, start, width)[at] == cells[at],
{}

// The octet's value does not participate in invalidation. This includes
// rewriting an equal ordinary octet at the same byte range.
proof fn scalar_overwrite_invalidates_complete_pointer_v37(
    memory: ByteMemoryV30, address: MemoryPointerV30, width: int, value: int,
    little_endian: bool, at: int,
)
    requires byte_memory_well_formed_v30(memory), ordinary_memory_width_v30(width),
        byte_range_live_v30(memory, address, width),
        0 <= value < memory_value_modulus_v30(width),
        memory.live[address.allocation].relocations.contains_key(at),
        byte_intervals_overlap_v37(at, memory.live[address.allocation].relocations[at].width,
            address.byte_offset, width),
    ensures !byte_store_v30(memory, address, width, value, little_endian)
        .live[address.allocation].relocations.contains_key(at),
{}

proof fn deinitialize_invalidates_pointer_and_byte_initialization_v37(
    memory: ByteMemoryV30, address: MemoryPointerV30, width: int, at: int, byte: int,
)
    requires byte_memory_well_formed_v30(memory), byte_range_live_v30(memory, address, width),
        memory.live[address.allocation].relocations.contains_key(at),
        byte_intervals_overlap_v37(at, memory.live[address.allocation].relocations[at].width,
            address.byte_offset, width),
        address.byte_offset <= byte < address.byte_offset + width,
    ensures !byte_deinitialize_v37(memory, address, width)
        .live[address.allocation].relocations.contains_key(at),
        !byte_deinitialize_v37(memory, address, width)
            .live[address.allocation].initialized[byte],
        byte_deinitialize_v37(memory, address, width).live[address.allocation].bytes[byte]
            == memory.live[address.allocation].bytes[byte],
{}

// No non-overlap premise: the equality is against the original source snapshot
// even when source and destination belong to one overlapping allocation.
proof fn object_copy_reads_prestate_tokens_and_padding_v37(
    memory: ByteMemoryV30, source: MemoryPointerV30, destination: MemoryPointerV30,
    width: int, relative: int,
)
    requires byte_memory_well_formed_v30(memory),
        byte_range_live_v30(memory, source, width),
        byte_range_live_v30(memory, destination, width), 0 <= relative < width,
    ensures byte_copy_object_v37(memory, source, destination, width)
        .live[destination.allocation].bytes[destination.byte_offset + relative]
            == memory.live[source.allocation].bytes[source.byte_offset + relative],
        byte_copy_object_v37(memory, source, destination, width)
            .live[destination.allocation].initialized[destination.byte_offset + relative]
            == memory.live[source.allocation].initialized[source.byte_offset + relative],
{}

proof fn partial_pointer_copy_never_publishes_complete_cell_v37(
    memory: ByteMemoryV30, source: MemoryPointerV30, destination: MemoryPointerV30,
    width: int,
)
    requires byte_memory_well_formed_v30(memory),
        byte_range_live_v30(memory, source, width), byte_range_live_v30(memory, destination, width),
        0 < width,
        memory.live[source.allocation].relocations.contains_key(source.byte_offset),
        width < memory.live[source.allocation].relocations[source.byte_offset].width,
    ensures !byte_copy_object_v37(memory, source, destination, width)
        .live[destination.allocation].relocations.contains_key(destination.byte_offset),
{}

proof fn complete_pointer_copy_preserves_width_endian_and_nominal_payload_v37(
    memory: ByteMemoryV30, source: MemoryPointerV30, destination: MemoryPointerV30,
    width: int,
)
    requires byte_memory_well_formed_v30(memory),
        byte_range_live_v30(memory, source, width), byte_range_live_v30(memory, destination, width),
        memory.live[source.allocation].relocations.contains_key(source.byte_offset),
        0 < memory.live[source.allocation].relocations[source.byte_offset].width <= width,
    ensures byte_copy_object_v37(memory, source, destination, width)
        .live[destination.allocation].relocations.contains_key(destination.byte_offset),
        byte_copy_object_v37(memory, source, destination, width)
            .live[destination.allocation].relocations[destination.byte_offset]
            == memory.live[source.allocation].relocations[source.byte_offset],
{}

proof fn object_copy_refuses_ended_allocation_or_out_of_bounds_v37(
    memory: ByteMemoryV30, source: MemoryPointerV30, destination: MemoryPointerV30,
    width: int, source_alignment: int, destination_alignment: int, nonoverlapping: bool,
)
    requires !byte_range_live_v30(memory, source, width)
        || !byte_range_live_v30(memory, destination, width),
    ensures !byte_copy_object_valid_v37(memory, source, destination, width,
        source_alignment, destination_alignment, nonoverlapping),
{}

proof fn nonoverlapping_copy_refuses_actual_same_allocation_overlap_v37(
    memory: ByteMemoryV30, source: MemoryPointerV30, destination: MemoryPointerV30,
    width: int, source_alignment: int, destination_alignment: int,
)
    requires source.allocation == destination.allocation,
        byte_intervals_overlap_v37(source.byte_offset, width, destination.byte_offset, width),
    ensures !byte_copy_object_valid_v37(memory, source, destination, width,
        source_alignment, destination_alignment, true),
{}

proof fn ended_generation_is_not_revived_by_other_live_generations_v37(
    memory: ByteMemoryV30, address: MemoryPointerV30, width: int,
)
    ensures !byte_range_live_v30(byte_end_lifetime_v30(memory, address.allocation), address, width),
{}
