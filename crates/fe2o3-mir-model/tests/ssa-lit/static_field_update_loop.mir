// RUN: fe2o3-mir-ssa-lit %s
// EXPECT: PASS
// CHECK: block b1 live=[v0] merge=[v0] transport=[v0]
// CHECK: event 0 use v0=b1.v0
// CHECK: event 1 def v0=d1
// CHECK: edge e1:0 role=r1 target=b1 defines=[] args=[v0=d1]
// The updated whole-holder version, not its predecessor, flows on the latch.

entry b0
variables v0
entry-def v0
block b0
edge r1 b1
block b1
use v0
def v0
edge r1 b1
edge r2 b2
block b2
use v0
