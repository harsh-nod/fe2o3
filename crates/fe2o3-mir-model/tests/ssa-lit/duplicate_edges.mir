// RUN: fe2o3-mir-ssa-lit %s
// EXPECT: PASS
// CHECK: edge e0:0 role=r1 target=b1 defines=[] args=[]
// CHECK: edge e0:1 role=r2 target=b1 defines=[] args=[]
// CHECK: block b1 live=[v0] merge=[] transport=[]
// CHECK: event 0 use v0=d0
