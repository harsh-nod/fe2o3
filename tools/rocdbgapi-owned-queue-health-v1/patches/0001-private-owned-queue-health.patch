+#ifndef AMD_DBGAPI_QUEUE_H
+#define AMD_DBGAPI_QUEUE_H 1
+
+#include "amd-dbgapi.h"
+#include "architecture.h"
+#include "debug.h"
+#include "dispatch.h"
+#include "handle_object.h"
+#include "memory.h"
+#include "os_driver.h"
