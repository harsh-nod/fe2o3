+amd_dbgapi_os_queue_type_t
+unsupported_queue_t::type () const
+{
+  switch (m_os_queue_info.queue_type)
+    {
+    case os_queue_type_t::compute:
+      return AMD_DBGAPI_OS_QUEUE_TYPE_AMD_PM4;
