+    return AMD_DBGAPI_STATUS_ERROR;
+  }
+
+  amd_dbgapi_status_t set_wave_launch_trap_override (
+    os_wave_launch_trap_override_t /* override  */,
+    os_wave_launch_trap_mask_t /* trap_mask  */,
