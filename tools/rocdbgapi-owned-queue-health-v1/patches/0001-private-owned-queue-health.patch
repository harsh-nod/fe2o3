+struct os_agent_info_t
+{
+  /* Agent Id assigned by the driver.  */
+  os_agent_id_t os_agent_id{};
+  /* Public name of the "device".  */
+  std::string name{};
+  /* The graphics IP version {major, minor, stepping}.  */
+  std::array<unsigned, 3> gfxip{};
