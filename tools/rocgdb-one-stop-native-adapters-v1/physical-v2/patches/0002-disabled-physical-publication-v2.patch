+        || !field ("p",static_cast<unsigned> (row.state)) || !field ("pid",id.pid)
+        || !field ("i",id.inferior_number) || !field ("a",id.process)
+        || !field ("t",id.host_thread) || !field ("start",id.pid_start)) return false;
