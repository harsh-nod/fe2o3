+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Compile-candidate safety gate. No environment, command argument, JSON,
+   token, receipt or caller pointer can change this source-level refusal.
+   A separately reviewed source revision is required even to attempt arming. */
+#ifndef GDB_AMD_DBGAPI_ONE_STOP_ACTIVATION_V1_H
+#define GDB_AMD_DBGAPI_ONE_STOP_ACTIVATION_V1_H
+namespace amd_owned_one_stop_v1 {
+constexpr bool selection_available () noexcept { return false; }
+static_assert (!selection_available (), "first adapter is compile-only");
+}
+#endif
diff --git a/gdb/amd-dbgapi-one-stop-checkpoint-v1.h b/gdb/amd-dbgapi-one-stop-checkpoint-v1.h
--- /dev/null
+++ b/gdb/amd-dbgapi-one-stop-checkpoint-v1.h
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Exact frozen 776-byte target checkpoint codec. Parsing yields inert facts,
+   not a queue handle, permission or source provenance. No dynamic allocation. */
+#ifndef GDB_AMD_DBGAPI_ONE_STOP_CHECKPOINT_V1_H
+#define GDB_AMD_DBGAPI_ONE_STOP_CHECKPOINT_V1_H
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+namespace amd_owned_one_stop_v1 {
+using checkpoint_bytes = std::array<std::uint8_t, 776>;
+using digest_bytes = std::array<std::uint8_t, 32>;
+inline constexpr digest_bytes fixed_object_sha {{
+  0xcd,0x3d,0xaa,0xb7,0x6d,0xb3,0x47,0x10,0x41,0x66,0xc8,0x98,0xa5,0x8d,0xcc,0x29,
+  0xc1,0x97,0xee,0x1e,0xac,0x8b,0x25,0x8b,0x10,0xa2,0xc7,0x93,0xe8,0x77,0x9c,0x87
+}};
+inline constexpr digest_bytes fixed_source_sha {{
+  0xe5,0x67,0xe9,0xb4,0x14,0xf0,0x08,0x22,0xfb,0xf6,0x43,0x69,0x84,0xa4,0x52,0xd9,
+  0x94,0x06,0x30,0xec,0xce,0xc4,0x0a,0x0e,0x86,0xb2,0xc5,0xc1,0x91,0x59,0x80,0x17
+}};
+/* Actual fixed object's zero-filled 12288-byte image, using the three
+   independently checked target-loader segments. NOT the original ELF digest. */
+inline constexpr digest_bytes fixed_image_sha {{
+  0x2b,0x3a,0xe7,0xaa,0xfb,0x41,0x9b,0xf6,0x58,0x2b,0x72,0xaa,0x8a,0xf2,0x2f,0x46,
+  0x85,0xa8,0xa4,0xf6,0x81,0x1c,0x30,0x5c,0xdd,0xfe,0x5a,0x1f,0x84,0x21,0xfe,0xc6
+}};
+inline constexpr digest_bytes fixed_trap_sha {{
+  0x4f,0xfe,0xa8,0x93,0xee,0x53,0xe0,0x18,0xa6,0x29,0xc1,0x92,0x54,0x85,0x57,0x21,
+  0x88,0x24,0x44,0x51,0x71,0x55,0x25,0x1f,0x1f,0x45,0xdd,0x35,0x19,0xbc,0x81,0xfe
+}};
+inline bool checked_sum (std::uint64_t a, std::uint64_t b, std::uint64_t &out) noexcept {
+  if (b > std::numeric_limits<std::uint64_t>::max () - a) return false;
+  out = a + b; return true;
+}
+/* CODE_OBJECT_INFO_LOAD_ADDRESS is ptrdiff_t signed relocation bias.
+   Never cast a negative bias to an unsigned base before checked arithmetic. */
+inline bool apply_bias (std::uint64_t value, std::int64_t bias, std::uint64_t &out) noexcept {
+  if (bias >= 0) return checked_sum (value, static_cast<std::uint64_t> (bias), out);
+  const auto magnitude = static_cast<std::uint64_t> (-(bias + 1)) + 1;
+  if (value < magnitude) return false;
+  out = value - magnitude; return true;
+}
+class checkpoint_view {
+public:
+  explicit checkpoint_view (const checkpoint_bytes &bytes) noexcept : b (bytes) {}
+  std::uint64_t u64 (std::size_t offset) const noexcept {
+    if (offset > b.size () - 8) return 0;
+    std::uint64_t v = 0;
+    for (unsigned n = 0; n != 8; ++n) v |= std::uint64_t (b[offset+n]) << (8*n);
+    return v;
+  }
+  std::uint32_t u32 (std::size_t offset) const noexcept {
+    if (offset > b.size () - 4) return 0;
+    std::uint32_t v = 0;
+    for (unsigned n = 0; n != 4; ++n) v |= std::uint32_t (b[offset+n]) << (8*n);
+    return v;
+  }
+  std::uint16_t u16 (std::size_t offset) const noexcept {
+    if (offset > b.size () - 2) return 0;
+    return std::uint16_t (b[offset]) | (std::uint16_t (b[offset+1]) << 8);
+  }
+  bool digest_at (std::size_t at, const digest_bytes &expected) const noexcept {
+    if (at > b.size () - expected.size ()) return false;
+    for (std::size_t n = 0; n != expected.size (); ++n)
+      if (b[at+n] != expected[n]) return false;
+    return true;
+  }
+  bool valid (std::uint64_t actual_pid) const noexcept {
+    constexpr std::array<std::uint8_t, 8> magic {{'F','3','G','S','T','P','0','1'}};
+    for (std::size_t n = 0; n != magic.size (); ++n) if (b[n] != magic[n]) return false;
+    if (u32 (8) != 1 || u32 (12) != 776 || actual_pid == 0
+        || actual_pid > std::numeric_limits<std::uint32_t>::max ()
+        || u32 (16) != actual_pid || u32 (24) != 39903
+        || u64 (32) != UINT64_C (16366993098680759275)
+        || u64 (40) != 0 || u64 (48) != 0 || u64 (64) != 12288
+        || u64 (96) != 8388608 || u64 (152) != 264
+        || u64 (168) != 272 || u64 (176) != 4096 || u64 (192) != 256
+        || u64 (208) != 4096 || u64 (216) == 0 || (u64 (216) & 7) != 0
+        || u64 (232) != 181829632 || u64 (248) != 4096)
+      return false;
+    std::uint64_t descriptor = 0, entry = 0, write = 0, read = 0, value = 0, output = 0;
+    if (!checked_sum (u64 (56), 1984, descriptor) || descriptor != u64 (72)
+        || !checked_sum (u64 (56), 6144, entry) || entry != u64 (80)
+        || !checked_sum (u64 (104), 0x38, write) || write != u64 (112)
+        || !checked_sum (u64 (104), 0x80, read) || read != u64 (120)
+        || !checked_sum (u64 (128), 8, value) || value != u64 (136)
+        || !checked_sum (u64 (160), 8, output) || output != u64 (184)) return false;
+    const std::array<std::array<std::uint64_t, 2>, 9> ranges {{
+      {{u64 (56), 12288}}, {{u64 (88), 8388608}}, {{u64 (104), 4096}},
+      {{u64 (128), 4096}}, {{u64 (144), 65536}}, {{u64 (160), 4096}},
+      {{u64 (200), 4096}}, {{u64 (224), 181829632}}, {{u64 (240), 4096}}
+    }};
+    for (std::size_t n = 0; n != ranges.size (); ++n) {
+      std::uint64_t end = 0;
+      if (ranges[n][0] == 0 || (ranges[n][0] & 4095) != 0
+          || !checked_sum (ranges[n][0], ranges[n][1], end)) return false;
+      for (std::size_t p = 0; p < n; ++p) {
+        std::uint64_t previous_end = 0;
+        if (!checked_sum (ranges[p][0], ranges[p][1], previous_end)
+            || !(end <= ranges[p][0] || previous_end <= ranges[n][0])) return false;
+      }
+    }
+    if (!digest_at (256, fixed_object_sha) || !digest_at (288, fixed_source_sha)
+        || !digest_at (320, fixed_image_sha) || !digest_at (352, fixed_trap_sha))
+      return false;
+    // Retain/requery the actual target's closure digest. This nonzero check
+    // does NOT independently recompute the Rust loader's identity algorithm.
+    bool closure_nonzero = false;
+    for (std::size_t n = 384; n != 416; ++n) closure_nonzero |= b[n] != 0;
+    if (!closure_nonzero) return false;
+    for (std::size_t n = 744; n != 776; ++n) if (b[n] != 0) return false;
+    return packet_valid () && kernarg_valid ();
+  }
+  bool packet_valid () const noexcept {
+    constexpr std::size_t p = 416;
+    return u32 (p) == 0x00010001 && u16 (p+4) == 64 && u16 (p+6) == 1
+      && u16 (p+8) == 1 && u16 (p+10) == 0 && u32 (p+12) == 64
+      && u32 (p+16) == 1 && u32 (p+20) == 1 && u32 (p+24) == 0
+      && u32 (p+28) == 0 && u64 (p+32) == u64 (72)
+      && u64 (p+40) == u64 (144) && u64 (p+48) == 0
+      && u64 (p+56) == u64 (128); // packet signal BASE, never value+8.
+  }
+  bool kernarg_valid () const noexcept {
+    for (std::size_t n = 0; n != 264; ++n) {
+      std::uint8_t expected = 0;
+      if (n < 8) expected = static_cast<std::uint8_t> (u64 (184) >> (8*n));
+      else if (n == 8 || n == 12 || n == 16 || n == 22 || n == 24 || n == 72) expected = 1;
+      else if (n == 20) expected = 64;
+      if (b[480+n] != expected) return false;
+    }
+    return true;
+  }
+private:
+  const checkpoint_bytes &b;
+};
+} // namespace amd_owned_one_stop_v1
+#endif
diff --git a/gdb/amd-dbgapi-one-stop-locator-v1.h b/gdb/amd-dbgapi-one-stop-locator-v1.h
--- /dev/null
+++ b/gdb/amd-dbgapi-one-stop-locator-v1.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Exact retained Rust memory locator grammar, not an address capability. */
+#ifndef GDB_AMD_DBGAPI_ONE_STOP_LOCATOR_V1_H
+#define GDB_AMD_DBGAPI_ONE_STOP_LOCATOR_V1_H
+#include <cstddef>
+#include <cstdint>
+namespace amd_owned_one_stop_v1 {
+inline bool fixed_memory_locator (const char *text,std::size_t bytes,
+                                  std::uint64_t pid,std::uint64_t &address) noexcept {
+  if (!text || bytes<34 || bytes>128 || text[bytes-1]!=0 || !pid) return false;
+  std::size_t at=0;
+  auto literal=[&] (const char *s) {
+    for (std::size_t n=0;s[n];++n) {
+      if (at>=bytes-1 || text[at++]!=s[n]) return false;
+    }
+    return true;
+  };
+  auto number=[&] (unsigned base,std::uint64_t &out) {
+    const auto start=at; out=0;
+    while (at<bytes-1) {
+      const char c=text[at]; unsigned digit=base;
+      if (c>='0' && c<='9') digit=static_cast<unsigned> (c-'0');
+      else if (base==16 && c>='a' && c<='f') digit=10+static_cast<unsigned> (c-'a');
+      if (digit>=base) break;
+      if (out>(UINT64_MAX-digit)/base) return false;
+      out=out*base+digit; ++at;
+    }
+    return at>start && !(at-start>1 && text[start]=='0');
+  };
+  std::uint64_t actual_pid=0,actual_address=0,actual_size=0;
+  if (!literal ("memory://") || !number (10,actual_pid) || actual_pid!=pid
+      || !literal ("#offset=0x") || !number (16,actual_address) || !actual_address
+      || !literal ("&size=") || !number (10,actual_size) || actual_size!=5312
+      || at!=bytes-1 || actual_address>UINT64_MAX-actual_size) return false;
+  address=actual_address; return true;
+}
+}
+#endif
diff --git a/gdb/amd-dbgapi-one-stop-native-events-v1.inc b/gdb/amd-dbgapi-one-stop-native-events-v1.inc
--- /dev/null
+++ b/gdb/amd-dbgapi-one-stop-native-events-v1.inc
@@ -0,0 +1,185 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Called solely at the existing client's actual callback/sole-ACK sites.
+   No synthetic event, second ACK or serialized owner construction. */
+namespace amd_owned_one_stop_v1 {
+void native_adapter::callback_begin (amd_dbgapi_inferior_info &actual,breakpoint *bp,
+                                    amd_dbgapi_breakpoint_id_t id,thread_info *thread) {
+  if (!selected ()) return;
+  require (&actual==&info () && thread==m_host && thread==inferior_thread ()
+           && m_path==path::none && m_callback_progress==callback_progress::none
+           && bp!=nullptr && bp->pspace==m_inferior->pspace
+           && bp->has_single_location () && bp->disposition==disp_donttouch,
+           failure::callback_identity);
+  const auto found=actual.breakpoint_map.find (id.handle);
+  require (found!=actual.breakpoint_map.end () && found->second==bp
+           && bp->first_loc ().pspace==m_inferior->pspace
+           && bp->first_loc ().address!=0
+           && regcache_read_pc (get_thread_regcache (thread))==bp->first_loc ().address,
+           failure::callback_identity);
+  const auto object=reinterpret_cast<std::uintptr_t> (bp);
+  if (m_callback_object==0) {
+    require (m_owner.state ()==phase::host_running,failure::callback_identity);
+    m_callback_object=object; m_callback_pc=bp->first_loc ().address;
+    m_callback_number=static_cast<std::uint64_t> (bp->number);
+  } else {
+    require (object==m_callback_object && bp->first_loc ().address==m_callback_pc
+             && static_cast<std::uint64_t> (bp->number)==m_callback_number,
+             failure::callback_identity);
+  }
+  if (m_owner.state ()==phase::awaiting_target_completion) {
+    read_runtime_root (m_owner.m_root_address);
+    require (m_root_read.breakpoint==m_callback_pc
+             && m_owner.terminal_callback_begin
+                  (current_identity (),object,id.handle,thread->global_num,
+                   m_owner.m_root_address,m_root_read),failure::callback_identity);
+  } else {
+    require (m_owner.callback_begin (current_identity (),object,id.handle,thread->global_num),
+             failure::callback_identity);
+  }
+}
+void native_adapter::callback_end (amd_dbgapi_inferior_info &actual,breakpoint *bp,
+                                  amd_dbgapi_breakpoint_id_t id,thread_info *thread,
+                                  amd_dbgapi_event_id_t event,amd_dbgapi_breakpoint_action_t action,
+                                  amd_dbgapi_status_t status) {
+  if (!selected ()) return;
+  require (&actual==&info () && thread==m_host && bp!=nullptr
+           && reinterpret_cast<std::uintptr_t> (bp)==m_callback_object
+           && bp->has_single_location () && bp->first_loc ().address==m_callback_pc,
+           failure::callback_identity);
+  const auto actual_owner=current_identity ();
+  const bool accepted=m_owner.state ()==phase::awaiting_target_completion
+    ? m_owner.terminal_callback_complete (actual_owner,m_callback_object,id.handle,
+                                          thread->global_num,event.handle,action,status)
+    : m_owner.callback_complete (actual_owner,m_callback_object,id.handle,
+                                 thread->global_num,event.handle,action,status);
+  require (accepted,failure::callback_identity);
+  m_callback_progress=callback_progress::step_ready;
+  // This admits no effect here. Actual infrun/target fences still consume the
+  // one precisely identified internal host step and subsequent continuation.
+  flush ();
+}
+void native_adapter::runtime_ack (amd_dbgapi_inferior_info &actual,amd_dbgapi_event_id_t event,
+                                 amd_dbgapi_runtime_state_t state,amd_dbgapi_status_t status) {
+  if (!selected ()) return;
+  require (&actual==&info () && actual.runtime_state==state
+           && m_path==path::none && m_callback_progress==callback_progress::none,
+           failure::owner_changed);
+  if (state==AMD_DBGAPI_RUNTIME_STATE_LOADED_SUCCESS) {
+    require (m_owner.runtime_loaded (current_identity (),event.handle,status),failure::acknowledgement);
+  } else if (state==AMD_DBGAPI_RUNTIME_STATE_UNLOADED) {
+    require (m_owner.runtime_unloaded (current_identity (),event.handle,status),failure::acknowledgement);
+  } else reject (failure::native_result);
+  flush ();
+}
+void native_adapter::objects_ack (amd_dbgapi_inferior_info &actual,amd_dbgapi_event_id_t event,
+                                 amd_dbgapi_status_t status) {
+  if (!selected ()) return;
+  require (&actual==&info (),failure::owner_changed);
+  if (m_owner.state ()==phase::awaiting_target_completion) {
+    require (m_owner.terminal_object_completed (current_identity (),event.handle,status),
+             failure::acknowledgement);
+  } else {
+    require (m_origin_pending && !m_origin_complete
+             && m_owner.code_object_completed (current_identity (),event.handle,m_object.handle,status),
+             failure::acknowledgement);
+    m_origin_pending=false; m_origin_complete=true;
+  }
+}
+void native_adapter::wave_ack (amd_dbgapi_inferior_info &actual,amd_dbgapi_event_id_t event,
+                              thread_info *thread,amd_dbgapi_status_t status) {
+  if (!selected ()) return;
+  require (&actual==&info () && thread!=nullptr && status==AMD_DBGAPI_STATUS_SUCCESS
+           && m_gpu_thread==nullptr && m_owner.state ()==phase::awaiting_gpu_stop
+           && m_path==path::none,failure::stop_changed);
+  // THREAD came from the actual handled WAVE_STOP before its sole ACK.
+  // Never query the event handle after ACK, when the native event is invalid.
+  m_candidate_stop=query_stop (thread,false);
+  require (m_owner.stopped_after_ack (current_identity (),event.handle,m_candidate_stop,status),
+           failure::stop_changed);
+  m_gpu_thread=thread; m_gpu_thread_ref=thread_info_ref::new_reference (thread);
+  // No diagnostic output until actual MI stop and post-auto-delete safe point.
+}
+void native_adapter::after_host_or_gpu_stop (thread_info *thread) {
+  if (!selected ()) return;
+  if (m_owner.state ()==phase::lifecycle_disappeared && thread==nullptr) return;
+  // Lifecycle disappearance is not a claim that the separate MI exit was normal.
+  require (thread!=nullptr && thread==inferior_thread (),failure::stop_changed);
+  if (m_owner.state ()==phase::provisional_checkpoint) {
+    require (thread==m_host
+             && m_owner.host_stop_output_completed
+                  (current_identity (),regcache_read_pc (get_thread_regcache (thread))),
+             failure::checkpoint_changed);
+  } else if (m_owner.state ()==phase::provisional_gpu_stop) {
+    require (thread==m_gpu_thread,failure::stop_changed);
+    m_candidate_stop=query_stop (thread,true);
+    require (m_owner.gpu_stop_output_completed (current_identity (),m_candidate_stop),
+             failure::stop_changed);
+  } else reject (failure::order);
+  // MI *stopped alone never means checkpoint retirement. Do not flush here.
+}
+void native_adapter::deleting_breakpoint (breakpoint *bp) {
+  if (!selected () || m_owner.invalid ()) return;
+  if (bp==m_breakpoint) {
+    const auto object=reinterpret_cast<std::uintptr_t> (bp);
+    const auto number=static_cast<std::uint64_t> (bp->number);
+    require (m_owner.deleting_breakpoint (object,number),failure::breakpoint_changed);
+    m_breakpoint=nullptr; // Observer precedes deletion; never dereference it later.
+    return;
+  }
+  if (reinterpret_cast<std::uintptr_t> (bp)==m_callback_object) {
+    require (m_owner.state ()==phase::awaiting_target_completion && !m_owner.m_callback
+             && m_owner.m_terminal==owner::terminal_stage::withdrawal_complete
+             && m_callback_progress==callback_progress::none,
+             failure::breakpoint_changed);
+    // This notification is not a retirement proof and grants no further resume.
+    return;
+  }
+  reject (failure::breakpoint_changed);
+}
+void native_adapter::after_auto_delete () {
+  if (!selected ()) return;
+  if (m_owner.state ()==phase::provisional_checkpoint) {
+    require (m_breakpoint==nullptr && inferior_thread ()==m_host,
+             failure::retirement_incomplete);
+    std::size_t objects=0,locations=0,count=0;
+    for (auto &bp : all_breakpoints ()) {
+      debit (counter::work,1);
+      require (++count<=64,failure::budget);
+      if (reinterpret_cast<std::uintptr_t> (&bp)==m_breakpoint_identity) ++objects;
+    }
+    count=0;
+    for (auto &location : all_bp_locations ()) {
+      debit (counter::work,1); require (++count<=64,failure::budget);
+      if (location->pspace==m_inferior->pspace && location->address==m_checkpoint_pc) ++locations;
+    }
+    require (m_owner.retirement_finished (current_identity (),
+               regcache_read_pc (get_thread_regcache (m_host)),objects,locations),
+             failure::retirement_incomplete);
+  } else {
+    require (m_owner.state ()==phase::current_gpu_stop && inferior_thread ()==m_gpu_thread,
+             failure::stop_changed);
+    m_stop_retired=true;
+  }
+  flush (); // After actual breakpoint_auto_delete has fully returned.
+}
+void native_adapter::disappearing (inferior *actual) {
+  if (!selected () || m_owner.invalid ()) return;
+  // exit_inferior clears threads before this observer, but has not cleared PID.
+  // Retained strong references prevent address reuse; do not pretend a live
+  // stopped host thread still exists or query target memory here.
+  const bool same_owner=actual==m_inferior && m_info!=nullptr
+    && amd_dbgapi_inferior_data.get (actual)==m_info && m_info->inf==actual
+    && actual->pspace==reinterpret_cast<program_space *> (m_owner.m_identity.program_space)
+    && actual->num==static_cast<int> (m_owner.m_identity.inferior_number)
+    && actual->pid==static_cast<int> (m_owner.m_identity.pid)
+    && m_info->process_id.handle==m_owner.m_identity.process
+    && m_inferior_ref.get ()==actual && m_host_ref.get ()==m_host;
+  if (!same_owner || !m_owner.lifecycle_disappeared (m_owner.m_identity)) {
+    m_owner.poison (failure::lifecycle);
+    return; // Never interrupt ordinary known-owner teardown with a thrown error.
+  }
+  flush ();
+}
+void native_adapter::invalidate (failure why) { if (selected ()) m_owner.poison (why); }
+void native_adapter::native_unwind () noexcept { if (selected ()) m_owner.poison (failure::native_result); }
+} // namespace amd_owned_one_stop_v1
diff --git a/gdb/amd-dbgapi-one-stop-native-io-v1.inc b/gdb/amd-dbgapi-one-stop-native-io-v1.inc
--- /dev/null
+++ b/gdb/amd-dbgapi-one-stop-native-io-v1.inc
@@ -0,0 +1,155 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Concrete same-client target/file I/O and bounded allocator adapters.
+   Included after the existing real target/inferior definitions. */
+namespace amd_owned_one_stop_v1 {
+native_adapter &native_adapter::instance () noexcept {
+  static native_adapter retained;
+  return retained;
+}
+[[noreturn]] void native_adapter::reject (failure why) {
+  m_owner.poison (why);
+  error (_("fixed owned one-stop native relation refused (%u)"),
+         static_cast<unsigned> (m_owner.why ()));
+}
+void native_adapter::require (bool yes, failure why) {
+  if (!yes || m_owner.invalid ()) reject (why);
+}
+void native_adapter::debit (counter kind, std::uint64_t amount) {
+  if (!m_owner.debit (kind, amount)) reject (failure::budget);
+}
+void native_adapter::api () { debit (counter::api,1); debit (counter::work,8); }
+void native_adapter::read (std::uint64_t address, std::uint8_t *out, std::size_t bytes) {
+  require (m_inferior != nullptr && current_inferior () == m_inferior
+           && bytes != 0 && out != nullptr && address != 0
+           && bytes <= 776 && address <= UINT64_MAX-bytes, failure::owner_changed);
+  debit (counter::read_calls,1); debit (counter::read_bytes,bytes);
+  if (target_read_memory (address,out,bytes) != 0) reject (failure::native_result);
+}
+void native_adapter::hash_input (const std::uint8_t *bytes, std::size_t count, bool file) {
+  std::uint64_t blocks=0;
+  require (count<=256 && m_hash.input_blocks (count,blocks),failure::budget);
+  if (file) debit (counter::file_rounds,blocks*64);
+  else { debit (counter::work,count); debit (counter::work,blocks*64); }
+  require (m_hash.update (bytes,count),failure::budget);
+}
+void native_adapter::hash_finish (const digest_bytes &expected, bool file) {
+  debit (file ? counter::file_rounds : counter::work,m_hash.finish_blocks ()*64);
+  require (m_hash.finish (m_digest) && m_digest==expected,failure::checkpoint_changed);
+}
+void native_adapter::hash_inferior (std::uint64_t address, std::uint64_t bytes,
+                                   const digest_bytes &expected) {
+  require (bytes==5312 || bytes==12288 || bytes==4096,failure::checkpoint_changed);
+  m_hash=sha256 {}; // Fresh digest only; the owning resource ledger never resets.
+  for (std::uint64_t at=0;at<bytes;) {
+    const auto n=static_cast<std::size_t> (std::min<std::uint64_t> (256,bytes-at));
+    std::uint64_t current=0;
+    require (checked_sum (address,at,current),failure::checkpoint_changed);
+    read (current,m_work.image_chunk.data (),n);
+    hash_input (m_work.image_chunk.data (),n,false); at+=n;
+  }
+  hash_finish (expected,false);
+}
+void native_adapter::read_u64 (std::uint64_t address, std::uint64_t &value) {
+  read (address,m_work.image_chunk.data (),8); debit (counter::work,8); value=0;
+  for (unsigned n=0;n!=8;++n) value|=std::uint64_t (m_work.image_chunk[n])<<(8*n);
+}
+void native_adapter::hash_executable () {
+  require (m_exec_fd>=0 && m_file_passes<2,failure::checkpoint_changed);
+  ++m_file_passes; // Consume before lseek/read: any outcome cannot retry.
+  struct stat before {},after {};
+  require (::fstat (m_exec_fd,&before)==0 && S_ISREG (before.st_mode)
+           && before.st_size==static_cast<off_t> (target_bytes)
+           && before.st_dev==m_exec_identity.st_dev && before.st_ino==m_exec_identity.st_ino
+           && before.st_size==m_exec_identity.st_size
+           && before.st_mtim.tv_sec==m_exec_identity.st_mtim.tv_sec
+           && before.st_mtim.tv_nsec==m_exec_identity.st_mtim.tv_nsec
+           && before.st_ctim.tv_sec==m_exec_identity.st_ctim.tv_sec
+           && before.st_ctim.tv_nsec==m_exec_identity.st_ctim.tv_nsec,
+           failure::checkpoint_changed);
+  require (::lseek (m_exec_fd,0,SEEK_SET)==0,failure::native_result);
+  m_hash=sha256 {};
+  for (std::uint64_t at=0;at<target_bytes;) {
+    const auto n=static_cast<std::size_t> (std::min<std::uint64_t> (256,target_bytes-at));
+    debit (counter::file_requested_bytes,n);
+    const auto got=::read (m_exec_fd,m_work.image_chunk.data (),n);
+    if (got>0) debit (counter::file_observed_bytes,static_cast<std::uint64_t> (got));
+    require (got==static_cast<ssize_t> (n),failure::native_result); // No EINTR/short-read retry.
+    hash_input (m_work.image_chunk.data (),n,true); at+=n;
+  }
+  debit (counter::file_requested_bytes,1);
+  const auto eof=::read (m_exec_fd,m_work.image_chunk.data (),1);
+  if (eof>0) debit (counter::file_probe_bytes,static_cast<std::uint64_t> (eof));
+  require (eof==0,failure::checkpoint_changed);
+  hash_finish (target_sha,true);
+  require (::fstat (m_exec_fd,&after)==0 && after.st_dev==before.st_dev
+           && after.st_ino==before.st_ino && after.st_size==before.st_size
+           && after.st_mtim.tv_sec==before.st_mtim.tv_sec
+           && after.st_mtim.tv_nsec==before.st_mtim.tv_nsec
+           && after.st_ctim.tv_sec==before.st_ctim.tv_sec
+           && after.st_ctim.tv_nsec==before.st_ctim.tv_nsec,
+           failure::checkpoint_changed);
+}
+void *native_adapter::allocate_client (std::size_t bytes) {
+  if (!m_query_output) {
+    if (m_owner.selected () && (m_owner.invalid () || m_owner.state ()==phase::disabled)) {
+      m_owner.poison (failure::allocation); return nullptr;
+    }
+    return ::malloc (bytes); // Unselected/ordinary baseline calls unchanged.
+  }
+  if (m_in_allocate || !m_owner.request_client_output (bytes)) {
+    m_owner.poison (failure::allocation); return nullptr;
+  }
+  if (m_owner.m_allocation_empty) return nullptr; // Exact size0 callback; never malloc(0).
+  m_in_allocate=true;
+  void *const result=::malloc (bytes);
+  m_in_allocate=false;
+  if (!m_owner.client_output_allocated (reinterpret_cast<std::uintptr_t> (result))) {
+    if (result) ::free (result);
+    return nullptr;
+  }
+  return result;
+}
+void native_adapter::deallocate_client (void *pointer) {
+  if (!m_query_output) { ::free (pointer); return; }
+  if (pointer==nullptr) return; // No-op, never an object identity or release witness.
+  if (m_owner.releasing_client_output (reinterpret_cast<std::uintptr_t> (pointer)))
+    ::free (pointer);
+  else m_owner.poison (failure::allocation);
+}
+void native_adapter::client_scope_failed () noexcept {
+  // Only this exact allocation may be freed after a failed/throwing call.
+  if (m_owner.m_allocation_pointer) {
+    auto *p=reinterpret_cast<void *> (m_owner.m_allocation_pointer);
+    if (m_owner.releasing_client_output (m_owner.m_allocation_pointer)) ::free (p);
+  }
+  m_query_output=false; m_in_allocate=false;
+}
+template<typename Handle,typename Call>
+Handle native_adapter::list_one (Call call) {
+  static_assert (sizeof (Handle)==8,"fixed installed native handle width");
+  require (!m_query_output && m_owner.begin_client_output (sizeof (Handle)),failure::allocation);
+  m_query_output=true;
+  try {
+    std::size_t count=0; Handle *rows=nullptr;
+    api ();
+    const auto status=call (&count,&rows); // Actual API allocates only through guarded callback.
+    require (count==1 && rows!=nullptr
+             && m_owner.client_output_returned (reinterpret_cast<std::uintptr_t> (rows),
+                                                sizeof (Handle),status),
+             failure::allocation);
+    const Handle only=*rows;
+    require (only.handle!=0,failure::owner_changed);
+    require (m_owner.releasing_client_output (reinterpret_cast<std::uintptr_t> (rows)),
+             failure::allocation);
+    ::free (rows); m_query_output=false; return only;
+  } catch (...) { m_owner.poison (failure::native_result); client_scope_failed (); throw; }
+}
+template<typename Get,typename Id,typename Query,typename Value>
+void native_adapter::query (Get get,Id id,Query query,Value &value) {
+  static_assert (std::is_trivially_copyable<Value>::value,"fixed scalar query output");
+  static_assert (sizeof (Value)<=24,"closed fixed scalar query roster");
+  api ();
+  const auto status=get (id,query,sizeof (value),&value);
+  require (status==AMD_DBGAPI_STATUS_SUCCESS,failure::native_result);
+}
+}
diff --git a/gdb/amd-dbgapi-one-stop-native-object-v1.inc b/gdb/amd-dbgapi-one-stop-native-object-v1.inc
--- /dev/null
+++ b/gdb/amd-dbgapi-one-stop-native-object-v1.inc
@@ -0,0 +1,140 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Native object identities originate only in this actual same-client list and
+   scalar query sequence. Its output remains borrowed in-process solib data. */
+namespace amd_owned_one_stop_v1 {
+bool native_adapter::selected_object (amd_dbgapi_inferior_info &actual,
+                                     amd_dbgapi_code_object_id_t &object,
+                                     std::ptrdiff_t &bias,const char *&locator) {
+  require (&actual==&info () && m_owner.check_owner (current_identity ()),failure::owner_changed);
+  if (m_owner.state ()==phase::awaiting_target_completion) {
+    require (m_owner.m_callback && !m_query_output
+             && m_owner.begin_client_empty_objects (),failure::allocation);
+    m_query_output=true;
+    try {
+      std::size_t count=0; amd_dbgapi_code_object_id_t *rows=nullptr;
+      api ();
+      const auto status=amd_dbgapi_process_code_object_list
+        (actual.process_id,&count,&rows,nullptr);
+      require (m_owner.client_empty_objects_returned
+               (reinterpret_cast<std::uintptr_t> (rows),count,status),failure::allocation);
+      m_query_output=false;
+      return false; // No object/URI/permission is fabricated for the empty list.
+    } catch (...) { m_owner.poison (failure::native_result); client_scope_failed (); throw; }
+  }
+  require (m_owner.state ()==phase::host_running && m_owner.m_callback
+           && !m_origin_pending && !m_origin_complete,failure::order);
+  object=list_one<amd_dbgapi_code_object_id_t>
+    ([&actual] (std::size_t *count,amd_dbgapi_code_object_id_t **rows) {
+      return amd_dbgapi_process_code_object_list (actual.process_id,count,rows,nullptr);
+    }); // The one real list allocation is freed BEFORE the URI query.
+  query (amd_dbgapi_code_object_get_info,object,AMD_DBGAPI_CODE_OBJECT_INFO_LOAD_ADDRESS,bias);
+  require (!m_query_output && m_owner.begin_client_locator (),failure::allocation);
+  m_query_output=true;
+  try {
+    char *uri=nullptr; api ();
+    const auto status=amd_dbgapi_code_object_get_info
+      (object,AMD_DBGAPI_CODE_OBJECT_INFO_URI_NAME,sizeof (uri),&uri);
+    const auto bytes=m_owner.m_allocation_bytes;
+    require (uri!=nullptr && m_owner.client_output_returned
+             (reinterpret_cast<std::uintptr_t> (uri),bytes,status)
+             && bytes>=1 && bytes<=m_work.locator.size (),failure::allocation);
+    debit (counter::work,bytes*2);
+    for (std::size_t n=0;n<bytes;++n) m_work.locator[n]=static_cast<std::uint8_t> (uri[n]);
+    require (m_owner.releasing_client_output (reinterpret_cast<std::uintptr_t> (uri)),
+             failure::allocation);
+    ::free (uri); m_query_output=false;
+    std::uint64_t address=0;
+    require (fixed_memory_locator (reinterpret_cast<const char *> (m_work.locator.data ()),
+                                   bytes,m_owner.m_identity.pid,address),
+             failure::checkpoint_changed);
+    m_object=object; m_object_bias=bias; m_original_address=address; m_origin_pending=true;
+    locator=reinterpret_cast<const char *> (m_work.locator.data ());
+    return true;
+  } catch (...) { m_owner.poison (failure::native_result); client_scope_failed (); throw; }
+}
+void native_adapter::read_runtime_root (std::uint64_t address) {
+  require (address!=0 && (address&7)==0,failure::checkpoint_changed);
+  static_assert (sizeof (runtime_root)==40 && std::is_standard_layout<runtime_root>::value,
+                 "exact retained target root ABI");
+  read (address,reinterpret_cast<std::uint8_t *> (&m_root_read),sizeof (m_root_read));
+}
+void native_adapter::inspect_empty_transport (const checkpoint_view &cp) {
+  std::uint64_t word=0;
+  read_u64 (cp.u64 (112),word); require (word==0,failure::checkpoint_changed);
+  read_u64 (cp.u64 (120),word); require (word==0,failure::checkpoint_changed);
+  read_u64 (cp.u64 (136),word); require (word==1,failure::checkpoint_changed);
+  read (cp.u64 (88),m_work.image_chunk.data (),64);
+  for (std::size_t n=0;n<64;++n)
+    require (m_work.image_chunk[n]==(n==0 ? 1 : 0),failure::checkpoint_changed);
+  read (cp.u64 (144),m_work.kernarg_read.data (),264);
+  for (std::size_t n=0;n<264;++n)
+    require (m_work.kernarg_read[n]==m_candidate.bytes[480+n],failure::checkpoint_changed);
+  constexpr std::uint64_t first=UINT64_C (0x0123456789abcdef);
+  constexpr std::uint64_t last=UINT64_C (0xfedcba9876543210);
+  for (std::size_t at=0;at<272;) {
+    const auto count=std::min<std::size_t> (256,272-at);
+    std::uint64_t address=0; require (checked_sum (cp.u64 (160),at,address),failure::checkpoint_changed);
+    read (address,m_work.image_chunk.data (),count);
+    for (std::size_t n=0;n<count;++n) {
+      const auto index=at+n;
+      const std::uint8_t expected=index<8 ? static_cast<std::uint8_t> (first>>(index*8))
+        : index<264 ? 0xa5 : static_cast<std::uint8_t> (last>>((index-264)*8));
+      require (m_work.image_chunk[n]==expected,failure::checkpoint_changed);
+    }
+    at+=count;
+  }
+  // Deliberately not the whole8MiB ring or unused3824 output bytes.
+}
+void native_adapter::inspect_checkpoint (bool recheck) {
+  require (m_owner.check_owner (current_identity ()) && m_origin_complete
+           && m_file_passes>=1 && m_checkpoint_passes==(recheck ? 1u : 0u)
+           && m_host==inferior_thread () && m_host->state!=THREAD_EXITED
+           && (!recheck || (m_infrun_origin && !m_infrun_step && !m_infrun_user_step))
+           && !m_host->executing () && !m_host->resumed (),
+           failure::checkpoint_changed);
+  ++m_checkpoint_passes; // Consume the fixed pass before any possible read.
+  require (read_start_ticks ()==m_start_ticks,failure::owner_changed);
+  current_executable ();
+  if (recheck) hash_executable ();
+  debit (counter::work,2176+4096+512);
+  auto *cache=get_thread_regcache (m_host);
+  ULONGEST argument=0;
+  require (regcache_read_pc (cache)==m_checkpoint_pc
+           && regcache_cooked_read_unsigned (cache,AMD64_RDI_REGNUM,&argument)==REG_VALID
+           && argument!=0 && (argument&7)==0,failure::checkpoint_changed);
+  if (recheck) require (argument==m_owner.m_checkpoint.record_address,failure::checkpoint_changed);
+  m_candidate.record_address=argument; m_candidate.host_pc=m_checkpoint_pc;
+  read (argument,m_work.checkpoint_read.data (),m_work.checkpoint_read.size ());
+  m_candidate.bytes=m_work.checkpoint_read;
+  const checkpoint_view cp (m_candidate.bytes);
+  require (cp.valid (m_owner.m_identity.pid),failure::checkpoint_changed);
+  std::uint64_t base=0,descriptor=0,entry=0;
+  require (apply_bias (0,m_object_bias,base) && apply_bias (1984,m_object_bias,descriptor)
+           && apply_bias (6144,m_object_bias,entry) && base==cp.u64 (56)
+           && descriptor==cp.u64 (72) && entry==cp.u64 (80),failure::checkpoint_changed);
+  m_candidate.entry=entry; m_candidate.signal_base=cp.u64 (128);
+  m_candidate.code_object=m_object.handle;
+  sole_queue (cp,recheck);
+  inspect_empty_transport (cp);
+  hash_inferior (m_original_address,5312,fixed_object_sha);
+  hash_inferior (base,12288,fixed_image_sha);
+  hash_inferior (cp.u64 (200),4096,fixed_trap_backing_sha);
+  read (argument,m_work.checkpoint_read.data (),m_work.checkpoint_read.size ());
+  require (m_work.checkpoint_read==m_candidate.bytes
+           && regcache_read_pc (cache)==m_checkpoint_pc
+           && read_start_ticks ()==m_start_ticks
+           && m_owner.check_owner (current_identity ()),failure::checkpoint_changed);
+  read_runtime_root (cp.u64 (216));
+  require (m_callback_pc!=0 && m_root_read.breakpoint==m_callback_pc
+           && m_callback_object==m_owner.m_origin_callback_object,
+           failure::checkpoint_changed);
+  if (recheck) {
+    require (same (m_owner.m_checkpoint,m_candidate)
+             && m_owner.recheck_checkpoint_root (current_identity (),cp.u64 (216),m_root_read),
+             failure::checkpoint_changed);
+  } else {
+    require (m_owner.bind_checkpoint_root (current_identity (),cp.u64 (216),m_root_read),
+             failure::checkpoint_changed);
+  }
+}
+}
diff --git a/gdb/amd-dbgapi-one-stop-native-owner-v1.inc b/gdb/amd-dbgapi-one-stop-native-owner-v1.inc
--- /dev/null
+++ b/gdb/amd-dbgapi-one-stop-native-owner-v1.inc
@@ -0,0 +1,258 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Actual GDB owners, measured executable and PID-start binding. No imported
+   identity is accepted. The setup command has no caller-supplied parameters. */
+#include "ui-out.h"
+namespace amd_owned_one_stop_v1 {
+amd_dbgapi_inferior_info &native_adapter::info () {
+  require (m_owner.selected () && !m_owner.invalid () && m_inferior!=nullptr
+           && current_inferior ()==m_inferior && m_info!=nullptr,
+           failure::owner_changed);
+  require (amd_dbgapi_inferior_data.get (m_inferior)==m_info
+           && m_info->inf==m_inferior && m_info->process_id.handle!=0,
+           failure::owner_changed); // Never get-or-create a replacement registry owner.
+  return *m_info;
+}
+identity native_adapter::current_identity () {
+  auto &i=info ();
+  require (m_host!=nullptr && m_host->inf==m_inferior && m_host->global_num>0
+           && m_host->state!=THREAD_EXITED && !ptid_is_gpu (m_host->ptid)
+           && m_inferior->pid>0 && m_host->ptid.pid ()==m_inferior->pid
+           && m_inferior->process_target ()->find_thread (m_host->ptid)==m_host,
+           failure::owner_changed);
+  return {reinterpret_cast<std::uintptr_t> (m_inferior),
+          reinterpret_cast<std::uintptr_t> (m_inferior->pspace),
+          reinterpret_cast<std::uintptr_t> (&i),
+          static_cast<std::uint64_t> (m_inferior->num),
+          static_cast<std::uint64_t> (m_inferior->pid),m_start_ticks,
+          i.process_id.handle,static_cast<std::uint64_t> (m_host->global_num)};
+}
+void native_adapter::thread_roster (std::size_t &host,std::size_t &gpu) {
+  host=0; gpu=0; std::size_t inferiors=0,total=0;
+  for (auto *inf : all_non_exited_inferiors ()) {
+    debit (counter::work,1);
+    require (++inferiors<=1 && inf==m_inferior,failure::resume_scope);
+  }
+  require (inferiors==1,failure::resume_scope);
+  for (auto *thread : all_non_exited_threads (m_inferior->process_target (),minus_one_ptid)) {
+    debit (counter::work,1);
+    require (++total<=16 && thread->inf==m_inferior
+             && thread->ptid.pid ()==m_inferior->pid,failure::resume_scope);
+    if (ptid_is_gpu (thread->ptid)) ++gpu;
+    else { require (thread==m_host,failure::resume_scope); ++host; }
+  }
+}
+std::uint64_t native_adapter::read_start_ticks () {
+  require (m_inferior!=nullptr && m_inferior->pid>0,failure::owner_changed);
+  const auto count=std::snprintf (m_proc_path.data (),m_proc_path.size (),
+                                 "/proc/%d/stat",m_inferior->pid);
+  require (count>0 && static_cast<std::size_t> (count)<m_proc_path.size (),failure::budget);
+  debit (counter::proc_requested_bytes,m_proc.size ());
+  debit (counter::work,m_proc.size ());
+  scoped_fd fd (::open (m_proc_path.data (),O_RDONLY|O_CLOEXEC|O_NOFOLLOW));
+  require (fd.get ()>=0,failure::owner_changed);
+  const auto got=::read (fd.get (),m_proc.data (),m_proc.size ());
+  require (got>0 && static_cast<std::size_t> (got)<m_proc.size ()
+           && m_proc[static_cast<std::size_t> (got)-1]=='\n',failure::owner_changed);
+  const auto end=static_cast<std::size_t> (got);
+  std::size_t at=0; std::uint64_t pid=0;
+  while (at<end && m_proc[at]>='0' && m_proc[at]<='9') {
+    const unsigned digit=static_cast<unsigned> (m_proc[at++]-'0');
+    require (pid<=(UINT64_MAX-digit)/10,failure::owner_changed); pid=pid*10+digit;
+  }
+  require (pid==static_cast<std::uint64_t> (m_inferior->pid)
+           && at+2<end && m_proc[at]==' ' && m_proc[at+1]=='(',failure::owner_changed);
+  std::size_t close=0;
+  for (std::size_t n=at+2;n<end;++n) if (m_proc[n]==')') close=n;
+  require (close>at+1 && close+4<end && m_proc[close+1]==' ',failure::owner_changed);
+  at=close+2; // Field3 state; advance exactly to field22 starttime.
+  for (unsigned field=3;field<22;++field) {
+    require (at<end && m_proc[at]!=' ',failure::owner_changed);
+    while (at<end && m_proc[at]!=' ') ++at;
+    require (at<end,failure::owner_changed); ++at;
+  }
+  std::uint64_t ticks=0; const auto first=at;
+  while (at<end && m_proc[at]>='0' && m_proc[at]<='9') {
+    const unsigned digit=static_cast<unsigned> (m_proc[at++]-'0');
+    require (ticks<=(UINT64_MAX-digit)/10,failure::owner_changed); ticks=ticks*10+digit;
+  }
+  require (at>first && at<end && m_proc[at]==' ' && ticks!=0,failure::owner_changed);
+  return ticks;
+}
+void native_adapter::current_executable () {
+  require (m_inferior!=nullptr && m_inferior->pid>0
+           && m_inferior->pspace->exec_filename ()!=nullptr
+           && std::strcmp (m_inferior->pspace->exec_filename (),target_path)==0,
+           failure::checkpoint_changed);
+  const auto count=std::snprintf (m_proc_path.data (),m_proc_path.size (),
+                                 "/proc/%d/exe",m_inferior->pid);
+  require (count>0 && static_cast<std::size_t> (count)<m_proc_path.size (),failure::budget);
+  scoped_fd actual (::open (m_proc_path.data (),O_RDONLY|O_CLOEXEC));
+  struct stat process_file {},fixed_file {};
+  require (actual.get ()>=0 && ::fstat (actual.get (),&process_file)==0
+           && ::lstat (target_path,&fixed_file)==0
+           && S_ISREG (fixed_file.st_mode) && S_ISREG (process_file.st_mode)
+           && fixed_file.st_dev==process_file.st_dev && fixed_file.st_ino==process_file.st_ino
+           && fixed_file.st_size==static_cast<off_t> (target_bytes)
+           && process_file.st_size==fixed_file.st_size,failure::checkpoint_changed);
+  if (m_exec_fd<0) {
+    m_exec_identity=process_file; m_exec_fd=actual.release ();
+  } else {
+    require (process_file.st_dev==m_exec_identity.st_dev
+             && process_file.st_ino==m_exec_identity.st_ino
+             && process_file.st_size==m_exec_identity.st_size
+             && process_file.st_mtim.tv_sec==m_exec_identity.st_mtim.tv_sec
+             && process_file.st_mtim.tv_nsec==m_exec_identity.st_mtim.tv_nsec
+             && process_file.st_ctim.tv_sec==m_exec_identity.st_ctim.tv_sec
+             && process_file.st_ctim.tv_nsec==m_exec_identity.st_ctim.tv_nsec,
+             failure::checkpoint_changed);
+  }
+}
+class owned_checkpoint_breakpoint final : public code_breakpoint {
+public:
+  owned_checkpoint_breakpoint (struct gdbarch *arch,CORE_ADDR pc)
+    : code_breakpoint (arch,bp_breakpoint) {
+    symtab_and_line location;
+    location.pc=pc; location.section=find_pc_overlay (pc); location.pspace=current_program_space;
+    add_location (location); pspace=current_program_space; disposition=disp_del;
+  }
+  void re_set (program_space *) override {
+    native_adapter::instance ().check_owned_breakpoint_reset (this);
+  }
+  void check_status (bpstat *status) override {
+    status->stop=1;
+    try { native_adapter::instance ().checkpoint_hit (this,status); }
+    catch (...) { native_adapter::instance ().invalidate (failure::checkpoint_changed); throw; }
+  }
+  enum print_stop_action print_it (const bpstat *status) const override {
+    auto &adapter=native_adapter::instance ();
+    try {
+      // This is presentation of the same retained native stop, not an input
+      // parser or a new proof. MI and console may each print the stop once.
+      adapter.debit (counter::work,64);
+      adapter.check_owned_breakpoint_reset (this);
+      adapter.check_owned_breakpoint_owner ();
+      adapter.require (adapter.m_owner.state ()==phase::provisional_checkpoint
+                       && inferior_thread ()==adapter.m_host
+                       && !adapter.m_host->executing () && !adapter.m_host->resumed ()
+                       && status!=nullptr && status->breakpoint_at==this
+                       && status->bp_location_at.get ()==&first_loc ()
+                       && status->stop && status->simd_lane_mask==0
+                       && type==bp_breakpoint && number<0 && enable_state==bp_enabled
+                       && !silent && ignore_count==0 && !commands
+                       && cond_string==nullptr && extra_string==nullptr,
+                       failure::checkpoint_changed);
+      struct ui_out *out=current_uiout;
+      if (out->is_mi_like_p ()) {
+        out->field_string ("reason","breakpoint-hit");
+        out->field_string ("disp","del");
+        out->field_signed ("bkptno",number);
+      } else {
+        out->text ("Owned one-stop checkpoint, ");
+      }
+      return PRINT_SRC_AND_LOC;
+    } catch (...) { adapter.invalidate (failure::output); throw; }
+  }
+  void print_mention () const override {
+    // install_breakpoint(internal=true) never invokes mention.
+    native_adapter::instance ().reject (failure::command);
+  }
+  void print_recreate (struct ui_file *) const override {
+    // No locspec exists and selected MI admits no save/recreate command.
+    native_adapter::instance ().reject (failure::command);
+  }
+  int resources_needed (const struct bp_location *) override {
+    // This exact object is a software breakpoint, never a hardware query.
+    native_adapter::instance ().reject (failure::command);
+  }
+};
+static_assert (sizeof (owned_checkpoint_breakpoint)<=1024,
+               "fixed breakpoint object is within the prepaid logical envelope");
+void native_adapter::select_at_entry () {
+  if (!selection_available ())
+    error (_("owned one-stop native activation unavailable: compile candidate only"));
+  require (!m_owner.selected (),failure::already_selected);
+  require (m_owner.reserve_selection (logical_storage (),limits::logical_bytes),failure::budget);
+  try {
+    m_inferior=current_inferior (); m_host=inferior_thread ();
+    require (m_inferior!=nullptr && m_host!=nullptr && m_host->inf==m_inferior
+             && m_inferior->pid>0 && m_inferior->num>0 && !non_stop
+             && top_level_interpreter ()!=nullptr
+             && std::strcmp (top_level_interpreter ()->name (),"mi2")==0
+             && m_inferior->pspace->cbfd==nullptr
+             && m_host->state==THREAD_STOPPED && !m_host->executing ()
+             && !m_host->resumed () && !ptid_is_gpu (m_host->ptid),failure::owner_changed);
+    m_inferior_ref=inferior_ref::new_reference (m_inferior);
+    m_ui=current_ui; m_interpreter=top_level_interpreter ();
+    m_host_ref=thread_info_ref::new_reference (m_host);
+    m_info=amd_dbgapi_inferior_data.get (m_inferior);
+    require (m_info!=nullptr && m_info->inf==m_inferior && m_info->process_id.handle!=0
+             && m_info->runtime_state==AMD_DBGAPI_RUNTIME_STATE_UNLOADED
+             && runtime_observation.owns (reinterpret_cast<std::uintptr_t> (m_info),
+                                          m_info->process_id.handle)
+             && !runtime_observation.invalid () && !runtime_observation.attaching (),
+             failure::owner_changed);
+    auto *arch=m_inferior->arch ();
+    require (gdbarch_bfd_arch_info (arch)->arch==bfd_arch_i386
+             && gdbarch_bfd_arch_info (arch)->mach==bfd_mach_x86_64
+             && gdbarch_byte_order (arch)==BFD_ENDIAN_LITTLE
+             && gdbarch_ptr_bit (arch)==64,failure::checkpoint_changed);
+    current_executable (); hash_executable (); m_start_ticks=read_start_ticks ();
+    require (m_owner.bind_selection (current_identity ()),failure::owner_changed);
+    auto *obj=m_inferior->pspace->symfile_object_file;
+    require (obj!=nullptr && obj->obfd!=nullptr
+             && std::strcmp (bfd_get_filename (obj->obfd.get ()),target_path)==0,
+             failure::checkpoint_changed);
+    const auto entry=lookup_minimal_symbol (m_inferior->pspace,entry_symbol,obj);
+    const auto checkpoint=lookup_minimal_symbol (m_inferior->pspace,checkpoint_symbol,obj);
+    require (entry.minsym!=nullptr && checkpoint.minsym!=nullptr
+             && entry.objfile==obj && checkpoint.objfile==obj
+             && entry.minsym->has_size () && entry.minsym->size ()==entry_symbol_size
+             && checkpoint.minsym->has_size () && checkpoint.minsym->size ()==checkpoint_symbol_size
+             && entry.minsym->type ()==mst_text && checkpoint.minsym->type ()==mst_text,
+             failure::checkpoint_changed);
+    std::uint64_t expected_entry=0,expected_checkpoint=0;
+    require (checked_sum (obj->text_section_offset (),entry_symbol_value,expected_entry)
+             && checked_sum (obj->text_section_offset (),checkpoint_symbol_value,expected_checkpoint)
+             && entry.value_address ()==expected_entry
+             && checkpoint.value_address ()==expected_checkpoint
+             && regcache_read_pc (get_thread_regcache (m_host))==expected_entry,
+             failure::checkpoint_changed);
+    m_entry_pc=expected_entry; m_checkpoint_pc=expected_checkpoint;
+    std::size_t host=0,gpu=0; thread_roster (host,gpu);
+    require (host==1 && gpu==0,failure::resume_scope);
+    std::size_t count=0;
+    for (auto &location : all_bp_locations ()) {
+      debit (counter::work,1);
+      require (++count<=64 && !(location->pspace==m_inferior->pspace
+               && (location->address==m_entry_pc || location->address==m_checkpoint_pc)),
+               failure::breakpoint_changed);
+    }
+    auto pending=std::make_unique<owned_checkpoint_breakpoint> (m_inferior->arch (),m_checkpoint_pc);
+    m_breakpoint=pending.get (); m_breakpoint_identity=reinterpret_cast<std::uintptr_t> (m_breakpoint);
+    auto *installed=install_breakpoint (true,std::move (pending),1);
+    require (installed==m_breakpoint && installed->number!=0,failure::breakpoint_changed);
+    m_candidate.breakpoint_object=m_breakpoint_identity;
+    m_candidate.breakpoint_number=static_cast<std::uint64_t> (installed->number);
+    flush ();
+  } catch (...) { m_owner.poison (failure::owner_changed); throw; }
+}
+void native_adapter::check_owned_breakpoint_owner () {
+  require (m_owner.check_owner (current_identity ()),failure::owner_changed);
+}
+void native_adapter::check_owned_breakpoint_reset (const owned_checkpoint_breakpoint *bp) {
+  require (m_owner.selected () && bp==m_breakpoint
+           && bp->pspace==m_inferior->pspace && bp->has_single_location ()
+           && bp->first_loc ().address==m_checkpoint_pc
+           && bp->first_loc ().pspace==m_inferior->pspace
+           && bp->disposition==disp_del,failure::breakpoint_changed);
+  // Fixed address remains unchanged through the legitimate selected solib refresh.
+}
+void native_adapter::checkpoint_hit (owned_checkpoint_breakpoint *bp,bpstat *status) {
+  require (m_owner.selected () && bp==m_breakpoint && status!=nullptr
+           && status->breakpoint_at==bp && status->bp_location_at!=nullptr
+           && status->bp_location_at->address==m_checkpoint_pc
+           && bp->disposition==disp_del,failure::breakpoint_changed);
+  inspect_checkpoint (false);
+  require (m_owner.checkpoint_hit (current_identity (),m_candidate),failure::checkpoint_changed);
+}
+}
