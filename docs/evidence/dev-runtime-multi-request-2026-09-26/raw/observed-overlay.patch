+            profile.calls += 1;
+            let entry = profile.entries.iter().find(|entry| entry.backend_device_v1() == device).unwrap();
+            assert!(witness.matches_v1(entry, bytes));
+            let outcome = profile.outcome;
+            RuntimeRequestAllocationResultV1::Outcome(match outcome {
+                0 => return RuntimeRequestAllocationResultV1::Unsupported,
+                1 => self.allocate_v1(device, kind, bytes, alignment).map(RuntimeBackendAllocationOutcomeV1::Allocated),
+                2 => Ok(RuntimeBackendAllocationOutcomeV1::SettledNoOwner(MockError("settled"))),
+                3 => Err(RuntimeBackendFailureV1::Rejected(MockError("rejected"))),
+                4 => Err(RuntimeBackendFailureV1::Quiescent(MockError("uncertain"))),
+                5 => Err(RuntimeBackendFailureV1::Terminal(MockError("terminal"))),
+                6 => panic!("qualification allocation panic"),
+                _ => unreachable!(),
+            })
+        }
