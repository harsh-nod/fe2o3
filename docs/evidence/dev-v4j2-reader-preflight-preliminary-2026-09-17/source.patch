+            1 => journal.readers[requests[0].allocation.slot] = 3,
+            2 => *journal.free_reads.last_mut().unwrap() = usize::MAX,
+            3 => {
+                let slot = journal.free_reads[0];
+                journal.leases[slot] = Some(ReadLeaseV1 {
