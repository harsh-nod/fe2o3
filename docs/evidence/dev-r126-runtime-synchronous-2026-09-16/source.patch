+        let mut backend = ManuallyDrop::new(backend);
+        backend.write_allocation_v1(host, 0, &[0x73; 8]).unwrap();
+        let KfdRuntimeSdmaStorageV1::Host(owner) = &backend.allocations[&host].sdma_storage else {
+            panic!()
+        };
+        assert_eq!(
+            host_observation(owner).2,
