+fn no_host_read(backend: &KfdRuntimeBackendV1) {
+    assert!(
+        !backend
+            .profiler
+            .as_ref()
+            .unwrap()
+            .recorded_events_for_test_v1()
+            .iter()
+            .any(|entry| matches!(entry.event, KfdRuntimeProfileEventKindV1::HostRead { .. }))
+    );
+}
