+fn read_step(mode: u8) -> ScriptedSdmaStepV1 {
+    match mode {
+        0 | 1 => ScriptedSdmaStepV1::ReadFault {
+            offset: 0,
+            byte_len: 8,
+            panic: mode == 1,
+        },
+        _ => ScriptedSdmaStepV1::ReadLength {
+            offset: 0,
+            byte_len: 8,
+            returned_len: if mode == 2 { 7 } else { 9 },
+        },
+    }
+}
