+fn constructed_auxiliary_release_platform_and_cleanup_errors_preserve_prefixes() {
+    for stage in [
+        "destroy-event",
+        "zero-payload",
+        "protect-payload",
+        "unmap-payload",
+        "release-doorbell",
+        "release-validate-platform",
+        "release-resources",
