+            Ok(Err(_)) => {
+                self.quarantine_after_async_command_panic_v1();
+                Err(RuntimeValidationErrorV1::InvalidBackendDescription)
+            }
+            Err(payload) => {
+                self.quarantine_after_async_command_panic_v1();
+                core::mem::forget(payload);
+                Err(RuntimeValidationErrorV1::InvalidBackendDescription)
+            }
+        }
+    }
+}
