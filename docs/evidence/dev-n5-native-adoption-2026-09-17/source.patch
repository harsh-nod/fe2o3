+    let submit = backend.submit_v1(BackendLaunchV1 {
+        stream,
+        kernel: 0,
+        explicit_kernarg: &[],
+        bindings: &[],
+        dependencies: &[],
+        geometry: crate::RuntimeLaunchGeometryV1 {
