+    }));
+    assert!(result.is_err());
+    assert!(backend.terminal);
+    assert!(backend.generated_shells[&plan.key].control.is_some());
+    assert_eq!(backend.allocations.len(), 3);
+    core::mem::forget(backend);
+}
