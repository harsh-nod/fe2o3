+            &self.authority,
+        );
+        callback(RuntimeGfx942GeneratedCompletionViewV1::new(
+            source,
+            destinations,
+        ))
+    }
+
+    fn complete_readback_v1(self) -> Result<(), RuntimeGfx942ReadbackErrorV1> {
