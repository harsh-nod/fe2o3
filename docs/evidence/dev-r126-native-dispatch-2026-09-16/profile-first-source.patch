+    backend.shutdown_owned_v1().unwrap();
+    backend.shutdown_owned_v1().unwrap();
+    assert!(!backend.terminal);
+    assert!(
+        backend
+            .children
+            .iter()
+            .all(|child| child.queue_retired && !child.terminal && child.queue.is_none())
+    );
