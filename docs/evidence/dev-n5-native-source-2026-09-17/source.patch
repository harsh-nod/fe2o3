+fn rejected_error() -> crate::KfdRuntimeBackendErrorV1 {
+    match KfdRuntimeBackendV1::mock()
+        .create_stream_v1(u64::MAX)
+        .unwrap_err()
+    {
+        RuntimeBackendFailureV1::Rejected(error) => error,
+        other => panic!("expected pure backend rejection: {other:?}"),
+    }
+}
