+#[test]
+fn generated_native_inputs_reject_retained_program_and_abi_corruption_before_callback() {
+    for axis in 0..10 {
+        let (hsaco, mut projection) = crate::authorized_execution::tests::source_projection();
+        let authority = crate::authorized_execution::tests::source_authority(&projection);
+        let expected =
+            crate::generated_source::GeneratedHostRosterV1::from_projection(&projection).unwrap();
+        match axis {
+            0 => projection.data.executable_image[0] ^= 1,
+            1 => projection.data.description.descriptor_offset += 64,
+            2 => projection.data.kernarg_alignment *= 2,
+            3 => projection.data.description.static_group_segment_bytes += 1,
+            4 => projection.data.description.packet_group_segment_bytes += 1,
+            5 => projection.data.description.dynamic_group_segment_bytes += 1,
+            6 => {
+                projection.data.pointer_fixups[0] = Gfx942KfdDispatchPointerFixupV1::new(8, 0, 0, 4)
+            }
+            7 => {
+                projection.data.pointer_fixups[0] = Gfx942KfdDispatchPointerFixupV1::new(0, 3, 0, 4)
+            }
+            8 => {
+                projection.data.pointer_fixups[0] =
+                    Gfx942KfdDispatchPointerFixupV1::new(0, 0, 16, 4)
+            }
+            _ => {
+                projection.data.pointer_fixups[0] = Gfx942KfdDispatchPointerFixupV1::new(0, 0, 0, 3)
+            }
+        }
+        let storage = projection.into_generated_storage_v1();
+        let source = crate::RuntimeGfx942GeneratedSourceV1::from_generated_storage(
+            &storage, &hsaco, &authority,
+        );
+        assert!(
+            matches!(
+                source.with_native_inputs_v1(7, &expected, |_, _| {
+                    panic!("invalid retained program reached callback")
+                }),
+                Err(crate::generated_source::GeneratedNativeInputErrorV1::Projection(_))
+            ),
+            "axis {axis}"
+        );
+        assert!(storage.control_available());
+    }
+}
