+            let driver = fixture.backend.scripted_sdma.as_ref().unwrap();
+            assert_eq!(driver.remaining_steps(), 1);
+            assert_eq!(driver.live_owner_count(), fixture.pairs.len() * 2 + 1);
+            assert_eq!(driver.unexpected_drops(), 0);
+            discard_scripted_fixture(fixture.backend);
+        }
+    }
