+#[test]
+fn sdma_pending_allocation_context_refunds_capacity_and_cold_busy_without_settling_compute() {
+    for lanes in LANES {
+        for kind in KINDS {
+            let mut steps = vec![reject(kind, 8, false)];
+            steps.extend(success(kind));
+            let Fixture {
+                backend,
+                pairs,
+                submissions,
+                ..
+            } = Fixture::new(lanes, steps);
+            let before = backend_snapshot(&backend, &pairs, &submissions);
+            // Context adopts a backend with genuine Scripted submissions; it only owns the new allocation.
+            let mut context = ManuallyDrop::new(
+                crate::RuntimeContextV1::open(ManuallyDrop::into_inner(backend)).unwrap(),
+            );
+            let device = context.devices()[0].id();
+            context
+                .configure_allocation_admission_v1(device, 8, 1)
+                .unwrap();
+            let initial = context.allocation_admission_usage_v1(device).unwrap();
+            let steps = context
+                .backend()
+                .scripted_sdma
+                .as_ref()
+                .unwrap()
+                .remaining_steps();
+            context.backend_mut_for_test_v1().sdma_enabled = false;
+            assert!(
+                matches!(context.allocate(device, kind, 8, 8), Err(crate::RuntimeErrorV1::BackendRejected(error)) if error.kind() == KfdRuntimeBackendErrorKindV1::Busy)
+            );
+            assert_eq!(
+                context.allocation_admission_usage_v1(device).unwrap(),
+                initial
+            );
+            assert_eq!(
+                backend_snapshot(context.backend(), &pairs, &submissions),
+                before
+            );
+            assert_eq!(
+                context
+                    .backend()
+                    .scripted_sdma
+                    .as_ref()
+                    .unwrap()
+                    .remaining_steps(),
+                steps
+            );
+            context.backend_mut_for_test_v1().sdma_enabled = true;
+            assert!(
+                matches!(context.allocate(device, kind, 8, 8), Err(crate::RuntimeErrorV1::BackendRejected(error)) if error.kind() == KfdRuntimeBackendErrorKindV1::Capacity)
+            );
+            let usage = context
+                .allocation_admission_usage_v1(device)
+                .unwrap()
+                .unwrap();
+            assert_eq!(
+                usage
+                    .used
+                    .get(crate::RuntimeResourceKindV1::RequestedAllocationBytes),
+                0
+            );
+            assert_eq!(
+                usage
+                    .used
+                    .get(crate::RuntimeResourceKindV1::AllocationRecords),
+                0
+            );
+            assert_eq!(usage.quarantined_records, 0);
+            assert_eq!(
+                backend_snapshot(context.backend(), &pairs, &submissions),
+                before
+            );
+            context.allocate(device, kind, 8, 8).unwrap();
+            let usage = context
+                .allocation_admission_usage_v1(device)
+                .unwrap()
+                .unwrap();
+            assert_eq!(
+                usage
+                    .used
+                    .get(crate::RuntimeResourceKindV1::RequestedAllocationBytes),
+                8
+            );
+            assert_eq!(
+                usage
+                    .used
+                    .get(crate::RuntimeResourceKindV1::AllocationRecords),
+                1
+            );
+            assert_eq!(usage.quarantined_records, 0);
+            assert!(!context.is_terminal());
+            assert_eq!(
+                backend_snapshot(context.backend(), &pairs, &submissions),
+                before
+            );
+            let driver = context.backend().scripted_sdma.as_ref().unwrap();
+            assert!(driver.is_exhausted());
+            assert_eq!(driver.unexpected_drops(), 0);
+            // Separate fixture disposal, not a public native cleanup or credit-refund claim.
+            disarm_scripted_drop_after_inspection_v1(context.backend_mut_for_test_v1());
+            drop(ManuallyDrop::into_inner(context));
+        }
+    }
+}
