+                        byte_len: 8,
+                        fill: 0xa5,
+                    },
+                    ScriptedSdmaStepV1::WriteFault {
+                        offset: 0,
+                        byte_len: 8,
+                        written_prefix: 3,
+                        panic,
+                    },
+                    ScriptedSdmaStepV1::Recycle(ScriptedRecycleOutcomeV1::Success),
+                ],
+            );
+            let before = snapshot(&fixture);
+            let expected_owner = before
+                .allocations
+                .iter()
+                .map(|allocation| allocation.owner)
+                .max()
+                .unwrap()
+                + 1;
+            let prior_drops = dropped_events(&fixture.backend);
+            let candidate = fixture.backend.next_handle;
+            let bytes = fixture.backend.staged_context_bytes;
+            let count = fixture.backend.allocations.len();
+            let events = fixture
+                .backend
+                .profiler
+                .as_ref()
+                .unwrap()
+                .recorded_events_for_test_v1()
+                .to_vec();
+            let result = catch_unwind(AssertUnwindSafe(|| {
+                fixture
+                    .backend
+                    .allocate_v1(7, RuntimeMemoryKindV1::HostVisible, 8, 8)
+            }));
+            if panic {
+                assert_eq!(
+                    result.unwrap_err().downcast_ref::<&str>(),
+                    Some(&"scripted SDMA host write panic")
+                );
+            } else {
+                let Err(RuntimeBackendFailureV1::Terminal(error)) = result.unwrap() else {
+                    panic!("initialization failure must retain owners")
+                };
+                assert_eq!(
+                    error.detail(),
+                    "KFD persistent host allocation initialization: scripted SDMA host write failure"
+                );
+            }
+            assert!(fixture.backend.terminal);
+            let retained = host_observation(retained_host(&fixture.backend));
+            assert_eq!(retained.0, expected_owner);
+            assert_eq!(retained.1, [0, 0, 0, 0xa5, 0xa5, 0xa5, 0xa5, 0xa5]);
+            assert_eq!(retained.2, None);
+            assert!(!fixture.backend.allocations.contains_key(&candidate));
+            assert!(matches!(
+                fixture
+                    .backend
+                    .allocate_v1(7, RuntimeMemoryKindV1::HostVisible, 8, 8),
+                Err(RuntimeBackendFailureV1::Terminal(_))
+            ));
+            for &id in &fixture.submissions {
+                assert!(matches!(
+                    fixture.backend.poll_v1(id),
+                    Err(RuntimeBackendFailureV1::Terminal(_))
+                ));
+            }
+            assert_eq!(snapshot(&fixture), before);
+            assert_eq!(dropped_events(&fixture.backend), prior_drops);
+            assert_eq!(host_observation(retained_host(&fixture.backend)), retained);
+            assert_eq!(fixture.backend.next_handle, candidate + 1);
+            assert_eq!(fixture.backend.staged_context_bytes, bytes);
+            assert_eq!(fixture.backend.allocations.len(), count);
+            assert_eq!(
+                fixture
