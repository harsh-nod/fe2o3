+#[derive(Debug, PartialEq)]
+struct ActiveSnapshot {
+    id: u64,
+    lane: usize,
+    stream: u64,
+    predecessor: Option<u64>,
+    deferred_retain: bool,
+    kernel: u64,
+    depth: usize,
+    allocations: HashSet<u64>,
+    descriptors: Vec<ResidentDataDescriptorV1>,
+    recipe: Option<usize>,
+    execution: (u8, Option<(u64, RuntimeAccessV1, usize)>),
+    shape: [u8; 32],
+    published_at: Instant,
+    performance: KfdRuntimeLaunchPerformanceV1,
+}
+
+#[derive(Debug, PartialEq)]
+struct PendingSnapshot {
+    id: u64,
+    module: u64,
+    recipe: usize,
+    allocations: Box<[u64]>,
+    predecessor: Option<u64>,
+    dependencies: Box<[u64]>,
+    cursor: usize,
+    depth: usize,
+}
+
+#[derive(Debug, PartialEq)]
+struct AllocationSnapshot {
+    device: u64,
+    kind: RuntimeMemoryKindV1,
+    alignment: u64,
+    digest: Option<[u8; 32]>,
+    last_host_write: Option<(Arc<[u8]>, [u8; 32], usize)>,
+    shadow: Arc<[u8]>,
+    shadow_address: usize,
+    device_box: Option<usize>,
+    owner: u64,
+    bytes: Vec<u8>,
+    certificate: Option<[u8; 32]>,
+    custody: Option<(
+        VecDeque<RuntimeAllocationCustodyOwnerV1>,
+        Option<u64>,
+        [usize; 2],
+    )>,
+}
+
+#[derive(Debug, PartialEq)]
+struct Snapshot {
+    active: Vec<ActiveSnapshot>,
+    pending: Vec<PendingSnapshot>,
+    pending_streams: HashMap<u64, VecDeque<u64>>,
+    allocations: Vec<AllocationSnapshot>,
+    leases: HashMap<u64, usize>,
+    selected_lane: usize,
+    module_retains: HashMap<u64, usize>,
+    dependency_retains: HashMap<u64, usize>,
+    event_retains: HashMap<u64, usize>,
+    tails: HashMap<u64, u64>,
+    completions: HashMap<u64, (u64, BackendPollV1, bool)>,
+    reservations: usize,
+}
+
+fn snapshot(fixture: &Fixture) -> Snapshot {
+    backend_snapshot(&fixture.backend, &fixture.pairs, &fixture.submissions)
+}
+
+fn backend_snapshot(
+    backend: &KfdRuntimeBackendV1,
+    pairs: &[(u64, u64)],
+    submissions: &[u64],
+) -> Snapshot {
+    assert!(backend.compute_pipeline.is_empty());
+    assert!(
+        backend
+            .auxiliary_compute_lanes
+            .iter()
+            .all(|lane| lane.pipeline.is_empty())
+    );
+    let mut active = Vec::new();
+    let mut pending = Vec::new();
+    for &id in submissions {
+        if let Some(value) = backend.active_compute_submission_v1(id) {
+            let execution = match value.execution.as_ref().unwrap() {
+                ActiveComputeExecutionV1::ScriptedMaterialized => (0, None),
+                ActiveComputeExecutionV1::ScriptedPersistent {
+                    allocation,
+                    access,
+                    device,
+                } => (
+                    1,
+                    Some((*allocation, *access, &**device as *const _ as usize)),
+                ),
+                ActiveComputeExecutionV1::ScriptedPersistentPrepared {
+                    allocation,
+                    access,
+                    input,
+                    ..
+                } => (
+                    2,
+                    Some((*allocation, *access, &**input as *const _ as usize)),
+                ),
+                _ => panic!("fixture must own its real Scripted execution"),
+            };
+            assert!(value.writebacks.is_empty());
+            active.push(ActiveSnapshot {
+                id,
+                lane: backend.active_compute_lane_v1(id).unwrap(),
+                stream: value.stream,
+                predecessor: value.ordered_predecessor,
+                deferred_retain: value.deferred_ordered_predecessor_retain,
+                kernel: value.kernel,
+                depth: value.dependency_depth,
+                allocations: value.allocations.clone(),
+                descriptors: value.resident_descriptors.clone(),
+                recipe: value
+                    .ordinary_recipe
+                    .as_ref()
+                    .map(|recipe| Arc::as_ptr(recipe) as usize),
+                execution,
+                shape: value.dispatch_shape_sha256,
+                published_at: value.published_at,
+                performance: value.performance,
+            });
+        }
+        if let Some(value) = backend.pending_compute.get(&id) {
+            pending.push(PendingSnapshot {
+                id: value.id,
+                module: value.module,
+                recipe: Arc::as_ptr(&value.launch) as usize,
+                allocations: value.retained_allocations.clone(),
+                predecessor: value.ordered_predecessor,
+                dependencies: value.explicit_success_dependencies.clone(),
+                cursor: value.explicit_dependency_cursor,
+                depth: value.dependency_depth,
+            });
+        }
+    }
+    let allocations = pairs
+        .iter()
+        .flat_map(|&(h, d)| [h, d])
+        .map(|id| {
+            let value = &backend.allocations[&id];
+            let (owner, bytes, certificate, device_box) = match &value.sdma_storage {
+                KfdRuntimeSdmaStorageV1::Host(owner) => {
+                    let (id, bytes, certificate) = host_observation(owner);
+                    (id, bytes, certificate, None)
+                }
+                KfdRuntimeSdmaStorageV1::Device(owner) => (
+                    owner.scripted_owner_id().unwrap(),
+                    owner.scripted_bytes().unwrap().to_vec(),
+                    None,
+                    Some(&**owner as *const DirectionalSdmaDeviceOwnerV1 as usize),
+                ),
+                KfdRuntimeSdmaStorageV1::ComputeInFlight(submission) => {
+                    match backend
+                        .active_compute_submission_v1(*submission)
+                        .unwrap()
+                        .execution
+                        .as_ref()
+                        .unwrap()
+                    {
+                        ActiveComputeExecutionV1::ScriptedPersistent {
+                            allocation, device, ..
+                        } => {
+                            assert_eq!(*allocation, id);
+                            (
+                                device.scripted_owner_id().unwrap(),
+                                device.scripted_bytes().unwrap().to_vec(),
+                                None,
+                                Some(&**device as *const _ as usize),
+                            )
+                        }
+                        ActiveComputeExecutionV1::ScriptedPersistentPrepared {
+                            allocation,
+                            input,
+                            ..
+                        } => {
+                            assert_eq!(*allocation, id);
+                            let KfdRuntimePersistentComputeInputV1::ScriptedReady(ready) = &**input
+                            else {
+                                panic!(
+                                    "first preparation must retain the authenticated ready owner"
+                                )
+                            };
+                            (
+                                ready.owner.scripted_owner_id().unwrap(),
+                                ready.owner.scripted_bytes().unwrap().to_vec(),
+                                Some(ready.owner.authenticated_sha256()),
+                                Some(&**input as *const _ as usize),
+                            )
+                        }
+                        _ => {
+                            panic!("in-flight marker must resolve to the original persistent owner")
+                        }
+                    }
+                }
+                _ => panic!("materialized fixture must retain each indexed SDMA owner"),
+            };
+            assert!(value.sdma_initialized && value.sdma_backed && !value.sdma_shadow_dirty);
+            assert!(value.native_dirty.is_empty());
+            AllocationSnapshot {
+                device: value.device,
+                kind: value.kind,
+                alignment: value.alignment,
+                digest: value.content_sha256,
+                last_host_write: value
+                    .last_full_host_write
+                    .as_ref()
+                    .map(|(bytes, digest)| (Arc::clone(bytes), *digest, bytes.as_ptr() as usize)),
+                shadow: Arc::clone(&value.bytes),
+                shadow_address: value.bytes.as_ptr() as usize,
+                device_box,
+                owner,
+                bytes,
+                certificate,
+                custody: backend
+                    .allocation_custody
+                    .get(&id)
+                    .map(|c| (c.owners.clone(), c.sole_stream, c.owner_counts)),
+            }
+        })
+        .collect();
+    Snapshot {
+        active,
+        pending,
+        pending_streams: backend.pending_compute_streams.clone(),
+        allocations,
+        leases: backend.stream_compute_lanes.clone(),
+        selected_lane: backend.selected_compute_lane,
+        module_retains: backend.compute_module_retain_counts.clone(),
+        dependency_retains: backend.compute_dependency_retain_counts.clone(),
+        event_retains: backend.event_submission_retain_counts.clone(),
+        tails: backend.stream_submission_tails.clone(),
+        completions: backend
+            .submissions
+            .iter()
+            .map(|(&id, value)| {
+                (
+                    id,
+                    (value.stream, value.status, value.profile_dispatch_published),
+                )
+            })
+            .collect(),
+        reservations: backend.compute_completion_reservations,
+    }
+}
