+                    Some(ActiveComputeExecutionV1::ScriptedPersistent { .. })
+                )),
+                _ => assert!(matches!(
+                    execution,
+                    Some(ActiveComputeExecutionV1::ScriptedMaterialized)
+                )),
+            }
+        }
+        if matches!(lanes, Lanes::Auxiliary) {
+            assert_eq!(
+                backend.poll_v1(submissions[0]).unwrap(),
+                BackendPollV1::Succeeded
+            );
+            assert!(backend.active.is_none());
+            assert_eq!(backend.active_compute_lane_v1(submissions[1]), Some(1));
+        }
+        assert_eq!(backend.pending_compute.len(), usize::from(count == 3));
+        if count == 3 {
+            assert!(backend.pending_compute.contains_key(&submissions[2]));
+        }
+        Self {
+            backend,
+            module,
+            streams,
+            pairs,
+            submissions,
+        }
+    }
+
+    fn finish(mut self, allocated: Option<u64>, kind: RuntimeMemoryKindV1) {
+        for &id in &self.submissions {
+            if let Some(pending) = self.backend.pending_compute.get(&id) {
+                let stream = pending.launch.stream;
+                self.backend.flush_stream_v1(stream).unwrap();
+            }
+            let mut result = BackendPollV1::Pending;
+            for _ in 0..4 {
+                result = self.backend.poll_v1(id).unwrap();
+                if result != BackendPollV1::Pending {
+                    break;
+                }
+            }
+            assert_eq!(result, BackendPollV1::Succeeded);
+            self.backend.release_submission_v1(id).unwrap();
+        }
+        assert!(!self.backend.any_compute_active_v1());
+        assert!(self.backend.pending_compute.is_empty());
+        assert!(self.backend.allocation_custody.is_empty());
+        assert!(self.backend.compute_module_retain_counts.is_empty());
+        assert!(self.backend.stream_compute_lanes.is_empty());
+        assert_eq!(self.backend.compute_completion_reservations, 0);
+        if let Some(id) = allocated {
+            if kind == RuntimeMemoryKindV1::DeviceLocal {
+                // Fixture disposal skips the device scrub, not native cleanup evidence.
+                self.backend.allocations.get_mut(&id).unwrap().sdma_backed = false;
+            }
+            self.backend.release_allocation_v1(id).unwrap();
+        }
+        self.backend.unload_module_v1(self.module).unwrap();
+        for (host, device) in self.pairs {
+            release_scripted_direct_pair_v1(&mut self.backend, host, device);
+        }
+        for stream in self.streams {
+            self.backend.destroy_stream_v1(stream).unwrap();
+        }
+        let driver = self.backend.scripted_sdma.as_ref().unwrap();
+        assert!(driver.is_exhausted());
+        assert_eq!(driver.live_owner_count(), 0);
+        assert_eq!(driver.unexpected_drops(), 0);
+        self.backend.shutdown_native_v1().unwrap();
+        drop(ManuallyDrop::into_inner(self.backend));
+    }
+}
+
+fn releases(lanes: Lanes, allocated: Option<RuntimeMemoryKindV1>) -> Vec<ScriptedSdmaStepV1> {
+    let mut steps = Vec::new();
+    if let Some(kind) = allocated {
+        if kind == RuntimeMemoryKindV1::DeviceLocal {
+            steps.push(ScriptedSdmaStepV1::Demote(ScriptedFailureModeV1::Success));
+        }
+        steps.push(ScriptedSdmaStepV1::Recycle(
+            ScriptedRecycleOutcomeV1::Success,
+        ));
+    }
+    let count = match lanes {
+        Lanes::Primary | Lanes::PersistentPrepared | Lanes::PersistentPublished => 1,
+        Lanes::BothWithQueued => 3,
+        _ => 2,
+    };
+    for _ in 0..count {
+        steps.extend(scripted_release_steps_v1());
+    }
+    steps
+}
+
+fn assert_new_allocation(backend: &KfdRuntimeBackendV1, id: u64, kind: RuntimeMemoryKindV1) {
+    let record = &backend.allocations[&id];
+    assert_eq!((record.device, record.kind, record.alignment), (7, kind, 8));
+    assert_eq!(&*record.bytes, &[0; 8]);
+    assert!(record.sdma_initialized && record.sdma_backed && !record.sdma_shadow_dirty);
+    match (&record.sdma_storage, kind) {
+        (KfdRuntimeSdmaStorageV1::Host(owner), RuntimeMemoryKindV1::HostVisible) => {
+            assert_eq!(host_observation(owner).1, [0; 8]);
+        }
+        (KfdRuntimeSdmaStorageV1::Device(owner), RuntimeMemoryKindV1::DeviceLocal) => {
+            assert_eq!(owner.scripted_bytes().unwrap(), &[0; 8]);
+        }
+        _ => panic!("new allocation must own the requested initialized memory kind"),
+    }
+}
