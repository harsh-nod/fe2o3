+#[test]
+fn sdma_pending_allocation_context_initialization_failure_retains_hidden_owners_and_quarantines() {
+    for lanes in LANES {
+        for kind in KINDS {
+            for panic in [false, true] {
+                let mut steps = Vec::new();
+                if kind == RuntimeMemoryKindV1::DeviceLocal {
+                    steps.extend([
+                        ScriptedSdmaStepV1::Allocate {
+                            kind: ScriptedBufferKindV1::Device,
+                            byte_len: 8,
+                        },
+                        ScriptedSdmaStepV1::Promote(ScriptedFailureModeV1::Success),
+                    ]);
+                }
+                steps.extend([
+                    ScriptedSdmaStepV1::AllocateHostFilled {
+                        byte_len: 8,
+                        fill: 0xa5,
+                    },
+                    ScriptedSdmaStepV1::WriteFault {
+                        offset: 0,
+                        byte_len: 8,
+                        written_prefix: 3,
+                        panic,
+                    },
+                    ScriptedSdmaStepV1::Recycle(ScriptedRecycleOutcomeV1::Success),
+                ]);
+                let Fixture {
+                    backend,
+                    pairs,
+                    submissions,
+                    ..
+                } = Fixture::new(lanes, steps);
+                let before = backend_snapshot(&backend, &pairs, &submissions);
+                let next_owner = before
+                    .allocations
+                    .iter()
+                    .map(|allocation| allocation.owner)
+                    .max()
+                    .unwrap()
+                    + 1;
+                let candidate = backend.next_handle;
+                let bytes = backend.staged_context_bytes;
+                let count = backend.allocations.len();
+                let events = backend
+                    .profiler
+                    .as_ref()
+                    .unwrap()
+                    .recorded_events_for_test_v1()
+                    .to_vec();
+                let prior_drops = dropped_events(&backend);
+                let mut context = ManuallyDrop::new(
+                    crate::RuntimeContextV1::open(ManuallyDrop::into_inner(backend)).unwrap(),
+                );
+                let device = context.devices()[0].id();
+                context
+                    .configure_allocation_admission_v1(device, 8, 1)
+                    .unwrap();
+                let result =
+                    catch_unwind(AssertUnwindSafe(|| context.allocate(device, kind, 8, 8)));
+                if panic {
+                    assert_eq!(
+                        result.unwrap_err().downcast_ref::<&str>(),
+                        Some(&"scripted SDMA host write panic")
+                    );
+                } else {
+                    let Err(crate::RuntimeErrorV1::BackendTerminal(error)) = result.unwrap() else {
+                        panic!("failed initialization must terminalize Context")
+                    };
+                    let operation = if kind == RuntimeMemoryKindV1::DeviceLocal {
+                        "KFD upload staging write"
+                    } else {
+                        "KFD persistent host allocation initialization"
+                    };
+                    assert_eq!(
+                        error.detail(),
+                        format!("{operation}: scripted SDMA host write failure")
+                    );
+                }
+                assert!(context.is_terminal() && context.backend().terminal);
+                let usage = context
+                    .allocation_admission_usage_v1(device)
+                    .unwrap()
+                    .unwrap();
+                assert_eq!(
+                    usage
+                        .used
+                        .get(crate::RuntimeResourceKindV1::RequestedAllocationBytes),
+                    8
+                );
+                assert_eq!(
+                    usage
+                        .used
+                        .get(crate::RuntimeResourceKindV1::AllocationRecords),
+                    1
+                );
+                assert_eq!(usage.quarantined_records, 1);
+                assert!(matches!(
+                    context.allocate(device, kind, 8, 8),
+                    Err(crate::RuntimeErrorV1::Validation(
+                        crate::RuntimeValidationErrorV1::ContextTerminal
+                    ))
+                ));
+                assert_eq!(
+                    context
+                        .allocation_admission_usage_v1(device)
+                        .unwrap()
+                        .unwrap(),
+                    usage
+                );
+                for &id in &submissions {
+                    assert!(matches!(
+                        context.backend_mut_for_test_v1().poll_v1(id),
+                        Err(RuntimeBackendFailureV1::Terminal(_))
+                    ));
+                }
+                let backend = context.backend();
+                assert_eq!(backend_snapshot(backend, &pairs, &submissions), before);
+                assert_eq!(backend.next_handle, candidate + 1);
+                let hidden_device = kind == RuntimeMemoryKindV1::DeviceLocal;
+                assert_eq!(
+                    backend.allocations.len(),
+                    count + usize::from(hidden_device)
+                );
+                assert_eq!(
+                    backend.staged_context_bytes,
+                    bytes + 8 * u64::from(hidden_device)
+                );
+                if hidden_device {
+                    let record = &backend.allocations[&candidate];
+                    assert_eq!((record.device, record.kind, record.alignment), (7, kind, 8));
+                    assert!(record.sdma_backed && !record.sdma_initialized);
+                    assert_eq!(&*record.bytes, &[0; 8]);
+                    let KfdRuntimeSdmaStorageV1::Device(owner) = &record.sdma_storage else {
+                        panic!("hidden device must remain indexed")
+                    };
+                    assert_eq!(owner.scripted_owner_id(), Some(next_owner));
+                    assert_eq!(owner.scripted_bytes().unwrap(), &[0; 8]);
+                } else {
+                    assert!(!backend.allocations.contains_key(&candidate));
+                }
+                assert_eq!(
+                    host_observation(retained_host(backend)),
+                    (
+                        next_owner + u64::from(hidden_device),
+                        vec![0, 0, 0, 0xa5, 0xa5, 0xa5, 0xa5, 0xa5],
+                        None,
+                    )
+                );
+                assert_eq!(
+                    backend
+                        .profiler
+                        .as_ref()
+                        .unwrap()
+                        .recorded_events_for_test_v1(),
+                    events
+                );
+                assert_eq!(dropped_events(backend), prior_drops);
+                let driver = backend.scripted_sdma.as_ref().unwrap();
+                assert_eq!(driver.remaining_steps(), 1);
+                assert_eq!(
+                    driver.live_owner_count(),
+                    pairs.len() * 2 + 1 + usize::from(hidden_device)
+                );
+                assert_eq!(driver.unexpected_drops(), 0);
+                disarm_scripted_drop_after_inspection_v1(context.backend_mut_for_test_v1());
+                drop(ManuallyDrop::into_inner(context));
+            }
+        }
+    }
+}
