+#[test]
+fn sdma_pending_allocation_preserves_primary_auxiliary_and_queued_compute_through_retry() {
+    for lanes in LANES {
+        for kind in KINDS {
+            let mut steps = vec![reject(kind, 8, false)];
+            steps.extend(success(kind));
+            steps.extend(releases(lanes, Some(kind)));
+            let mut fixture = Fixture::new(lanes, steps);
+            let before = snapshot(&fixture);
+            let prior_drops = dropped_events(&fixture.backend);
+            let bytes = fixture.backend.staged_context_bytes;
+            let count = fixture.backend.allocations.len();
+            let candidate = fixture.backend.next_handle;
+            let events = fixture
+                .backend
+                .profiler
+                .as_ref()
+                .unwrap()
+                .recorded_events_for_test_v1()
+                .to_vec();
+            let Err(RuntimeBackendFailureV1::Rejected(error)) =
+                fixture.backend.allocate_v1(7, kind, 8, 8)
+            else {
+                panic!("warm backing capacity must reject without effects")
+            };
+            assert_eq!(error.kind(), KfdRuntimeBackendErrorKindV1::Capacity);
+            assert_eq!(
+                error.detail(),
+                format!(
+                    "KFD persistent SDMA allocation: {}",
+                    capacity(kind, false).detail
+                )
+            );
+            assert_eq!(snapshot(&fixture), before);
+            assert_eq!(dropped_events(&fixture.backend), prior_drops);
+            assert_eq!(fixture.backend.staged_context_bytes, bytes);
+            assert_eq!(fixture.backend.allocations.len(), count);
+            assert_eq!(fixture.backend.next_handle, candidate + 1);
+            assert_eq!(
+                fixture
+                    .backend
+                    .profiler
+                    .as_ref()
+                    .unwrap()
+                    .recorded_events_for_test_v1(),
+                events
+            );
+            let allocated = fixture.backend.allocate_v1(7, kind, 8, 8).unwrap();
+            assert_eq!(allocated, candidate + 1);
+            assert_eq!(snapshot(&fixture), before);
+            assert_eq!(fixture.backend.staged_context_bytes, bytes + 8);
+            assert_eq!(fixture.backend.allocations.len(), count + 1);
+            assert!(!fixture.backend.terminal);
+            assert!(fixture.backend.terminal_sdma_custody.is_none());
+            assert_new_allocation(&fixture.backend, allocated, kind);
+            let after = fixture
+                .backend
+                .profiler
+                .as_ref()
+                .unwrap()
+                .recorded_events_for_test_v1();
+            assert_eq!(&after[..events.len()], events);
+            if matches!(
+                lanes,
+                Lanes::PersistentPrepared | Lanes::PersistentPublished
+            ) {
+                // The Scripted H2D setup lacks native profile facts and closes the retained prefix.
+                assert!(prior_drops > 0);
+                assert_eq!(after.len(), events.len());
+                assert_eq!(dropped_events(&fixture.backend), prior_drops + 1);
+            } else {
+                assert_eq!(prior_drops, 0);
+                assert_eq!(dropped_events(&fixture.backend), 0);
+                assert_eq!(after.len(), events.len() + 1);
+                assert_eq!(
+                    after.last().unwrap().event,
+                    KfdRuntimeProfileEventKindV1::AllocationCreated {
+                        allocation: fixture
+                            .backend
+                            .profile_resource_v1(KfdProfileResourceKindV1::Allocation, allocated)
+                            .unwrap(),
+                        memory_kind: match kind {
+                            RuntimeMemoryKindV1::HostVisible => KfdProfileMemoryKindV1::HostVisible,
+                            RuntimeMemoryKindV1::DeviceLocal =>
+                                KfdProfileMemoryKindV1::DeviceLocalHostStaged,
+                        },
+                        byte_len: 8,
+                        alignment: 8,
+                    }
+                );
+            }
+            fixture.finish(Some(allocated), kind);
+        }
+    }
+}
