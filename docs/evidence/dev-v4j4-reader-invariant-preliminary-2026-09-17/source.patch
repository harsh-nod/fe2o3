+    check(&journal);
+    let [a, b, c] = output.map(Option::unwrap);
+    let read = |allocation, offset| ContextAllocationReadV1 {
+        allocation,
+        device,
+        byte_extent: 64,
+        byte_offset: offset,
+        byte_len: 8,
+        attempt_epoch: 0,
