[Unit]
Description=fe2o3 native V3 compiler-execution coordinator
Documentation=https://github.com/harsh-nod/fe2o3/blob/main/docs/compiler-execution-service-v3.md
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/libexec/fe2o3/fe2o3-compiler-execution-coordinator
User=root
Group=root
RuntimeDirectory=fe2o3
RuntimeDirectoryMode=0755

OpenFile=/run/fe2o3:runtime-root:read-only
OpenFile=/var/lib/fe2o3/compiler-execution:supervisor-root:read-only
OpenFile=/var/lib/fe2o3/external-anchor:anchor-root:read-only
OpenFile=/usr/libexec/fe2o3/fe2o3-compiler-execution-supervisor-v3:supervisor:read-only
OpenFile=/usr/libexec/fe2o3/fe2o3-static-preexec-launcher:launcher:read-only
OpenFile=/usr/libexec/fe2o3/fe2o3-compiler-execution-issuer-conditional:issuer:read-only
OpenFile=/usr/libexec/fe2o3/fe2o3-external-anchor-provisioning-helper-v3:anchor-helper:read-only
OpenFile=/usr/libexec/fe2o3/fe2o3-external-anchor-service-v3:anchor-daemon:read-only
OpenFile=/etc/fe2o3/compiler-execution/supervisor-deployment-v3:supervisor-deployment:read-only
OpenFile=/etc/fe2o3/compiler-execution/issuer-policy-v3:issuer-policy:read-only
OpenFile=/etc/fe2o3/compiler-execution/anchor-deployment-v3:anchor-deployment:read-only
OpenFile=/etc/fe2o3/compiler-execution/anchor-provisioning-v3:anchor-provisioning:read-only
OpenFile=/etc/fe2o3/compiler-execution/issuer-signing-key-seed-v3:issuer-key-seed:read-only
OpenFile=/etc/fe2o3/compiler-execution/anchor-signing-key-seed-v3:anchor-key-seed:read-only

# Lifecycle '..' traversal through service-owned 0700 roots needs read/search.
# Exact namespace observation of the distinct-UID, nondumpable anchor needs ptrace.
# The creator writes the fresh helper's identity uid_map, including parent UID 0.
# Fixed cgroup-device BPF installation requires BPF and NET_ADMIN in the trusted
# creator. Compiler/helper children drop the entire capability set before READY.
CapabilityBoundingSet=CAP_BPF CAP_CHOWN CAP_DAC_READ_SEARCH CAP_KILL CAP_NET_ADMIN CAP_SETFCAP CAP_SETGID CAP_SETPCAP CAP_SETUID CAP_SYS_PTRACE
AmbientCapabilities=
NoNewPrivileges=no
PrivateDevices=yes
PrivateTmp=yes
PrivateUsers=no
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
# Empty Delegate enables subtree ownership without requesting controllers. The
# external manager still owns this unit cgroup and whole-service termination.
Slice=system.slice
Delegate=
ReadWritePaths=/var/lib/fe2o3/compiler-execution /var/lib/fe2o3/external-anchor /sys/fs/cgroup/system.slice/%n
RestrictAddressFamilies=AF_UNIX
# RestrictNamespaces would deny clone3 even for trusted creator roles. Mapped
# helpers and compiler stages install the mandatory child-only namespace filter.
RestrictNamespaces=no
SystemCallFilter=~unshare:EPERM setns:EPERM
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
LimitCORE=0
TasksMax=256

KillMode=mixed
TimeoutStartSec=300
TimeoutStopSec=30
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
