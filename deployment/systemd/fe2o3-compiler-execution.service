[Unit]
Description=fe2o3 protected compiler-execution coordinator
Documentation=https://github.com/harsh-nod/fe2o3/blob/main/docs/compiler-execution-service-v1.md
Requires=fe2o3-compiler-execution.socket
After=fe2o3-compiler-execution.socket

[Service]
Type=simple
ExecStart=/usr/libexec/fe2o3/fe2o3-compiler-execution-coordinator
User=root
Group=root
Sockets=fe2o3-compiler-execution.socket

OpenFile=/var/lib/fe2o3/compiler-execution:supervisor-root:read-only
OpenFile=/var/lib/fe2o3/external-anchor:anchor-root:read-only
OpenFile=/usr/libexec/fe2o3/fe2o3-compiler-execution-supervisor:supervisor:read-only
OpenFile=/usr/libexec/fe2o3/fe2o3-static-preexec-launcher:launcher:read-only
OpenFile=/usr/libexec/fe2o3/fe2o3-compiler-execution-issuer:issuer:read-only
OpenFile=/usr/libexec/fe2o3/fe2o3-external-anchor-provisioning-helper:anchor-helper:read-only
OpenFile=/usr/libexec/fe2o3/fe2o3-external-anchor-service:anchor-daemon:read-only
OpenFile=/etc/fe2o3/compiler-execution/supervisor-deployment-v1:supervisor-deployment:read-only
OpenFile=/etc/fe2o3/compiler-execution/issuer-policy-v1:issuer-policy:read-only
OpenFile=/etc/fe2o3/compiler-execution/anchor-deployment-v1:anchor-deployment:read-only
OpenFile=/etc/fe2o3/compiler-execution/anchor-provisioning-v1:anchor-provisioning:read-only
OpenFile=/etc/fe2o3/compiler-execution/issuer-signing-key-seed-v1:issuer-key-seed:read-only
OpenFile=/etc/fe2o3/compiler-execution/anchor-signing-key-seed-v1:anchor-key-seed:read-only

CapabilityBoundingSet=CAP_CHOWN CAP_KILL CAP_SETGID CAP_SETPCAP CAP_SETUID
AmbientCapabilities=
NoNewPrivileges=no
PrivateDevices=yes
PrivateTmp=yes
PrivateUsers=no
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/fe2o3/compiler-execution /var/lib/fe2o3/external-anchor
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
LimitCORE=0
TasksMax=256

KillMode=mixed
TimeoutStartSec=300
TimeoutStopSec=30
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
